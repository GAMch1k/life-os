# These public URLs are embedded in the browser bundle at build time.
# Override them to match the ports exposed by your local service stack.
NEXT_PUBLIC_FINANCE_SERVICE_URL=http://localhost:8081
NEXT_PUBLIC_TASKS_SERVICE_URL=http://localhost:8082
NEXT_PUBLIC_INBOX_SERVICE_URL=http://localhost:8083
NEXT_PUBLIC_CALENDAR_SERVICE_URL=http://localhost:8084

# Accounts (README.md#accounts): auth_db with db/migrations applied, and
# keys made as docs/install/accounts.md#keys says. Never real ones.
AUTH_DATABASE_URL=postgres://postgres:test@127.0.0.1:55442/auth_dev
LIFE_OS_PUBLIC_URL=http://localhost:3000
LIFE_OS_AUTH_SECRET=replace-with-openssl-rand-hex-32
LIFE_OS_IDENTITY_SIGNING_KEY=replace-with-a-private-Ed25519-JWK
LIFE_OS_TRUSTED_KEYS=replace-with-a-JWKS-of-its-public-key
LIFE_OS_LEGACY_ACCESS=on
