# Copy to .env for local development. Compose sets these from the root .env.
SERVICE_NAME=notifications
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://notifications_user:replace-with-a-local-password@127.0.0.1:5432/notifications_db?sslmode=disable
ACTIVITY_SERVICE_URL=
# Delivery channels, comma-separated. Empty: stored and listed only. "ntfy"
# pushes to the owner's phone through the self-hosted ntfy server; "webpush"
# pushes to the devices that turned on notifications in the Dashboard (needs
# the VAPID keys below); "log" writes each delivery to the service log
# (development and verification).
NOTIFICATIONS_CHANNELS=
# The ntfy channel (docs/operations/ntfy.md). The token is the publisher's
# secret access token (write-only on the topic); never commit a real one.
NOTIFICATIONS_NTFY_URL=http://ntfy:80
NOTIFICATIONS_NTFY_TOPIC=lifeos
NOTIFICATIONS_NTFY_TOKEN=
# Life OS's public URL: tapping a notification opens its link there.
NOTIFICATIONS_LINK_BASE_URL=https://lifeos.gamch1k.com
# Web push: the VAPID key pair from `go run ./cmd/vapid-keys` (the private key
# is a secret; never commit a real one) and the subject, a mailto: address or
# an https URL (empty: NOTIFICATIONS_LINK_BASE_URL).
NOTIFICATIONS_WEBPUSH_VAPID_PUBLIC_KEY=
NOTIFICATIONS_WEBPUSH_VAPID_PRIVATE_KEY=
NOTIFICATIONS_WEBPUSH_SUBJECT=
NOTIFICATIONS_WORKER_POLL_MILLIS=1000
NOTIFICATIONS_LEASE_SECONDS=60
NOTIFICATIONS_SEND_TIMEOUT_SECONDS=15
NOTIFICATIONS_RETRY_BASE_SECONDS=10
NOTIFICATIONS_RETRY_MAX_SECONDS=900
NOTIFICATIONS_DELIVERY_MAX_AGE_SECONDS=86400
