# Copy to .env for local development. Compose sets these from the root .env.
SERVICE_NAME=food
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://food_user:replace-with-a-local-password@127.0.0.1:5432/food_db?sslmode=disable
ACTIVITY_SERVICE_URL=
# The owner's timezone: expiringWithinDays counts from today there.
LIFE_OS_TIMEZONE=Europe/Berlin
