# Copy to .env for local development. Compose sets these from the root .env.
SERVICE_NAME=google-calendar
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://google_calendar_user:replace-with-a-local-password@127.0.0.1:5432/google_calendar_db?sslmode=disable
CALENDAR_SERVICE_URL=http://127.0.0.1:8084
ACTIVITY_SERVICE_URL=
LIFE_OS_TIMEZONE=Europe/Berlin
# The Google OAuth client and the key sealing the refresh token
# (docs/operations/google-calendar.md). Secrets: never commit real values.
# Unset, the service runs and reports "not configured".
LIFE_OS_GOOGLE_CLIENT_ID=
LIFE_OS_GOOGLE_CLIENT_SECRET=
LIFE_OS_GOOGLE_TOKEN_KEY=
LIFE_OS_GOOGLE_REDIRECT_URI=http://localhost:3000/calendar/google/callback
GOOGLE_CALENDAR_SYNC_SECONDS=120
GOOGLE_CALENDAR_FEED_SECONDS=15
