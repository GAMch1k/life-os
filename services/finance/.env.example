# Copy to .env for local template validation. Generated services replace these
# neutral names and receive their own isolated database credentials.
SERVICE_NAME=finance
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://finance_user:replace-with-a-local-password@127.0.0.1:5432/finance_db?sslmode=disable

# Optional: the Activity service (empty records nothing), the owner's
# timezone (a manual transaction without a date is dated today there; budget
# months and the month-end summary follow it), the currency of the built-in
# Cash account when Finance creates it and of budgets, and the Notifications
# service for budget notifications (empty sends none).
ACTIVITY_SERVICE_URL=
LIFE_OS_TIMEZONE=Europe/Berlin
FINANCE_DEFAULT_CURRENCY=EUR
NOTIFICATIONS_SERVICE_URL=
