# Copy to .env for local development. Compose sets these from the root .env.
SERVICE_NAME=calendar-feeds
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://calendar_feeds_user:replace-with-a-local-password@127.0.0.1:5432/calendar_feeds_db?sslmode=disable
# Calendar's integration API receives the feeds' events.
CALENDAR_SERVICE_URL=http://calendar:8080
ACTIVITY_SERVICE_URL=
LIFE_OS_TIMEZONE=Europe/Berlin
# Daily refresh, HH:MM in LIFE_OS_TIMEZONE (compose passes
# LIFE_OS_CALENDAR_SOURCE_REFRESH_AT).
CALENDAR_FEEDS_REFRESH_AT=04:30
CALENDAR_FEEDS_MAX_BYTES=5242880
CALENDAR_FEEDS_TIMEOUT_SECONDS=30
# Development and verification only: lets feeds use http and private
# addresses (it disables the protection against reaching internal services).
CALENDAR_FEEDS_ALLOW_PRIVATE_URLS=false
# The owner's personal ZAW (MyMüll) iCal feed; it names a street, so it lives
# only in the root .env and is never logged.
LIFE_OS_ZAW_ICS_URL=
