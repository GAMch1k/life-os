# Copy to .env for local development. Compose sets these from the root .env.
SERVICE_NAME=monitor
PORT=8080
LOG_LEVEL=info
# The Dashboard's runtime status (the Status page's checks as JSON).
MONITOR_STATUS_URL=http://localhost:3000/api/status
# Empty: status changes are only logged, nothing is notified.
NOTIFICATIONS_SERVICE_URL=
MONITOR_INTERVAL_SECONDS=60
MONITOR_CONFIRMATIONS=2
