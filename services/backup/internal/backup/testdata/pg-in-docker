#!/usr/bin/env bash
# Runs pg_dump or pg_restore, whichever name this script is called by, from
# the PostgreSQL image, for the integration test on a host without the
# client programs:
#
#   BACKUP_TEST_PG_DUMP=$PWD/internal/backup/testdata/pg_dump
#   BACKUP_TEST_PG_RESTORE=$PWD/internal/backup/testdata/pg_restore
#
# The connection comes from the PG* variables (the network is the host's);
# the directory of every absolute file argument is mounted read-only.
set -euo pipefail

program=$(basename "$0")
mounts=()
for arg in "$@"; do
  if [[ "$arg" == /* && -e "$arg" ]]; then
    dir=$(dirname "$arg")
    mounts+=(-v "$dir:$dir:ro")
  fi
done
exec docker run --rm --network host --user "$(id -u):$(id -g)" "${mounts[@]}" \
  -e PGHOST -e PGPORT -e PGUSER -e PGPASSWORD -e PGDATABASE -e PGSSLMODE -e PGCONNECT_TIMEOUT -e PGAPPNAME \
  "${BACKUP_TEST_PG_IMAGE:-postgres:18.6-alpine}" "$program" "$@"
