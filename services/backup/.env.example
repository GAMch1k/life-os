# Copy to .env for local development. Compose sets these from the root .env.
SERVICE_NAME=backup
PORT=8080
LOG_LEVEL=info
# The server and the backup login, not a database: every database in the
# registry is backed up.
BACKUP_DATABASE_URL=postgres://lifeos_backup@127.0.0.1:5432/?sslmode=disable
BACKUP_DATABASE_PASSWORD=replace-with-a-local-backup-password
BACKUP_DATABASES_FILE=/absolute/path/to/infra/postgres/service-databases.conf
# An existing directory; runs go to its auto/ subdirectory.
BACKUP_DIR=/absolute/path/to/backups
BACKUP_TIME=03:15
LIFE_OS_TIMEZONE=Europe/Berlin
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_FAILED_DAYS=3
BACKUP_RESTORE_CHECK_DAY=sunday
# Client programs of the server's PostgreSQL major version.
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_RESTORE=pg_restore
