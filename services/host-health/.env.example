# Copy to .env for local development. Compose sets these from the root .env.
SERVICE_NAME=host-health
PORT=8080
LOG_LEVEL=info
# A made-up host instead of this one: healthy or low-memory. Empty reads
# the real host.
HOST_HEALTH_FIXTURE=healthy
HOST_HEALTH_PROC_DIR=/proc
HOST_HEALTH_DISKS=root=/host,docker=/host-docker
# The read-only Docker gateway; empty means no container facts.
HOST_HEALTH_DOCKER_URL=
HOST_HEALTH_INTERVAL_SECONDS=60
HOST_HEALTH_MEMORY_WARNING_PERCENT=15
HOST_HEALTH_MEMORY_WARNING_SAMPLES=3
HOST_HEALTH_MEMORY_PROBLEM_PERCENT=7
HOST_HEALTH_DISK_WARNING_GIB=10
HOST_HEALTH_DISK_WARNING_PERCENT=10
HOST_HEALTH_DISK_PROBLEM_GIB=3
HOST_HEALTH_LOAD_WARNING_PER_CPU=1
HOST_HEALTH_RESTART_LOOP_COUNT=3
HOST_HEALTH_RESTART_LOOP_MINUTES=15
HOST_HEALTH_UNHEALTHY_MINUTES=5
