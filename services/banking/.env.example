# Copy to .env for local development. Compose sets these from the root .env.
SERVICE_NAME=banking
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://banking_user:replace-with-a-local-password@127.0.0.1:5432/banking_db?sslmode=disable
FINANCE_SERVICE_URL=http://127.0.0.1:8081
NOTIFICATIONS_SERVICE_URL=
ACTIVITY_SERVICE_URL=
LIFE_OS_TIMEZONE=Europe/Berlin
# The Enable Banking application (docs/operations/banking.md). Secrets: never
# commit real values. The key file is the application's private key (PEM);
# the token key seals the provider session id (openssl rand -base64 32).
# Unset, banking runs and reports "not configured".
LIFE_OS_ENABLE_BANKING_APP_ID=
LIFE_OS_ENABLE_BANKING_KEY_FILE=
LIFE_OS_BANKING_TOKEN_KEY=
# Where the bank returns: Life OS's public URL and /finance/bank/callback.
LIFE_OS_BANKING_REDIRECT_URI=https://lifeos.example.com/finance/bank/callback
ENABLE_BANKING_API_URL=https://api.enablebanking.com
# Scheduled syncs, HH:MM in LIFE_OS_TIMEZONE, at most four a day.
BANKING_SYNC_TIMES=06:00,12:00,18:00,23:00
BANKING_MAX_UNATTENDED_PER_DAY=4
BANKING_MANUAL_SYNC_MINUTES=10
BANKING_INITIAL_DAYS=90
BANKING_OVERLAP_DAYS=7
# How far back the history read right after a bank login asks (0: off).
BANKING_HISTORY_DAYS=730
BANKING_TICK_SECONDS=60
