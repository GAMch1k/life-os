# Copy this file to .env for local development. Never commit the real .env.
LIFE_OS_POSTGRES_IMAGE=postgres:18.6-alpine
LIFE_OS_POSTGRES_DB=postgres
LIFE_OS_POSTGRES_USER=lifeos_admin
LIFE_OS_POSTGRES_PASSWORD=replace-with-a-local-password
LIFE_OS_POSTGRES_PORT=5432

# Each domain service receives only its own database credential.
LIFE_OS_FINANCE_DB_PASSWORD=replace-with-a-local-finance-password
LIFE_OS_TASKS_DB_PASSWORD=replace-with-a-local-tasks-password
LIFE_OS_INBOX_DB_PASSWORD=replace-with-a-local-inbox-password
LIFE_OS_CALENDAR_DB_PASSWORD=replace-with-a-local-calendar-password
LIFE_OS_VOICE_DB_PASSWORD=replace-with-a-local-voice-password
LIFE_OS_ACTIVITY_DB_PASSWORD=replace-with-a-local-activity-password
LIFE_OS_NOTIFICATIONS_DB_PASSWORD=replace-with-a-local-notifications-password
LIFE_OS_BANKING_DB_PASSWORD=replace-with-a-local-banking-password

# Self-hosted whisper.cpp worker. The default multilingual base model is a
# conservative CPU starting point; replace URL/path to use a larger model.
LIFE_OS_WHISPER_MODEL_PATH=/models/ggml-base.bin
LIFE_OS_WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin
LIFE_OS_WHISPER_THREADS=2
LIFE_OS_WHISPER_MAX_CONCURRENCY=1
LIFE_OS_WHISPER_MAX_AUDIO_BYTES=26214400
LIFE_OS_WHISPER_CPUS=2.0
LIFE_OS_WHISPER_MEMORY=2g
LIFE_OS_VOICE_RETENTION_HOURS=168
LIFE_OS_VOICE_MAX_UPLOAD_BYTES=26214400
LIFE_OS_VOICE_WORKER_POLL_MILLIS=1000
LIFE_OS_VOICE_WORKER_MAX_ATTEMPTS=3
LIFE_OS_VOICE_WORKER_LEASE_SECONDS=120
LIFE_OS_VOICE_WORKER_RETRY_BACKOFF_SECONDS=60

# Automatic Inbox processing uses the existing authenticated local Codex CLI.
# Set this to the host directory that contains auth.json (normally ~/.codex).
# The processor bind-mounts it read-only and copies it only to an in-memory
# filesystem at startup; do not put a token or auth file in this repository.
LIFE_OS_CODEX_HOME_HOST_PATH=/absolute/path/to/.codex
# Numeric UID of the owner of the host Codex profile (run `id -u`). The
# processor runs as this unprivileged UID so it can read the 0600 auth file.
LIFE_OS_CODEX_RUNTIME_UID=1000
# The owner's usual timezone (IANA name), the fallback when the browser's
# own is not known: the Dashboard shows "today" and times in the browser's
# timezone, and relative dates in captures ("tomorrow at 10") are interpreted
# in the capturing browser's. Calendar compares all-day dates in it when a
# read names no timezone, and Finance dates a transaction without a date
# today there. Defaults to UTC.
LIFE_OS_TIMEZONE=Europe/Berlin
# Currency of Finance's built-in Cash account when Finance first creates it.
# Defaults to EUR.
LIFE_OS_FINANCE_CURRENCY=EUR
# Calendar refreshes its subscribed feeds (ICS sources) daily at this quiet
# hour, HH:MM in LIFE_OS_TIMEZONE. Defaults to 04:30.
LIFE_OS_CALENDAR_SOURCE_REFRESH_AT=04:30
# Optional personal ZAW waste-collection feed (the MyMüll iCal export of the
# ZAW Abfallkalender for one street). When set, Calendar keeps a "ZAW" source
# for it: Bioabfall, Gelber Sack, Papier, and Restmüll 14-täglich, with a
# reminder the evening before. It names your street, so keep it here only:
# https://service.mymuell.de/api.php?m=zaw&r=ical&city_id=<city>&area_id=<area>&reminder=0&time=&city_name=<town>&street_name=<street>
LIFE_OS_ZAW_ICS_URL=
# Optional Google Calendar connection (docs/operations/google-calendar.md).
# The OAuth "Web application" client from your Google Cloud project, and a
# key that encrypts the stored refresh token: generate it once with
# `openssl rand -base64 32` and keep it (a new key means reconnecting).
# Google stays "not configured" until all three are set. Secrets: never
# commit real values.
LIFE_OS_GOOGLE_CLIENT_ID=
LIFE_OS_GOOGLE_CLIENT_SECRET=
LIFE_OS_GOOGLE_TOKEN_KEY=
# Where Google returns after consent: the Dashboard's callback route, exactly
# as registered on the OAuth client.
LIFE_OS_GOOGLE_REDIRECT_URI=https://lifeos.gamch1k.com/calendar/google/callback
# How often Calendar syncs each Google calendar chosen to sync, in seconds
# (30 to 86400). Defaults to 120.
LIFE_OS_CALENDAR_GOOGLE_SYNC_SECONDS=120
# Optional bank connection through Enable Banking (docs/operations/banking.md),
# read-only account information. The application id from the Enable Banking
# control panel; the host path of its private key file (PEM, mode 0600, owned
# by LIFE_OS_BANKING_RUNTIME_UID, the UID the banking container runs as: run
# `id -u`), which Compose bind-mounts read-only; and a key that encrypts the
# stored bank session: generate it once with `openssl rand -base64 32` and
# keep it (a new key means reconnecting). Banking stays "not configured"
# until all three are set. Secrets: never commit real values.
LIFE_OS_ENABLE_BANKING_APP_ID=
LIFE_OS_ENABLE_BANKING_KEY_FILE=
LIFE_OS_BANKING_TOKEN_KEY=
LIFE_OS_BANKING_RUNTIME_UID=1000
# Where the bank returns after consent: the Dashboard's callback route,
# exactly as registered on the Enable Banking application.
LIFE_OS_BANKING_REDIRECT_URI=https://lifeos.gamch1k.com/finance/bank/callback
# Scheduled bank syncs, HH:MM in LIFE_OS_TIMEZONE. Banks allow about four reads
# a day without you; at most four times. "Sync now" in Finance does not count.
LIFE_OS_BANKING_SYNC_TIMES=06:00,12:00,18:00,23:00
# How long a bank consent is asked for, in days (1-180; the bank's own maximum
# still applies). Lower it if the bank refuses a long consent.
LIFE_OS_BANKING_CONSENT_DAYS=180
# Task notifications (docs/services/tasks.md#notifications), HH:MM in
# LIFE_OS_TIMEZONE: the morning summary (today's tasks, events, overdue), the
# morning list of date-only tasks due today and overdue tasks, and the
# evening list of date-only tasks due tomorrow; and how many minutes before
# a task with a due time its reminder is sent. A summary at the morning-list
# time is sent as one message.
LIFE_OS_TASKS_SUMMARY_TIME=08:00
LIFE_OS_TASKS_MORNING_TIME=09:00
LIFE_OS_TASKS_EVENING_TIME=19:00
LIFE_OS_TASKS_TIMED_LEAD_MINUTES=30
# Routine Inbox/Voice planning profile, chosen by the X-01 benchmark
# (docs/verification/ai-runtime-benchmark.md).
LIFE_OS_CODEX_MODEL=gpt-5.6-luna
LIFE_OS_CODEX_REASONING_EFFORT=medium
LIFE_OS_PROCESSOR_POLL_MILLIS=1000
# Monitor (docs/services/monitor.md): seconds between two reads of the
# Status checks, and how many reads in a row a change must hold before the
# owner is notified.
LIFE_OS_MONITOR_INTERVAL_SECONDS=60
LIFE_OS_MONITOR_CONFIRMATIONS=2
# Notification delivery channels (docs/services/notifications.md), comma-
# separated. Empty: notifications are stored and listed in the Dashboard only.
# "ntfy" pushes them to the owner's phone (below); "log" writes each delivery
# to the notifications service log.
LIFE_OS_NOTIFICATIONS_CHANNELS=
# Life OS's public URL: tapping a phone notification opens its page there.
LIFE_OS_PUBLIC_URL=https://lifeos.gamch1k.com

# Self-hosted ntfy for phone notifications (optional, docs/operations/ntfy.md).
# Enable it with COMPOSE_PROFILES=ntfy (add it to the list, for example
# COMPOSE_PROFILES=cloudflare,ntfy) and LIFE_OS_NOTIFICATIONS_CHANNELS=ntfy.
# ntfy provisions two users from these values at every start:
#  - lifeos-publisher, the Notifications service: write-only on the topic, by
#    token. Token: `docker run --rm binwiederhier/ntfy:v2.29.0 token generate`
#    (tk_ and 29 characters). Its password is never used: hash a random one.
#  - lifeos-phone, the ntfy app on the owner's phone: read-only on the topic,
#    by password (keep it in your password manager; only its hash goes here).
# Hash a password with `docker run --rm -it binwiederhier/ntfy:v2.29.0 user hash`.
# Bcrypt hashes contain $: keep them in single quotes. Secrets: never commit
# real values.
LIFE_OS_NTFY_TOPIC=lifeos
LIFE_OS_NTFY_PUBLISHER_TOKEN=
LIFE_OS_NTFY_PUBLISHER_PASSWORD_HASH=''
LIFE_OS_NTFY_PHONE_PASSWORD_HASH=''

# Gateway is loopback-only by default and belongs behind host Nginx TLS/Basic
# Auth. A WireGuard bind exposes the entire Dashboard/API/MCP gateway to every
# WireGuard peer: treat peer membership as the authentication boundary.
LIFE_OS_GATEWAY_BIND_ADDRESS=127.0.0.1
LIFE_OS_GATEWAY_PORT=3000

# Cloudflare Tunnel (optional, docs/operations/cloudflare.md). Enable the
# connector with COMPOSE_PROFILES=cloudflare and supply the tunnel token from
# the Cloudflare Zero Trust dashboard. Never commit a real token. With ntfy
# too: COMPOSE_PROFILES=cloudflare,ntfy.
# COMPOSE_PROFILES=cloudflare
LIFE_OS_CLOUDFLARE_TUNNEL_TOKEN=
# Optional Access service token used only by tools/check-cloudflare-access.
LIFE_OS_CF_ACCESS_CLIENT_ID=
LIFE_OS_CF_ACCESS_CLIENT_SECRET=
