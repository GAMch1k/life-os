# Copy this file to .env for local development. Never commit the real .env.
LIFE_OS_POSTGRES_IMAGE=postgres:18.6-alpine
LIFE_OS_POSTGRES_DB=postgres
LIFE_OS_POSTGRES_USER=lifeos_admin
LIFE_OS_POSTGRES_PASSWORD=replace-with-a-local-password
LIFE_OS_POSTGRES_PORT=5432

# Each domain service receives only its own database credential.
LIFE_OS_FINANCE_DB_PASSWORD=replace-with-a-local-finance-password
LIFE_OS_TASKS_DB_PASSWORD=replace-with-a-local-tasks-password
LIFE_OS_INBOX_DB_PASSWORD=replace-with-a-local-inbox-password
LIFE_OS_CALENDAR_DB_PASSWORD=replace-with-a-local-calendar-password
LIFE_OS_VOICE_DB_PASSWORD=replace-with-a-local-voice-password

# Self-hosted whisper.cpp worker. The default multilingual base model is a
# conservative CPU starting point; replace URL/path to use a larger model.
LIFE_OS_WHISPER_MODEL_PATH=/models/ggml-base.bin
LIFE_OS_WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin
LIFE_OS_WHISPER_THREADS=2
LIFE_OS_WHISPER_MAX_CONCURRENCY=1
LIFE_OS_WHISPER_MAX_AUDIO_BYTES=26214400
LIFE_OS_WHISPER_CPUS=2.0
LIFE_OS_WHISPER_MEMORY=2g
LIFE_OS_VOICE_RETENTION_HOURS=168
LIFE_OS_VOICE_WORKER_POLL_MILLIS=1000
LIFE_OS_VOICE_WORKER_MAX_ATTEMPTS=3

# Dashboard is loopback-only by default. Set this to a WireGuard interface
# address (for example 10.66.66.1) to make only the dashboard reachable there.
LIFE_OS_GATEWAY_BIND_ADDRESS=127.0.0.1
LIFE_OS_GATEWAY_PORT=3000
