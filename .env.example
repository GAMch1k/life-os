# Copy this file to .env for local development. Never commit the real .env.

# ---------- Release ----------
# Only the release bundle's compose.yaml reads these
# (docs/operations/releases.md); the repository's compose.yaml builds its
# images. The Life OS release to run, such as v0.1.0-preview.1: every
# image's tag. A release's .env.example comes with its own version here.
LIFE_OS_VERSION=
# Where the images come from. Unset: ghcr.io/gamch1k, the official images.
# LIFE_OS_IMAGE_REGISTRY=

# ---------- General ----------
# Life OS's public URL, without a trailing slash. Required by compose.
# Tapping a phone notification opens its page there, and the Google and bank
# redirect URIs default to it. Without a hostname, use the gateway's own
# address, such as http://127.0.0.1:3000.
LIFE_OS_PUBLIC_URL=https://lifeos.example.com
# The hostname Life OS is reached at from outside, such as the Cloudflare
# Tunnel's or a host Nginx's: the host of LIFE_OS_PUBLIC_URL. Empty: none.
LIFE_OS_PUBLIC_HOSTNAME=lifeos.example.com
# Gateway is loopback-only by default and belongs behind host Nginx TLS/Basic
# Auth. A WireGuard bind (the server's WireGuard address, such as 10.8.0.1)
# exposes the entire Dashboard/API/MCP gateway to every WireGuard peer: treat
# peer membership as the authentication boundary. The gateway serves Life OS
# only to the Host names 127.0.0.1, localhost, this address, and
# LIFE_OS_PUBLIC_HOSTNAME; any other Host gets no answer. Recreate the gateway
# after a change.
LIFE_OS_GATEWAY_BIND_ADDRESS=127.0.0.1
LIFE_OS_GATEWAY_PORT=3000
# The owner's usual timezone (IANA name), the fallback when the browser's
# own is not known: the Dashboard shows "today" and times in the browser's
# timezone, and relative dates in captures ("tomorrow at 10") are interpreted
# in the capturing browser's. Calendar compares all-day dates in it when a
# read names no timezone, Finance dates a transaction without a date today
# there, and MCP shows and moves Task and event times in it. Defaults to UTC.
LIFE_OS_TIMEZONE=Europe/Berlin

# ---------- Modules ----------
# The optional modules that run, comma-separated (docs/install/modules.md).
# The core always runs: the Dashboard, Tasks, Calendar, Inbox, Food, Finance
# (manual entries and CSV imports), notifications in Life OS, and backups.
# Empty: the core alone. The optional modules:
#   ai               AI processing of your captures (Codex or Claude Code)
#   voice            voice notes, transcribed by Whisper on this server
#   google-calendar  two-way sync with Google Calendar
#   banking          bank sync through Enable Banking
#   cloudflare       the Cloudflare Tunnel connector
#   ntfy             a self-hosted ntfy server for push (needs cloudflare)
#   server-health    the Status page's Server check (reads the Docker socket)
# Compose runs each module as the profile of its name, so this is Compose's
# own COMPOSE_PROFILES. ./setup.sh modules switches them on and off: off, a
# module's containers are removed and its data stays.
COMPOSE_PROFILES=
# This .env lists its modules in COMPOSE_PROFILES. Without this line (an
# .env from before modules, when every module ran), ./setup.sh up and update
# turn on the modules the install used, and add it.
LIFE_OS_MODULES_LISTED=yes

# ---------- Database ----------
# Unset: compose.yaml's PostgreSQL image, pinned by digest and kept current by
# Dependabot (docs/operations/ci.md#dependabot). Set it only to run another
# image of the same major version; the backup image is built on it too.
# LIFE_OS_POSTGRES_IMAGE=
LIFE_OS_POSTGRES_DB=postgres
# The PostgreSQL admin login and password. Required by compose.
LIFE_OS_POSTGRES_USER=lifeos_admin
LIFE_OS_POSTGRES_PASSWORD=replace-with-a-local-password

# Each domain service receives only its own database credential.
LIFE_OS_FINANCE_DB_PASSWORD=replace-with-a-local-finance-password
LIFE_OS_TASKS_DB_PASSWORD=replace-with-a-local-tasks-password
LIFE_OS_INBOX_DB_PASSWORD=replace-with-a-local-inbox-password
LIFE_OS_CALENDAR_DB_PASSWORD=replace-with-a-local-calendar-password
LIFE_OS_VOICE_DB_PASSWORD=replace-with-a-local-voice-password
LIFE_OS_ACTIVITY_DB_PASSWORD=replace-with-a-local-activity-password
LIFE_OS_NOTIFICATIONS_DB_PASSWORD=replace-with-a-local-notifications-password
LIFE_OS_BANKING_DB_PASSWORD=replace-with-a-local-banking-password
LIFE_OS_GOOGLE_CALENDAR_DB_PASSWORD=replace-with-a-local-google-calendar-password
LIFE_OS_CALENDAR_FEEDS_DB_PASSWORD=replace-with-a-local-calendar-feeds-password
LIFE_OS_FOOD_DB_PASSWORD=replace-with-a-local-food-password
# The backup service's read-only login (lifeos_backup), which reads every
# service database. Use letters and digits only (`openssl rand -hex 24`).
LIFE_OS_BACKUP_DB_PASSWORD=replace-with-a-local-backup-password

# ---------- Backups ----------
# Backups (docs/services/backup.md). The existing host directory the backup
# service writes to: create it with `mkdir -m 700`, owned by the user below.
# The service keeps its runs under auto/ there and touches nothing else in
# it. Required by compose.
LIFE_OS_BACKUP_DIR=/absolute/path/to/life-os.backups
# Numeric UID the backup container runs as, the directory's owner (`id -u`).
LIFE_OS_BACKUP_RUNTIME_UID=1000
# The nightly backup, HH:MM in LIFE_OS_TIMEZONE. Defaults to 03:15.
LIFE_OS_BACKUP_TIME=03:15
# Rotation: the newest successful backup of each of the last 7 days, 4 weeks,
# and 12 months that have one is kept; failed runs are kept 3 days. The newest
# successful backup is never deleted.
LIFE_OS_BACKUP_KEEP_DAILY=7
LIFE_OS_BACKUP_KEEP_WEEKLY=4
LIFE_OS_BACKUP_KEEP_MONTHLY=12
LIFE_OS_BACKUP_KEEP_FAILED_DAYS=3
# The weekly restore check (docs/operations/backups.md): after the nightly
# backup of this weekday, every dump of the newest full backup is restored
# into a scratch database and compared with its manifest. A weekday such as
# sunday, or off.
LIFE_OS_BACKUP_RESTORE_CHECK_DAY=sunday
# The group of Inbox's capture images (`docker compose exec inbox id -g`):
# the backup service reads them, read-only, to keep a copy with each night's
# backup. 101 is the inbox image's lifeos group.
LIFE_OS_INBOX_MEDIA_GID=101

# ---------- Cloudflare ----------
# Cloudflare Tunnel (the cloudflare module, docs/operations/cloudflare.md):
# add cloudflare to COMPOSE_PROFILES above and supply the tunnel token from
# the Cloudflare Zero Trust dashboard (./setup.sh cloudflare does both).
# Never commit a real token.
LIFE_OS_CLOUDFLARE_TUNNEL_TOKEN=
# The Zero Trust team domain (<team>.cloudflareaccess.com), for
# tools/check-cloudflare-access and tools/check-ntfy-route, and an optional
# Access service token, for tools/check-cloudflare-access only.
LIFE_OS_CF_ACCESS_TEAM_DOMAIN=
LIFE_OS_CF_ACCESS_CLIENT_ID=
LIFE_OS_CF_ACCESS_CLIENT_SECRET=

# ---------- AI ----------
# Which CLI runs every AI job (capture planning, recipe ideas, categories,
# budget plans): codex (the default), the OpenAI Codex CLI on your ChatGPT
# sign-in, or claude, the Claude Code CLI on your Claude plan or Anthropic API
# key (./setup.sh claude).
LIFE_OS_AI_PROVIDER=codex
# A source build only: the CLIs the processor image installs, comma-separated:
# codex (the default, and the published image's), claude, or codex,claude. It
# must include LIFE_OS_AI_PROVIDER, or the processor exits at startup. Rebuild
# the processor (docker compose build processor) after changing it. The
# published images never contain Claude Code; see LIFE_OS_PROCESSOR_IMAGE.
LIFE_OS_AI_PROVIDERS=codex
# The release files only: the processor image to run instead of the release's.
# ./setup.sh claude sets it to lifeos-processor-claude:<version>, the
# release's processor image with Claude Code added on this server (downloaded
# from Anthropic's npm package); ./setup.sh update builds it again for the new
# version, and ./setup.sh codex empties it. Leave it to setup.sh.
LIFE_OS_PROCESSOR_IMAGE=
# Codex: automatic Inbox processing uses the existing authenticated local
# Codex CLI. Set this to the host directory that contains auth.json (normally
# ~/.codex). The processor bind-mounts it and copies it only to an in-memory
# filesystem at startup; do not put a token or auth file in this repository.
# The release files' compose.yaml always requires it, with either provider:
# setup.sh writes it (codex-home/, empty until ./setup.sh codex). Only a
# source build with LIFE_OS_AI_PROVIDER=claude may leave it unset; with codex,
# leaving it unset makes the processor exit at startup (code 78), and it keeps
# restarting until it is set.
LIFE_OS_CODEX_HOME_HOST_PATH=/absolute/path/to/.codex
# Numeric UID the processor runs as (run `id -u`). With codex it must own the
# host Codex profile, so the processor can read the 0600 auth file. Required
# by compose with either provider.
LIFE_OS_CODEX_RUNTIME_UID=1000
# Routine Inbox/Voice planning profile, chosen by the X-01 benchmark
# (docs/verification/ai-runtime-benchmark.md).
LIFE_OS_CODEX_MODEL=gpt-5.6-luna
LIFE_OS_CODEX_REASONING_EFFORT=medium
# Claude: one sign-in, never both (./setup.sh claude asks which). Your Claude
# plan: the long-lived token `claude setup-token` prints after you sign in;
# runs use the plan's usage limits, and no ANTHROPIC_* setting ever reaches
# them. Or an Anthropic API key (sk-ant-api...), billed per use by Anthropic:
# the processor passes it to the Claude Code runs alone. One is required with
# claude.
LIFE_OS_CLAUDE_CODE_OAUTH_TOKEN=
LIFE_OS_ANTHROPIC_API_KEY=
# Claude model (sonnet, opus, or haiku, or a full model name such as
# claude-sonnet-4-5; ./setup.sh claude asks) and effort (low, medium, high,
# xhigh, or max; empty is Claude Code's default; set it here).
LIFE_OS_CLAUDE_MODEL=sonnet
LIFE_OS_CLAUDE_EFFORT=
LIFE_OS_PROCESSOR_POLL_MILLIS=1000
# The processor's memory cap (Docker mem_limit, such as 1536m or 2g).
# LIFE_OS_PROCESSOR_MEMORY=1536m
# Recent captures as context (docs/services/mcp.md#recent-captures): how many
# minutes before a capture its planning sees the owner's other captures and
# what was done for them, so "actually oat milk" renames the milk just added;
# 0 turns it off, at most 120.
LIFE_OS_INBOX_CONTEXT_MINUTES=20
# Recipe ideas (docs/services/mcp.md#recipe-ideas): the daily run, HH:MM in
# LIFE_OS_TIMEZONE (only when the pantry has food in stock), or off; and
# Codex's web search for that job alone: disabled, cached, or live (Claude:
# cached allows its WebSearch tool, live also WebFetch). Capture processing
# never searches the web.
LIFE_OS_IDEAS_TIME=16:00
LIFE_OS_IDEAS_WEB_SEARCH=disabled
# AI categories (docs/services/mcp.md#ai-categories): on or off. On, the
# processor gives the AI's category to booked transactions Finance's rules
# leave without one, checking every 5 minutes; the owner's choices win.
LIFE_OS_AI_CATEGORIES=on
# AI budget plans (docs/services/mcp.md#ai-budget-plans): on or off. On, the
# processor plans a month's budget when the owner asks ("Plan my budget") and,
# with the monthly switch on, on the 1st of each month at 06:00 in
# LIFE_OS_TIMEZONE. Nothing changes the budget until the owner applies a plan.
LIFE_OS_AI_BUDGET_PLANS=on
LIFE_OS_AI_BUDGET_PLAN_MONTHLY=on

# ---------- Voice ----------
# Self-hosted whisper.cpp worker (docs/services/voice-stt.md). The default is
# the multilingual small model (about 466 MB, downloaded on the first start);
# set both lines together to use another one.
LIFE_OS_WHISPER_MODEL_PATH=/models/ggml-small.bin
LIFE_OS_WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin
# The spoken language: auto guesses it for each voice note, which short notes
# sometimes get wrong. If you speak one language only, set its code (such as
# de, ru, or en; docs/install/voice.md#language): more accurate, and a bit
# faster. A code whisper.cpp does not know stops Whisper at its start.
LIFE_OS_WHISPER_LANGUAGE=auto
LIFE_OS_WHISPER_THREADS=2
LIFE_OS_WHISPER_MAX_CONCURRENCY=1
LIFE_OS_WHISPER_MAX_AUDIO_BYTES=26214400
LIFE_OS_WHISPER_CPUS=2.0
LIFE_OS_WHISPER_MEMORY=2g
LIFE_OS_VOICE_RETENTION_HOURS=168
LIFE_OS_VOICE_MAX_UPLOAD_BYTES=26214400
LIFE_OS_VOICE_WORKER_POLL_MILLIS=1000
LIFE_OS_VOICE_WORKER_MAX_ATTEMPTS=3
LIFE_OS_VOICE_WORKER_LEASE_SECONDS=120
LIFE_OS_VOICE_WORKER_RETRY_BACKOFF_SECONDS=60

# ---------- Inbox ----------
# Largest capture image Inbox stores (shared or attached photos; five per capture).
LIFE_OS_INBOX_MEDIA_MAX_BYTES=10485760

# ---------- Tasks ----------
# Task notifications (docs/services/tasks.md#notifications), HH:MM in
# LIFE_OS_TIMEZONE: the morning summary (today's tasks, events, overdue), the
# morning list of date-only tasks due today and overdue tasks, and the
# evening list of date-only tasks due tomorrow; and how many minutes before
# a task with a due time its reminder is sent. A summary at the morning-list
# time is sent as one message.
LIFE_OS_TASKS_SUMMARY_TIME=08:00
LIFE_OS_TASKS_MORNING_TIME=09:00
LIFE_OS_TASKS_EVENING_TIME=19:00
LIFE_OS_TASKS_TIMED_LEAD_MINUTES=30

# ---------- Calendar ----------
# The calendar-feeds service refreshes the subscribed feeds (ICS/iCal) daily
# at this quiet hour, HH:MM in LIFE_OS_TIMEZONE. Defaults to 04:30.
LIFE_OS_CALENDAR_SOURCE_REFRESH_AT=04:30
# Optional personal ZAW waste-collection feed (the MyMüll iCal export of the
# ZAW Abfallkalender for one street). When set, calendar-feeds keeps a "ZAW"
# feed for it: Bioabfall, Gelber Sack, Papier, and Restmüll 14-täglich, with a
# reminder the evening before. It names your street, so keep it here only:
# https://service.mymuell.de/api.php?m=zaw&r=ical&city_id=<city>&area_id=<area>&reminder=0&time=&city_name=<town>&street_name=<street>
LIFE_OS_ZAW_ICS_URL=
# Optional Google Calendar connection (docs/operations/google-calendar.md),
# served by the google-calendar integration service. The OAuth "Web
# application" client from your Google Cloud project, and a key that
# encrypts the stored refresh token: generate it once with
# `openssl rand -base64 32` and keep it (a new key means reconnecting).
# Google stays "not configured" until all three are set. Secrets: never
# commit real values.
LIFE_OS_GOOGLE_CLIENT_ID=
LIFE_OS_GOOGLE_CLIENT_SECRET=
LIFE_OS_GOOGLE_TOKEN_KEY=
# Where Google returns after consent: the Dashboard's callback route, exactly
# as registered on the OAuth client. Defaults to
# LIFE_OS_PUBLIC_URL/calendar/google/callback.
# LIFE_OS_GOOGLE_REDIRECT_URI=https://lifeos.example.com/calendar/google/callback
# How often each Google calendar chosen to sync is synced, in seconds (30 to
# 86400). Defaults to 120.
LIFE_OS_CALENDAR_GOOGLE_SYNC_SECONDS=120
# How often the integration reads Calendar's change feed, in seconds (1 to
# 3600): edits made in Life OS reach Google within about this long.
# Defaults to 15.
LIFE_OS_GOOGLE_CALENDAR_FEED_SECONDS=15

# ---------- Finance ----------
# Currency of Finance's built-in Cash account when Finance first creates it.
# Defaults to EUR.
LIFE_OS_FINANCE_CURRENCY=EUR
# Optional bank connection through Enable Banking (docs/operations/banking.md),
# read-only account information. The application id from the Enable Banking
# control panel; the host path of its private key file (PEM, mode 0600, owned
# by LIFE_OS_BANKING_RUNTIME_UID, the UID the banking container runs as: run
# `id -u`), which Compose bind-mounts read-only; and a key that encrypts the
# stored bank session: generate it once with `openssl rand -base64 32` and
# keep it (a new key means reconnecting). Banking stays "not configured"
# until all three are set. Secrets: never commit real values.
LIFE_OS_ENABLE_BANKING_APP_ID=
LIFE_OS_ENABLE_BANKING_KEY_FILE=
LIFE_OS_BANKING_TOKEN_KEY=
LIFE_OS_BANKING_RUNTIME_UID=1000
# Where the bank returns after consent: the Dashboard's callback route,
# exactly as registered on the Enable Banking application. Defaults to
# LIFE_OS_PUBLIC_URL/finance/bank/callback.
# LIFE_OS_BANKING_REDIRECT_URI=https://lifeos.example.com/finance/bank/callback
# Scheduled bank syncs, HH:MM in LIFE_OS_TIMEZONE. Banks allow about four reads
# a day without you; at most four times. "Sync now" in Finance does not count.
LIFE_OS_BANKING_SYNC_TIMES=06:00,12:00,18:00,23:00
# How long a bank consent is asked for, in days (1-180; the bank's own maximum
# still applies). Lower it if the bank refuses a long consent.
LIFE_OS_BANKING_CONSENT_DAYS=180

# ---------- Food ----------
# Food's daily expiry reminder (docs/services/food.md#expiry-reminders), HH:MM
# in LIFE_OS_TIMEZONE: one notification naming the pantry food that expires
# today or tomorrow, sent only when there is some.
LIFE_OS_FOOD_EXPIRY_TIME=08:00

# ---------- Notifications ----------
# Notification delivery channels (docs/services/notifications.md), comma-
# separated. Empty: notifications are stored and listed in the Dashboard only.
# "ntfy" pushes them to the owner's phone (below); "webpush" pushes them to
# every device that turned on notifications in Life OS (the installed app;
# keys below); "log" writes each delivery to the notifications service log.
# Both phone channels: LIFE_OS_NOTIFICATIONS_CHANNELS=ntfy,webpush
LIFE_OS_NOTIFICATIONS_CHANNELS=

# Web push to the installed Life OS app (optional,
# docs/services/notifications.md#web-push). The VAPID key pair; print a new
# one with `cd services/notifications && GOWORK=off go run ./cmd/vapid-keys`
# and paste both lines here. The private key is a secret: never commit it.
# With the keys set, Notifications → "Notifications on this device" can be
# turned on; add webpush to LIFE_OS_NOTIFICATIONS_CHANNELS to deliver there.
# The subject is how a push service's operator reaches you: a mailto: address
# or an https URL (empty: LIFE_OS_PUBLIC_URL).
LIFE_OS_WEBPUSH_VAPID_PUBLIC_KEY=
LIFE_OS_WEBPUSH_VAPID_PRIVATE_KEY=
LIFE_OS_WEBPUSH_SUBJECT=

# Self-hosted ntfy for phone notifications (the ntfy module,
# docs/operations/ntfy.md). Turn it on with ntfy in COMPOSE_PROFILES above
# (next to cloudflare, which it needs: COMPOSE_PROFILES=cloudflare,ntfy) and
# LIFE_OS_NOTIFICATIONS_CHANNELS=ntfy; ./setup.sh ntfy does both.
# ntfy provisions two users from these values at every start:
#  - lifeos-publisher, the Notifications service: write-only on the topic, by
#    token. Token: `docker run --rm binwiederhier/ntfy:v2.37.2 token generate`
#    (tk_ and 29 characters). Its password is never used: hash a random one.
#  - lifeos-phone, the ntfy app on the owner's phone: read-only on the topic,
#    by password (keep it in your password manager; only its hash goes here).
# Hash a password with `docker run --rm -it binwiederhier/ntfy:v2.37.2 user hash`.
# Bcrypt hashes contain $: keep them in single quotes. Secrets: never commit
# real values. The public URL is the one the phone's ntfy app uses (ntfy's
# base-url): its own tunnel route, without Access.
LIFE_OS_NTFY_PUBLIC_URL=https://ntfy.example.com
LIFE_OS_NTFY_TOPIC=lifeos
LIFE_OS_NTFY_PUBLISHER_TOKEN=
LIFE_OS_NTFY_PUBLISHER_PASSWORD_HASH=''
LIFE_OS_NTFY_PHONE_PASSWORD_HASH=''

# ---------- Server health ----------
# Server health on Status (docs/services/host-health.md). The group of the
# Docker socket (`stat -c %g /var/run/docker.sock`): the read-only docker
# gateway runs as nobody in this group, the only container that opens the
# socket. Without the right value Status says container facts are
# unavailable. And the Docker data root, if not /var/lib/docker.
LIFE_OS_DOCKER_GID=999
LIFE_OS_DOCKER_ROOT=/var/lib/docker
# Thresholds: memory available below 15% for 3 minutes is a warning, below 7%
# a problem; a disk with less than 10 GiB or 10% free is a warning, less than
# 3 GiB a problem; a 15-minute load above the CPUs times 1 is a warning; so is
# a container Docker restarted by itself 3 times in 15 minutes, or unhealthy for 5.
LIFE_OS_HOST_HEALTH_MEMORY_WARNING_PERCENT=15
LIFE_OS_HOST_HEALTH_MEMORY_WARNING_SAMPLES=3
LIFE_OS_HOST_HEALTH_MEMORY_PROBLEM_PERCENT=7
LIFE_OS_HOST_HEALTH_DISK_WARNING_GIB=10
LIFE_OS_HOST_HEALTH_DISK_WARNING_PERCENT=10
LIFE_OS_HOST_HEALTH_DISK_PROBLEM_GIB=3
LIFE_OS_HOST_HEALTH_LOAD_WARNING_PER_CPU=1
LIFE_OS_HOST_HEALTH_RESTART_LOOP_COUNT=3
LIFE_OS_HOST_HEALTH_RESTART_LOOP_MINUTES=15
LIFE_OS_HOST_HEALTH_UNHEALTHY_MINUTES=5
# Compose projects never reported as restarting, unhealthy, or a big memory
# user: the verification stack, which test runs bring up and down.
LIFE_OS_HOST_HEALTH_IGNORE_PROJECTS=lifeos-verify
# Monitor (docs/services/monitor.md): seconds between two reads of the
# Status checks, and how many reads in a row a change must hold before the
# owner is notified.
LIFE_OS_MONITOR_INTERVAL_SECONDS=60
LIFE_OS_MONITOR_CONFIRMATIONS=2

# ---------- Android ----------
# The Android apps' releases (docs/operations/android-releases.md): the host
# directory tools/publish-android-release writes, owned by you (mode 755),
# which the gateway mounts read-only and serves at /android/. Defaults to
# ~/life-os.android of the user who runs Compose.
# LIFE_OS_ANDROID_RELEASES_DIR=/home/you/life-os.android
# The GitHub repository whose Releases tools/publish-android-release also
# publishes each build to, with gh: apps that are not connected to your
# server update from there. Defaults to GAMch1k/life-os-app; off turns the
# GitHub step off (--no-github does for one run).
# LIFE_OS_ANDROID_GITHUB_REPO=GAMch1k/life-os-app
