# Copy this file to .env for local development. Never commit the real .env.
LIFE_OS_POSTGRES_IMAGE=postgres:18.6-alpine
LIFE_OS_POSTGRES_DB=postgres
LIFE_OS_POSTGRES_USER=lifeos_admin
LIFE_OS_POSTGRES_PASSWORD=replace-with-a-local-password
LIFE_OS_POSTGRES_PORT=5432

# Each domain service receives only its own database credential.
LIFE_OS_FINANCE_DB_PASSWORD=replace-with-a-local-finance-password
LIFE_OS_TASKS_DB_PASSWORD=replace-with-a-local-tasks-password
LIFE_OS_INBOX_DB_PASSWORD=replace-with-a-local-inbox-password
LIFE_OS_CALENDAR_DB_PASSWORD=replace-with-a-local-calendar-password
