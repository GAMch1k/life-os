# Included from nginx.conf's http context.
#
# A template: the nginx image renders it at every start of the gateway
# (/etc/nginx/templates/default.conf.template to /etc/nginx/conf.d/default.conf)
# and replaces only the ${LIFE_OS_*} names, which compose.yaml sets from .env
# (NGINX_ENVSUBST_FILTER). nginx's own $variables stay as they are.
#
# What the limits below count by: the client's address (as resolved below,
# from Cloudflare's header or a trusted proxy's X-Forwarded-For), and for an
# IPv6 client its /64, the block one connection usually holds, as the
# Dashboard's own limits do: $binary_remote_addr is 4 bytes for IPv4 and 16
# for IPv6, of which the first 8 are the /64.
map $binary_remote_addr $lifeos_limit_key {
  "~^(?<lifeos_ipv6_prefix>[\s\S]{8})[\s\S]{8}$" $lifeos_ipv6_prefix;
  default $binary_remote_addr;
}
limit_req_zone $lifeos_limit_key zone=lifeos_api:10m rate=30r/s;
limit_req_zone $lifeos_limit_key zone=lifeos_write:10m rate=10r/s;
limit_req_zone $lifeos_limit_key zone=lifeos_mcp:10m rate=5r/s;
# Signing in (/api/auth/): Better Auth limits each address and path as well,
# and slows down failed sign-ins per username and per account
# (src/lib/auth/throttle.ts).
limit_req_zone $lifeos_limit_key zone=lifeos_auth:10m rate=2r/s;
# The Dashboard's pages, files, and own routes (location /): generous, so
# that no page load (some fetch dozens of files at once), browser test, or
# person ever meets it, but one client cannot flood the Dashboard
# (tools/test-gateway-auth checks both).
limit_req_zone $lifeos_limit_key zone=lifeos_pages:10m rate=100r/s;
limit_conn_zone $lifeos_limit_key zone=lifeos_client:10m;

# Cloudflare path. Requests from the edge network (10.255.249.0/29, which only
# the cloudflared connector shares with the gateway) carry the visitor's
# address in CF-Connecting-IP and arrived over HTTPS at Cloudflare. The header
# is trusted from that network alone; from WireGuard or anywhere else it is
# ignored, so it cannot be spoofed to fake an address.
geo $realip_remote_addr $via_cloudflare {
  default 0;
  10.255.249.0/29 1;
}
# Your own reverse proxies (LIFE_OS_TRUSTED_PROXIES in .env, empty by
# default; docs/install/access.md#your-own-reverse-proxy): Caddy, Traefik,
# Nginx Proxy Manager, Tailscale Serve. A request from one of them carries
# the client's address in X-Forwarded-For and the scheme the client used in
# X-Forwarded-Proto. trusted-proxies.envsh writes the proxies' addresses into
# this file and into trusted-proxies.conf, which every location of Life OS
# includes (below), at every start. Nobody else's forwarded headers are
# believed: from any other address they are ignored, so they cannot be
# spoofed to fake an address.
geo $realip_remote_addr $via_trusted_proxy {
  default 0;
  include /run/lifeos/trusted-proxies.geo;
}
map "$via_cloudflare:$via_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
  default $scheme;
  "~^1:" https;
  "0:1:https" https;
}
# Every request that reaches Life OS through the tunnel passed Cloudflare
# Access, which adds its token (Cf-Access-Jwt-Assertion; the connector also
# validates it). One without it came through a route without Access, such as
# a mistaken route to the gateway, and is refused rather than served Life OS.
# LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS (.env) turns this off (off, no, false,
# or 0), making Life OS's own sign-in the only gate on the tunnel; empty, or
# anything else, keeps it on (docs/operations/cloudflare.md).
map "${LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS}:$via_cloudflare:$http_cf_access_jwt_assertion" $missing_access_token {
  default 0;
  "~*^(?!(off|no|false|0):)[^:]*:1:$" 1;
}

# The routes of the optional modules that are off (docs/architecture/modules.md):
# modules.envsh writes one entry per route, from LIFE_OS_MODULES and
# module-routes, just before this template is rendered. Such a request is
# answered 404 module_off at once (below): the gateway never asks Docker's
# DNS for a service that is not there, which can take seconds (BUG-50).
map $uri $lifeos_module_off {
  default "";${LIFE_OS_GATEWAY_MODULE_ROUTES}
}

# A request path no client of Life OS sends: an encoded slash, backslash,
# or dot (%2F, %5C, %2E, either case), a backslash, or a dot segment (/./,
# /../). nginx decodes and resolves them before it picks a location, while
# the Dashboard's location passes the path on as the client sent it, so the
# two would read it differently. Answered 400 before any location (below).
# Only the path: the query string carries encoded URLs as it should (a
# recipe link, OAuth's redirect_uri).
map $request_uri $lifeos_bad_path {
  default 0;
  "~*^[^?]*(%2f|%5c|%2e|\x5c)" 1;
  "~^[^?]*/\.\.?(/|\?|$)" 1;
}

# HTTPS only (Strict-Transport-Security): a request that came over HTTPS,
# through Cloudflare or a trusted proxy. Empty, and so not sent, otherwise:
# plain HTTP on a LAN, WireGuard, or an SSH tunnel stays usable.
map $forwarded_proto $lifeos_hsts {
  default "";
  https "max-age=31536000";
}

# The gateway's 403, by the auth check's reason (X-Life-OS-Auth-Error, kept
# by auth_request_set in each location that asks it): a fixed list, never
# the header's own text. Empty, the refusal is the gateway's own: a request
# through the tunnel without Access's token
# (docs/api/devices.md#when-a-request-is-refused).
map $lifeos_auth_error $lifeos_forbidden_body {
  default '{"error":{"code":"forbidden","message":"This request is not allowed here"}}';
  credential_not_allowed '{"error":{"code":"credential_not_allowed","message":"This device key or token may not be used here"}}';
  insufficient_scope '{"error":{"code":"insufficient_scope","message":"This token may not do this: see its scopes in Settings, API tokens"}}';
  forbidden_origin '{"error":{"code":"forbidden_origin","message":"This request did not come from Life OS"}}';
  forbidden_path '{"error":{"code":"forbidden_path","message":"This path is not allowed"}}';
}

# Attribution (pkg/activity). Public clients may say they are the owner
# ("user") or a development tool ("dev:<name>"), which cannot impersonate
# anyone internal. Claims to be the Life OS AI ("agent:") or a component
# ("system:") are dropped, so such a write fails the services' actor gate.
# Internal callers reach the services over the private network, not here.
map $http_x_life_os_actor $public_actor {
  default "";
  "user" "user";
  "~^dev:[A-Za-z0-9._-]{1,64}$" $http_x_life_os_actor;
}

# Credentials go only to the Dashboard (which runs the sign-in and the auth
# check); a service gets the identity token instead and never the cookie or
# an Authorization header (docs/architecture/multi-user.md#the-gateway).
map $upstream $lifeos_cookie {
  default "";
  "dashboard:3000" $http_cookie;
}
map $upstream $lifeos_authorization {
  default "";
  "dashboard:3000" $http_authorization;
}

# Every upstream by its name on the private network alone:
# <name>.<that network> (LIFE_OS_BACKEND_NETWORK: lifeos-backend, the
# verification stack's lifeos-verify-backend). Docker's DNS answers a bare
# name from any network the gateway is on, and the gateway is also on edge
# and proxy, where your reverse proxy, and whatever else you attach there,
# is: a container named or aliased dashboard or tasks there would receive
# the Dashboard's cookies and the auth check's questions whenever the real
# one is not running (a restart, an update, a module that is off). A
# qualified name is answered from that network alone, and not at all
# without the container (tools/test-gateway-proxies).
map $upstream $lifeos_upstream {
  default "";
  "~^(?<lifeos_upstream_host>[a-z0-9-]+):(?<lifeos_upstream_port>[0-9]+)$" "$lifeos_upstream_host.${LIFE_OS_BACKEND_NETWORK}:$lifeos_upstream_port";
}

# Only the hosts listed in the Life OS server_name below reach Life OS. Any
# other Host (a forged one, a mistaken tunnel route, a scanner) gets no answer
# at all: 444 closes the connection.
server {
  listen 80 default_server;
  server_name _;
  server_tokens off;
  return 444;
}

# Life OS.
server {
  listen 80;
  # The hosts that reach Life OS, the one list (tools/check-gateway-hosts
  # checks its form). The gateway matches the Host header without its port.
  #  - LIFE_OS_PUBLIC_HOSTNAME (.env; empty: none): the public hostname, such
  #    as the one behind Cloudflare Access and the tunnel, or your reverse
  #    proxy's, which must pass it on as Host (docs/install/proxies/).
  #  - LIFE_OS_GATEWAY_BIND_ADDRESS (.env; default 127.0.0.1): the address
  #    the gateway publishes on, such as a WireGuard address, for its peers
  #    and for maintenance on the host.
  #  - 127.0.0.1 and localhost: the default loopback bind (127.0.0.1:3000),
  #    the verification stack (127.0.0.1:13001) with its smokes and browser
  #    tests, and the smokes that ask Compose for the published address.
  server_name ${LIFE_OS_PUBLIC_HOSTNAME} ${LIFE_OS_GATEWAY_BIND_ADDRESS} 127.0.0.1 localhost;
  server_tokens off;
  # The client's address. Through the tunnel, Cloudflare's header, from the
  # edge network alone, as soon as the request is read. Through your own
  # reverse proxy, X-Forwarded-For, from LIFE_OS_TRUSTED_PROXIES alone:
  # nginx reads one header per level, so that one is set in each location
  # (include trusted-proxies.conf, empty by default) and applies when the
  # location is chosen, still before its rate limits, the auth check, and
  # the log (tools/test-gateway-proxies; tools/check-gateway-hosts checks
  # that every location includes it). real_ip_recursive skips the proxies'
  # own addresses from the right, so an entry the client wrote itself, left
  # of the one its proxy added, never counts. A location that answers at once
  # with return (a closed path such as /internal/ or /_next/image, a module
  # that is off, the /android redirect) does so before that, so its log line
  # names the proxy: it reaches nothing and limits nothing. Every other
  # request keeps the address it came from.
  set_real_ip_from 10.255.249.0/29;
  real_ip_header CF-Connecting-IP;
  if ($missing_access_token) { return 403; }
  if ($lifeos_bad_path) { rewrite ^ /.lifeos/bad-path last; }
  if ($lifeos_module_off) { rewrite ^ /.lifeos/module-off last; }
  # Filled by auth_request_set in the locations that ask the auth check;
  # empty (and so not sent) everywhere else.
  set $lifeos_identity "";
  # Only the gateway's own refusals: without proxy_intercept_errors, a
  # service's or the Dashboard's 401, 403, or 500 passes unchanged.
  error_page 401 = @lifeos_unauthenticated;
  error_page 403 = @lifeos_forbidden;
  error_page 500 = @lifeos_auth_unavailable;
  client_max_body_size 26m;
  client_header_timeout 15s;
  client_body_timeout 30s;
  send_timeout 60s;
  keepalive_timeout 30s;
  limit_req_status 429;
  limit_conn_status 429;
  limit_conn lifeos_client 20;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;
  # A policy that cannot stop a script of the Dashboard's: no page of Life
  # OS in a frame, no <base> or plugin, and forms post to Life OS alone
  # (every form of the Dashboard posts to its own pages or runs a script;
  # the OAuth consent and the pairing leave with a script, never a form).
  add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" always;
  add_header Strict-Transport-Security $lifeos_hsts always;
  # Set by the Android downloads (location /android/ below) and empty
  # everywhere else, where add_header then sends nothing. An add_header in
  # a location would replace the six above there, so the downloads set
  # these variables instead. The auth check's subrequest runs the server's
  # own directives again and shares the request's variables, so it must not
  # empty them after /android/ set them.
  if ($uri !~ "^/internal/auth/") {
    set $android_cache_control "";
    set $android_content_disposition "";
    # The route a location names for the auth check (below), which the
    # check's subrequest must keep.
    set $lifeos_route "";
    # The check's reason for a refusal (auth_request_set, below).
    set $lifeos_auth_error "";
  }
  add_header Cache-Control $android_cache_control;
  add_header Content-Disposition $android_content_disposition;

  # Never forward a caller-supplied chain of proxy headers: the client's
  # address as resolved above, the scheme from Cloudflare or a trusted proxy
  # (else the gateway's own), and the Host the client asked for.
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  # Services never see Cloudflare identity or address headers: none of them
  # authenticates with Cloudflare, and a forwarded copy could be spoofed.
  proxy_set_header CF-Connecting-IP "";
  proxy_set_header Cf-Access-Jwt-Assertion "";
  proxy_set_header Cf-Access-Authenticated-User-Email "";
  # Only user and dev:<name> actors pass; workflow links are set by services.
  proxy_set_header X-Life-OS-Actor $public_actor;
  # Who calls, as the auth check says; a client's own copy never passes.
  proxy_set_header X-Life-OS-Identity $lifeos_identity;
  proxy_set_header Cookie $lifeos_cookie;
  proxy_set_header Authorization $lifeos_authorization;
  proxy_set_header X-Correlation-ID "";
  proxy_set_header X-Causation-ID "";
  proxy_http_version 1.1;
  proxy_connect_timeout 5s;
  proxy_send_timeout 60s;
  proxy_read_timeout 60s;

  # Upstream names are resolved when a request comes, through Docker's
  # embedded DNS, and kept at most 10 s (BUG-37). A proxy_pass with a fixed
  # host name is resolved once, when nginx starts: a service recreated by a
  # redeploy gets a new address, and the gateway kept sending its traffic to
  # the old one, which by then could belong to another container. Every
  # proxy_pass below therefore names its upstream through a variable, which
  # makes nginx resolve it at request time, and strips its location prefix
  # with a rewrite, as proxy_pass with a URI did (a proxy_pass whose host is
  # a variable sends a URI given there as is, for every request). The query
  # string follows the rewritten path unchanged. A name that does not
  # resolve (the service is not running) is a 502 for that request, not a
  # gateway that cannot start. The name is the service's on the private
  # network alone ($lifeos_upstream, above).
  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  location /api/finance/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route finance;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream finance:8080;
    rewrite ^/api/finance(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/tasks/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route tasks;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream tasks:8080;
    rewrite ^/api/tasks(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/inbox/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route inbox;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream inbox:8080;
    rewrite ^/api/inbox(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/calendar/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route calendar;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream calendar:8080;
    rewrite ^/api/calendar(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/food/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route food;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream food:8080;
    rewrite ^/api/food(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  # Activity is read-only through the gateway; services record events on the
  # private network.
  location /api/activity/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route activity;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    limit_except GET { deny all; }
    set $upstream activity:8080;
    rewrite ^/api/activity(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/notifications/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route notifications;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream notifications:8080;
    rewrite ^/api/notifications(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  # Integration services, one prefix each: /api/integrations/<name>/.
  location /api/integrations/banking/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route finance;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream banking:8080;
    rewrite ^/api/integrations/banking(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/integrations/google-calendar/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route calendar;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream google-calendar:8080;
    rewrite ^/api/integrations/google-calendar(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/integrations/calendar-feeds/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route calendar;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream calendar-feeds:8080;
    rewrite ^/api/integrations/calendar-feeds(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/integrations/recipe-import/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route food;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_api burst=60 nodelay;
    set $upstream recipe-import:8080;
    rewrite ^/api/integrations/recipe-import(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/voice/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route voice;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    limit_req zone=lifeos_write burst=20 nodelay;
    # An over-limit upload is answered 413 at once, but by default nginx then
    # discards the rest of the body for only 30 s (lingering_time) before it
    # closes. A client or tunnel still sending gets a reset, which Cloudflare
    # reports as 502 (BUG-15). Draining for up to 2 minutes lets the 413
    # arrive intact for any upload faster than about 230 KB/s. The Dashboard
    # also refuses over-limit recordings before uploading.
    lingering_time 120s;
    lingering_timeout 15s;
    set $upstream voice:8080;
    rewrite ^/api/voice(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  location /api/mcp/ {
    include /run/lifeos/trusted-proxies.conf;
    set $lifeos_route mcp;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    auth_request_set $lifeos_identity $upstream_http_x_life_os_identity;
    # An MCP client without a valid token learns where to sign in: the
    # check answers its 401 with WWW-Authenticate (RFC 9728's
    # resource_metadata), which nginx's auth_request passes on with the 401
    # by itself, through the server's error_page as well (P21-06;
    # tools/test-gateway-auth checks it is there, once).
    limit_req zone=lifeos_mcp burst=10 nodelay;
    proxy_buffering off;
    proxy_read_timeout 300s;
    set $upstream mcp:8080;
    rewrite ^/api/mcp(/.*)$ $1 break;
    proxy_pass http://$lifeos_upstream;
  }
  # Share → Life OS: the phone's share sheet posts what was shared, photos
  # included (up to five of 10 MB), to the Dashboard in one request.
  location = /share {
    include /run/lifeos/trusted-proxies.conf;
    limit_req zone=lifeos_write burst=20 nodelay;
    client_max_body_size 60m;
    client_body_timeout 120s;
    # As for Voice: drain an over-limit upload so the 413 arrives intact.
    lingering_time 120s;
    lingering_timeout 15s;
    proxy_read_timeout 120s;
    set $upstream dashboard:3000;
    proxy_pass http://$lifeos_upstream;
  }
  # Google returns the owner here with a one-time authorization code in the
  # query: keep it out of the access log.
  location = /calendar/google/callback {
    include /run/lifeos/trusted-proxies.conf;
    access_log off;
    set $upstream dashboard:3000;
    proxy_pass http://$lifeos_upstream;
  }
  # The bank returns the owner here with a one-time authorization code in
  # the query: keep it out of the access log too.
  location = /finance/bank/callback {
    include /run/lifeos/trusted-proxies.conf;
    access_log off;
    set $upstream dashboard:3000;
    proxy_pass http://$lifeos_upstream;
  }
  # The Android apps' releases (docs/operations/android-releases.md), which
  # tools/publish-android-release writes to a host directory the gateway
  # mounts read-only at /srv/android. Behind Cloudflare Access like every
  # other path here, never a bypass. Only the download page, the manifest,
  # and the versioned APKs are served: any other name is a 404, there is no
  # listing, and symbolic links are refused. nginx resolves "." and ".."
  # segments (encoded ones too) before it picks a location, so no request
  # leaves /srv/android.
  location = /android {
    include /run/lifeos/trusted-proxies.conf;
    absolute_redirect off;
    return 301 /android/;
  }
  location ^~ /android/ {
    include /run/lifeos/trusted-proxies.conf;
    # Signed in, or a paired device (P21-06), or legacy access: as every
    # service route (docs/architecture/multi-user.md#the-gateway).
    set $lifeos_route android;
    auth_request /internal/auth/check;
    auth_request_set $lifeos_auth_error $upstream_http_x_life_os_auth_error;
    # A download is one request, so the general limit never cuts a long one
    # off, and send_timeout bounds a pause between two writes, not the whole
    # download. Files are served to GET and HEAD only (any other method is
    # a 405).
    limit_req zone=lifeos_api burst=60 nodelay;
    root /srv;
    disable_symlinks on;
    autoindex off;
    # The download page: without a sign-in, the login, then back here.
    location = /android/ {
      error_page 401 = @lifeos_login;
      error_page 403 = @lifeos_forbidden;
      error_page 500 = @lifeos_auth_unavailable;
      set $android_cache_control "no-cache";
      charset utf-8;
      try_files /android/index.html =404;
    }
    # The manifest the app checks for updates.
    location ~ "^/android/updates(\.json)?$" {
      set $android_cache_control "no-cache";
      types { }
      default_type application/json;
      try_files /android/updates.json =404;
    }
    # The APKs. A name carries its version and never changes content, so
    # it is cached for good, by the phone only: "private" keeps Cloudflare
    # from storing a copy outside Access.
    location ~ "^/android/lifeos-(phone|wear)-[0-9A-Za-z][0-9A-Za-z._+-]*-[0-9]+\.apk$" {
      set $android_cache_control "private, max-age=31536000, immutable";
      set $android_content_disposition "attachment";
      types { }
      default_type application/vnd.android.package-archive;
    }
    return 404;
  }
  # The auth check (the Dashboard's /internal/auth/check), which every
  # service location asks with auth_request: 204 with the identity token,
  # 401, or 403. No body; the original method and URI, and the client's
  # headers, so it sees the cookie, Origin, and Sec-Fetch-Site. It sets
  # headers of its own, so it repeats the server's set: a location with any
  # proxy_set_header inherits none of the server's.
  location = /internal/auth/check {
    include /run/lifeos/trusted-proxies.conf;
    internal;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-URI $request_uri;
    # The route of the location that asks (P21-06): nginx picked it from
    # the decoded, normalized path, which $request_uri does not show, so a
    # token's scopes are judged against what the request really reaches. A
    # client's own copy never passes (empty: not sent).
    proxy_set_header X-Life-OS-Route $lifeos_route;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header Cf-Access-Jwt-Assertion "";
    proxy_set_header Cf-Access-Authenticated-User-Email "";
    proxy_set_header X-Life-OS-Actor "";
    proxy_set_header X-Life-OS-Identity "";
    proxy_set_header X-Correlation-ID "";
    proxy_set_header X-Causation-ID "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;
    # Not $upstream: a subrequest shares the request's variables, and the
    # service location's $upstream must stay its service.
    set $lifeos_auth_upstream dashboard.${LIFE_OS_BACKEND_NETWORK}:3000;
    proxy_pass http://$lifeos_auth_upstream;
  }
  # Every other /internal/ path is the private network's only.
  location ^~ /internal/ {
    include /run/lifeos/trusted-proxies.conf;
    return 404;
  }
  # Better Auth: signing in, two-factor, passkeys, the first account. Public,
  # with a strict limit per address.
  location ^~ /api/auth/ {
    include /run/lifeos/trusted-proxies.conf;
    limit_req zone=lifeos_auth burst=20 nodelay;
    set $upstream dashboard:3000;
    proxy_pass http://$lifeos_upstream;
  }
  # The gateway's refusals, JSON like the services' errors.
  location @lifeos_unauthenticated {
    default_type application/json;
    return 401 '{"error":{"code":"unauthenticated","message":"Sign in to Life OS first"}}';
  }
  location @lifeos_forbidden {
    default_type application/json;
    return 403 $lifeos_forbidden_body;
  }
  location @lifeos_auth_unavailable {
    default_type application/json;
    return 503 '{"error":{"code":"auth_unavailable","message":"Signing in is unavailable right now"}}';
  }
  location @lifeos_login {
    absolute_redirect off;
    return 302 /login?next=$uri;
  }
  # A path no client sends ($lifeos_bad_path, above): it reaches nothing.
  location = /.lifeos/bad-path {
    include /run/lifeos/trusted-proxies.conf;
    internal;
    default_type application/json;
    return 400 '{"error":{"code":"forbidden_path","message":"This path is not allowed"}}';
  }
  # A route of a module that is off (the map above). JSON, like the
  # services' own errors, so that the Dashboard's calls fail softly.
  location = /.lifeos/module-off {
    include /run/lifeos/trusted-proxies.conf;
    internal;
    default_type application/json;
    return 404 '{"error":{"code":"module_off","message":"This Life OS module is turned off"}}';
  }
  # The Dashboard shows images with plain <img> elements, never next/image, so
  # Next.js's Image Optimization API is unused; the Dashboard itself turns it
  # off (images.unoptimized), and the gateway closes the path too, as a second
  # layer.
  location ^~ /_next/image {
    include /run/lifeos/trusted-proxies.conf;
    return 404;
  }
  # The Dashboard's locations pass the request URI as the client sent it,
  # as before: their proxy_pass has no URI. This one also serves MCP's
  # OAuth metadata, which a client reads before it signs in, so public:
  # /.well-known/oauth-protected-resource/api/mcp and
  # /.well-known/oauth-authorization-server (P21-06).
  location / {
    include /run/lifeos/trusted-proxies.conf;
    limit_req zone=lifeos_pages burst=1000 nodelay;
    set $upstream dashboard:3000;
    proxy_pass http://$lifeos_upstream;
  }
}
