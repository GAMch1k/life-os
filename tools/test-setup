package identity

import (
	"crypto/ed25519"
	"encoding/base64"
	"encoding/json"
	"os"
	"testing"
	"time"
)

func TestSetupHelperKeys(t *testing.T) {
	var private struct{ Kid, X, D string }
	if err := json.Unmarshal([]byte(os.Getenv("SETUP_SIGNING")), &private); err != nil {
		t.Fatal(err)
	}
	seed, err := base64.RawURLEncoding.DecodeString(private.D)
	if err != nil || len(seed) != ed25519.SeedSize {
		t.Fatalf("seed: %v", err)
	}
	key := ed25519.NewKeyFromSeed(seed)
	if base64.RawURLEncoding.EncodeToString(key.Public().(ed25519.PublicKey)) != private.X {
		t.Fatal("x is not the private key's public half")
	}
	set, err := ParseKeySet(os.Getenv("SETUP_TRUSTED"))
	if err != nil || set.Len() != 1 {
		t.Fatalf("trusted keys: %v", err)
	}
	encode := func(v any) string { raw, _ := json.Marshal(v); return base64.RawURLEncoding.EncodeToString(raw) }
	input := encode(map[string]string{"alg": "EdDSA", "typ": "lifeos-id+jwt", "kid": private.Kid}) + "." + encode(map[string]any{
		"iss": "lifeos-auth", "aud": "lifeos-services", "sub": "00000000-0000-4000-8000-000000000001", "via": "legacy",
		"exp": time.Now().Add(time.Minute).Unix(),
	})
	token := input + "." + base64.RawURLEncoding.EncodeToString(ed25519.Sign(key, []byte(input)))
	if _, err := NewVerifier(set, nil).Verify(token); err != nil {
		t.Fatal(err)
	}
}
EOF
