ok 'before any docker command or check' test ! -s "$case_dir.log"
# Asked: a warning, after the backup's date and size, before the question.
printf 'n\n' >"$work/answers"
stdin=$work/answers
run LIFE_OS_SETUP_RESTORE_TOOLS="$restore_tools" STUB_RUNNING="$running" -- restore
stdin=/dev/null
ok 'asked, restore warns' output_has "Warning: $small. It may be the empty Life OS of a new server rather than your data. To restore the older one: ./setup.sh restore 20261120T021500Z"
ok 'after what it would restore' test "$(grep -n '^This puts Life OS back' "$case_dir.last" | cut -d: -f1)" -lt "$(grep -n '^Warning: backup 20261122T110000Z' "$case_dir.last" | cut -d: -f1)"
ok 'and no changes nothing' output_has 'nothing was changed'
ok 'nothing stopped' bash -c "! grep -q 'compose stop' '$case_dir.log'"
# Named by its day or its name, the small backup is restored with --yes,
# after the warning.
for named in 2026-11-22 20261122T110000Z; do
  : >"$case_dir.log"
  run LIFE_OS_SETUP_RESTORE_TOOLS="$restore_tools" STUB_RUNNING="$running" LIFE_OS_SETUP_WAIT_SECONDS=5 -- --yes restore "$named"
  ok "restore $named --yes restores the small backup it names" test "$status" -eq 0
  ok 'after the warning' output_has "Warning: $small"
  ok 'that one' logged 'restore-database tasks_db 20261122T110000Z --confirm'
done
# A backup as big as the older ones: no warning.
run LIFE_OS_SETUP_RESTORE_TOOLS="$restore_tools" STUB_RUNNING="$running" LIFE_OS_SETUP_WAIT_SECONDS=5 -- --yes restore 2026-11-20
ok 'restore of a backup as big as the older ones' test "$status" -eq 0
ok 'without a warning' bash -c "! grep -q '^Warning: ' '$case_dir.last'"

# ---------- jq, which restore needs ----------
# Said at the first setup and at each update, not first in a disaster. The
# host's tools but jq, on PATH.
nojq=$work/nojq
mkdir -p "$nojq"
for tool in /usr/bin/* /bin/*; do
  [[ ${tool##*/} == jq || -e $nojq/${tool##*/} ]] || ln -s "$tool" "$nojq/${tool##*/}"
done
new_case no-jq
run PATH="$stubs:$nojq" LIFE_OS_TIMEZONE=UTC -- --yes
ok 'a first setup without jq' test "$status" -eq 0
ok 'warns that restore needs it' output_has 'Warning: jq is not installed. ./setup.sh restore needs it to read the backups: install it now (sudo apt install jq)'
run PATH="$stubs:$nojq" STUB_BACKUP_RUNNING=0 LIFE_OS_SETUP_WAIT_SECONDS=1 -- update --skip-backup
ok 'update without jq' test "$status" -eq 0
ok 'warns too' output_has 'Warning: jq is not installed.'
run PATH="$stubs:$nojq" -- restore list
ok 'restore without jq stops' test "$status" -eq 1
ok 'and says to install it' output_has 'restore needs jq to read the backups: install it (sudo apt install jq)'
run STUB_BACKUP_RUNNING=0 LIFE_OS_SETUP_WAIT_SECONDS=1 -- update --skip-backup
ok 'with jq: no such warning' bash -c "! grep -q 'jq is not installed' '$case_dir.last'"

# The repository's setup.sh outside a clone has no tools to restore with.
new_case restore-repository-script repository
run LIFE_OS_TIMEZONE=UTC -- --yes
make_runs "$case_dir/backups"
run STUB_RUNNING="$running" -- --yes restore
ok "the repository's setup.sh cannot restore" test "$status" -eq 1
ok 'says to use the release one' output_has 'without the restore tools'

# In a clone it runs the clone's tools/ and registry.
new_case restore-checkout repository
mkdir -p "$case_dir/.git" "$case_dir/tools" "$case_dir/infra/postgres"
cp "$restore_tools/restore-database" "$restore_tools/restore-media" "$case_dir/tools/"
cp infra/postgres/service-databases.conf "$case_dir/infra/postgres/"
run LIFE_OS_TIMEZONE=UTC -- --yes
make_runs "$work/home/life-os.backups"
: >"$case_dir.log"
run STUB_RUNNING="$running" LIFE_OS_SETUP_WAIT_SECONDS=5 -- --yes restore
ok 'restore in a clone' test "$status" -eq 0
ok "with the clone's tools and registry" logged "restore-database tasks_db 20261121T021500Z --confirm --no-fresh-dump [in $case_dir, registry $case_dir/infra/postgres/service-databases.conf]"
ok 'in UTC, as its .env says' output_has 'as it was at 2026-11-21 02:15 (UTC)'
ok 'starts again without recreating anything' logged 'docker compose start backup tasks inbox dashboard gateway'
ok 'never up' bash -c "! grep -q 'compose up' '$case_dir.log'"

# ---------- One list of Whisper languages ----------
# setup.sh's copy of whisper.cpp's language codes is the list the whisper
# image checks against whisper.cpp's source (services/voice/whisper).
ok "setup.sh's Whisper languages are languages.txt's" test \
  "$(sed -n "s/^whisper_languages='\(.*\)'$/\1/p" setup.sh | tr ' ' '\n' | LC_ALL=C sort)" = \
  "$(grep -v '^#' services/voice/whisper/languages.txt | LC_ALL=C sort)"
ok 'about 100 of them' test "$(grep -cv '^#' services/voice/whisper/languages.txt)" -ge 99

printf '\ntest-setup: %d passed, %d failed\n' "$passed" "$failed"
((failed == 0))
