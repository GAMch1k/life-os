# make_run DIR ID RESULT SCOPE [ACTOR] [TASKS_BYTES]: a backup run in the
# backup directory DIR, of three databases (tasks_db's dump 2048 bytes, or
# TASKS_BYTES), listing one Inbox image ($image) of 5 bytes.
make_run() {
  mkdir -p "$1/auto/$2"
  jq -n --arg id "$2" --arg result "$3" --arg scope "$4" --arg actor "${5:-}" --argjson tasks "${6:-2048}" '{
    formatVersion: 1, id: $id, trigger: "schedule", scope: $scope, result: $result, actor: $actor,
    databases: [
      {name: "tasks_db", result: $result, bytes: $tasks, tables: [{schema: "public", name: "tasks", rows: 3}]},
      {name: "inbox_db", result: $result, bytes: 1024, tables: [{schema: "public", name: "inbox_items", rows: 2}]},
      {name: "auth_db", result: $result, bytes: 512, tables: []}],
    media: {service: "inbox", database: "inbox_db", list: "media-inbox.json", count: 1, bytes: 5}}' >"$1/auto/$2/manifest.json"
  jq -n --arg image "$image" '[{sha256: $image, bytes: 5}]' >"$1/auto/$2/media-inbox.json"
}
make_runs() { # the backups of the restore cases, in the backup directory $1
  mkdir -p "$1/media/${image:0:2}"
  printf 'photo' >"$1/media/${image:0:2}/$image"
  make_run "$1" 20261120T021500Z succeeded all
  make_run "$1" 20261121T021500Z succeeded all
  make_run "$1" 20261121T120000Z succeeded subset
  make_run "$1" 20261121T230000Z succeeded all dev:setup-restore
  make_run "$1" 20261122T021500Z failed all
}
