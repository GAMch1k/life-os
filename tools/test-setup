ok "warns that Google refuses a plain http VPN address" output_has 'only on 127.0.0.1 or localhost'

new_case https-url
run -- --yes --public-url https://lifeos.example.org/
ok 'an https address' test "$status" -eq 0
ok 'without the slash' test "$(value LIFE_OS_PUBLIC_URL)" = https://lifeos.example.org
ok 'its hostname' test "$(value LIFE_OS_PUBLIC_HOSTNAME)" = lifeos.example.org

new_case invalid
run -- --yes --port 70000
ok 'refuses port 70000' test "$status" -eq 2
run LIFE_OS_TIMEZONE=Mars/Olympus -- --yes
ok 'refuses an unknown timezone' test "$status" -eq 2
run LIFE_OS_FINANCE_CURRENCY=euro -- --yes
ok 'refuses a bad currency' test "$status" -eq 2
run -- --yes --public-url ftp://example.org
ok 'refuses a bad address' test "$status" -eq 2
run -- --yes --bind
ok '--bind without a value' test "$status" -eq 2
run -- --frobnicate
ok 'unknown option' test "$status" -eq 2
run -- frobnicate
ok 'unknown command' test "$status" -eq 2
ok 'none of these wrote .env' test ! -e "$case_dir/.env"
run -- help
ok 'help' test "$status" -eq 0
ok 'help lists the integrations' output_has './setup.sh codex'

new_case no-docker-access
run STUB_INFO_ERROR='permission denied while trying to connect to the Docker daemon socket' -- --yes
ok 'refuses without Docker access' test "$status" -eq 1
ok 'names the docker group' output_has 'docker group'
run STUB_ENGINE=24.0.7 STUB_COMPOSE=2.20.2 LIFE_OS_TIMEZONE=UTC -- --yes
ok 'old Docker only warns' test "$status" -eq 0
ok 'warns about the engine' output_has 'Docker Engine 24.0.7 is older'
ok 'warns about compose' output_has 'Docker Compose 2.20.2 is older'

# ---------- The release fills in its version ----------
ok 'one version placeholder' test "$(grep -c '__LIFE_OS_VERSION__' setup.sh)" -eq 1
new_case released
sed -i 's/__LIFE_OS_VERSION__/0.1.0-preview.1/' "$case_dir/setup.sh"
run LIFE_OS_TIMEZONE=UTC -- --yes
ok 'a released script sets its version' test "$(value LIFE_OS_VERSION)" = 0.1.0-preview.1
run -- help
ok 'help shows it' output_has '(0.1.0-preview.1)'

new_case stamped
sed -i '1i LIFE_OS_VERSION=v0.1.0-preview.1' "$case_dir/.env.example"
run LIFE_OS_TIMEZONE=UTC -- --yes
ok "the version .env.example names" test "$(value LIFE_OS_VERSION)" = v0.1.0-preview.1
ok 'once' test "$(grep -c '^LIFE_OS_VERSION=' "$case_dir/.env")" -eq 1
sed -i 's/^LIFE_OS_VERSION=.*/LIFE_OS_VERSION=v0.1.0-preview.2/' "$case_dir/.env.example"
run STUB_BACKUP_RUNNING=0 LIFE_OS_SETUP_WAIT_SECONDS=5 -- update --skip-backup --skip-checks
ok "update goes to the newer .env.example's version" test "$(value LIFE_OS_VERSION)" = v0.1.0-preview.2
ok 'and pulls it' logged 'docker compose pull [LIFE_OS_VERSION=v0.1.0-preview.2]'

# ---------- Questions ----------
new_case interactive
printf 'Asia/Tokyo\nusd\n\nn\n' >"$work/answers"
stdin=$work/answers
run --
stdin=/dev/null
ok 'answers questions' test "$status" -eq 0
ok 'timezone from the answer' test "$(value LIFE_OS_TIMEZONE)" = Asia/Tokyo
ok 'currency upper-cased' test "$(value LIFE_OS_FINANCE_CURRENCY)" = USD
ok 'empty answer keeps the default' test "$(value LIFE_OS_PUBLIC_URL)" = http://127.0.0.1:3000
ok 'lists the integrations' output_has 'Later: ./setup.sh <name>'
new_case interactive-eof
run --
ok 'no answers and no --yes: stops' test "$status" -eq 1
ok 'says to use --yes' output_has 'use --yes'

# ---------- Integrations ----------
new_case integrations
run LIFE_OS_TIMEZONE=UTC -- --yes
pem=$case_dir/enablebanking.pem
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:1024 -out "$pem" 2>/dev/null
chmod 600 "$pem"

run -- --yes codex
ok 'codex needs a person' test "$status" -eq 1
ok 'says so' output_has 'needs you at a terminal'

run LIFE_OS_GOOGLE_CLIENT_ID=123-abc.apps.googleusercontent.com LIFE_OS_GOOGLE_CLIENT_SECRET=GOCSPX-secretvalue123 -- --yes google
ok 'google' test "$status" -eq 0
ok 'client id' test "$(value LIFE_OS_GOOGLE_CLIENT_ID)" = 123-abc.apps.googleusercontent.com
ok 'client secret' test "$(value LIFE_OS_GOOGLE_CLIENT_SECRET)" = GOCSPX-secretvalue123
ok 'token key generated' grep -qE '^LIFE_OS_GOOGLE_TOKEN_KEY=[A-Za-z0-9+/]{43}=$' "$case_dir/.env"
ok 'shows the redirect URI' output_has 'http://127.0.0.1:3000/calendar/google/callback'
google_key=$(value LIFE_OS_GOOGLE_TOKEN_KEY)
run LIFE_OS_GOOGLE_CLIENT_ID=456-def.apps.googleusercontent.com LIFE_OS_GOOGLE_CLIENT_SECRET=GOCSPX-other -- --yes google
ok 'google again' test "$status" -eq 0
ok 'the token key stays' test "$(value LIFE_OS_GOOGLE_TOKEN_KEY)" = "$google_key"
ok 'the new client id' test "$(value LIFE_OS_GOOGLE_CLIENT_ID)" = 456-def.apps.googleusercontent.com
run LIFE_OS_GOOGLE_CLIENT_ID=nonsense LIFE_OS_GOOGLE_CLIENT_SECRET=x -- --yes google
ok 'refuses a bad client id' test "$status" -eq 2

run LIFE_OS_ENABLE_BANKING_APP_ID=0a1b2c3d-1111-2222-3333-444455556666 LIFE_OS_ENABLE_BANKING_KEY_FILE="$pem" -- --yes banking
ok 'banking' test "$status" -eq 0
ok 'app id' test "$(value LIFE_OS_ENABLE_BANKING_APP_ID)" = 0a1b2c3d-1111-2222-3333-444455556666
ok 'key file' test "$(value LIFE_OS_ENABLE_BANKING_KEY_FILE)" = "$pem"
ok 'bank token key' grep -qE '^LIFE_OS_BANKING_TOKEN_KEY=[A-Za-z0-9+/]{43}=$' "$case_dir/.env"
run LIFE_OS_ENABLE_BANKING_APP_ID=0a1b2c3d-1111 LIFE_OS_ENABLE_BANKING_KEY_FILE="$case_dir/nope.pem" -- --yes banking
ok 'refuses a missing key file' test "$status" -eq 2

run LIFE_OS_SETUP_WHISPER_MODEL=medium -- --yes whisper
ok 'whisper' test "$status" -eq 0
ok 'model path' test "$(value LIFE_OS_WHISPER_MODEL_PATH)" = /models/ggml-medium.bin
ok 'model URL' test "$(value LIFE_OS_WHISPER_MODEL_URL)" = https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-medium.bin
ok 'more memory' test "$(value LIFE_OS_WHISPER_MEMORY)" = 3g
ok 'the language stays auto' test "$(value LIFE_OS_WHISPER_LANGUAGE)" = auto
ok 'says the language' output_has 'Language: auto'
run LIFE_OS_SETUP_WHISPER_MODEL=huge -- --yes whisper
ok 'refuses an unknown model' test "$status" -eq 2
run LIFE_OS_WHISPER_LANGUAGE=DE -- --yes whisper
ok 'whisper: a fixed language' test "$status" -eq 0
ok 'the language, lower-cased' test "$(value LIFE_OS_WHISPER_LANGUAGE)" = de
ok 'the model stays' test "$(value LIFE_OS_WHISPER_MODEL_PATH)" = /models/ggml-medium.bin
ok 'says it' output_has 'Language: de (every voice note is transcribed as de)'
run -- --yes whisper
ok 'whisper --yes keeps the language' test "$(value LIFE_OS_WHISPER_LANGUAGE)" = de
for language in xx german 'cs cy' auto2; do
  run LIFE_OS_WHISPER_LANGUAGE="$language" -- --yes whisper
  ok "refuses the language '$language'" test "$status" -eq 2
done
ok 'says which codes' output_has "unknown Whisper language 'auto2'"
ok 'the language is unchanged' test "$(value LIFE_OS_WHISPER_LANGUAGE)" = de
printf 'medium\nyue\n' >"$work/answers"
stdin=$work/answers
