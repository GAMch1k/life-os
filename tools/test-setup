# A release's three files, as the bundle stamps them: setup.sh's version,
# compose.yaml's release line, and .env.example's LIFE_OS_VERSION.
stamp_release() {
  sed -i "s/^release_version='[^']*'$/release_version='$1'/" "$case_dir/setup.sh"
  { printf "# Life OS: the release bundle's compose.yaml.\n# Life OS release: %s\n" "$1"; cat "$work/compose.yaml"; } >"$case_dir/compose.yaml"
  sed -i "s/^LIFE_OS_VERSION=.*/LIFE_OS_VERSION=$1/" "$case_dir/.env.example"
}
