#!/usr/bin/env bash
set -euo pipefail

# Tests setup.sh (docs/install) without Docker: each case copies setup.sh,
# .env.example, and compose.yaml (without its build sections, like the
# release's install compose) into a scratch directory and runs it there with
# stand-ins for docker and curl on PATH, which only record what they were
# asked. Nothing here talks to Docker, a registry, or the network, so it is
# safe on a server that runs Life OS. With shellcheck on PATH it checks both
# scripts first.
#
#   tools/test-setup

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck setup.sh tools/test-setup
  echo 'shellcheck: setup.sh and tools/test-setup are clean'
elif [[ -n ${CI:-} ]]; then
  echo 'test-setup: shellcheck is required in CI' >&2
  exit 2
else
  echo 'test-setup: shellcheck not found; skipping it' >&2
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/lifeos-test-setup.XXXXXX")
vapid_test=services/notifications/internal/webpush/zz_setup_keys_test.go
trap 'rm -rf "$work"; rm -f "$vapid_test"' EXIT
stubs=$work/bin
mkdir -p "$stubs"
touch "$work/docker.sock"

# docker: records each call (with LIFE_OS_VERSION, which update overrides
# for the pull), answers what setup.sh reads, and fails where a STUB_*
# variable asks it to.
cat >"$stubs/docker" <<'EOF'
#!/usr/bin/env bash
printf 'docker %s [LIFE_OS_VERSION=%s]\n' "$*" "${LIFE_OS_VERSION:-}" >>"$STUB_LOG"
case $1 in
  info)
    if [[ -n ${STUB_INFO_ERROR:-} ]]; then echo "$STUB_INFO_ERROR" >&2; exit 1; fi
    case $* in
      *ServerVersion*) echo "${STUB_ENGINE:-29.4.3}" ;;
      *DockerRootDir*) echo "${STUB_WORK}" ;;
    esac
    ;;
  compose)
    shift
    [[ $1 != --profile ]] || shift 2
    case $* in
      'version --short') echo "${STUB_COMPOSE:-v5.1.3}" ;;
      'config --images') printf 'ghcr.io/gamch1k/life-os-tasks:preview\nbinwiederhier/ntfy:v2.37.2@sha256:1875ddcf815c8a3c981d6d78c67a93452d0abba79b1ab9520b1f5f5238902bd7\n' ;;
      'ps -q --status running backup') [[ ${STUB_BACKUP_RUNNING:-1} != 1 ]] || echo 3f1c0ffee ;;
      'ps -q processor') : ;;
      'ps --all --format'*) cat "${STUB_PS_FILE:-/dev/null}" ;;
      exec*) exit "${STUB_BACKUP_EXIT:-0}" ;;
      pull*) exit "${STUB_PULL_EXIT:-0}" ;;
      *) : ;;
    esac
    ;;
  run)
    # ntfy's `user hash`: a bcrypt-shaped hash of what it reads.
    cat >/dev/null
    echo 'password: '
    printf '$2a$10$%s\n' "$(head -c 120 /dev/urandom | base64 -w0 | tr -dc 'A-Za-z0-9' | head -c 53)"
    ;;
esac
EOF

# curl: the Access check (an https:// URL) prints STUB_ACCESS; a feed POST
# writes STUB_FEED_BODY and prints STUB_FEED_STATUS; the gateway answers
# unless STUB_GATEWAY_DOWN is set.
cat >"$stubs/curl" <<'EOF'
#!/usr/bin/env bash
printf 'curl %s\n' "$*" >>"$STUB_LOG"
url=${!#}
out=
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  [[ ${args[i]} != -o ]] || out=${args[i + 1]}
done
case $url in
  https://*) printf '%s' "${STUB_ACCESS:-302 https://team.cloudflareaccess.com/cdn-cgi/access/login/x}" ;;
  */v1/feeds)
    [[ -z $out || $out == /dev/null ]] || printf '%s' "${STUB_FEED_BODY:-{\}}" >"$out"
    printf '%s' "${STUB_FEED_STATUS:-201}"
    ;;
  *) [[ -z ${STUB_GATEWAY_DOWN:-} ]] || exit 7 ;;
esac
EOF
chmod 755 "$stubs/docker" "$stubs/curl"

# The install compose: compose.yaml as the release ships it, images only.
sed -E '/^[[:space:]]+build:/d' compose.yaml >"$work/compose.yaml"

passed=0
failed=0
case_dir=
case_out=

ok() {
  local name=$1
  shift
  if "$@"; then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    printf 'FAIL [%s]: %s\n' "${case_dir##*/}" "$name" >&2
  fi
}

new_case() {
  case_dir=$work/$1
  mkdir -p "$case_dir"
  cp setup.sh .env.example "$case_dir/"
  cp "$work/compose.yaml" "$case_dir/compose.yaml"
  case_out=$case_dir.out
  : >"$case_out"
  : >"$case_dir.log"
}

# run [VAR=value...] -- [setup.sh arguments...]: runs ./setup.sh in the case
# directory with a clean environment, stdin from $stdin (default: none).
# Sets status; appends the output to the case's output.
stdin=/dev/null
run() {
  local -a vars=()
  while (($#)) && [[ $1 != -- ]]; do
    vars+=("$1")
    shift
  done
  shift
  set +e
  (cd "$case_dir" && env -i HOME="$work/home" PATH="$stubs:/usr/bin:/bin" LANG=C.UTF-8 \
    STUB_LOG="$case_dir.log" STUB_WORK="$work" DOCKER_HOST="unix://$work/docker.sock" \
    "${vars[@]}" ./setup.sh "$@" <"$stdin" >"$case_dir.last" 2>&1)
  status=$?
  set -e
  cat "$case_dir.last" >>"$case_out"
}

value() { (cd "$case_dir" && grep -E "^$1=" .env | tail -n 1 | cut -d= -f2-); }
has_line() { grep -qxF -- "$1" "$case_dir/.env"; }
output_has() { grep -qF -- "$1" "$case_dir.last"; }
logged() { grep -qF -- "$1" "$case_dir.log"; }
mode() { stat -c %a "$1"; }

# No secret from .env appears in anything the case printed.
no_secret_printed() {
  local line key val
  while IFS= read -r line; do
    key=${line%%=*}
    val=${line#*=}
    val=${val#\'}
    val=${val%\'}
    [[ $key =~ (PASSWORD|SECRET|TOKEN|_KEY|_HASH)$ && ${#val} -ge 8 ]] || continue
    if grep -qF -- "$val" "$case_out"; then
      echo "  $key's value was printed" >&2
      return 1
    fi
  done < <(grep -E '^[A-Z_]+=' "$case_dir/.env")
}

# Every uncommented key appears once.
no_duplicate_keys() {
  [[ -z $(grep -oE '^[A-Z][A-Z0-9_]*=' "$case_dir/.env" | sort | uniq -d) ]]
}

mkdir -p "$work/home"
uid=$(id -u)
sock_gid=$(stat -c %g "$work/docker.sock")
mapfile -t password_keys < <(sed -n 's/^\(LIFE_OS_[A-Z0-9_]*_PASSWORD\)=.*/\1/p' .env.example)
mapfile -t required_keys < <(grep -oE '\$\{LIFE_OS_[A-Z0-9_]+:\?' compose.yaml | sed -E 's/^\$\{//; s/:\?$//' | sort -u)
mapfile -t example_keys < <(grep -oE '^LIFE_OS_[A-Z0-9_]+=' .env.example | tr -d =)

# ---------- First setup, without questions ----------
new_case fresh
run LIFE_OS_TIMEZONE=Europe/Berlin -- --yes
ok 'exits 0' test "$status" -eq 0
ok '.env is mode 600' test "$(mode "$case_dir/.env")" = 600
ok 'prints the preview warning' output_has 'Life OS has no login of its own yet'
ok 'version falls back to preview' test "$(value LIFE_OS_VERSION)" = preview
ok 'gateway on loopback' test "$(value LIFE_OS_GATEWAY_BIND_ADDRESS)" = 127.0.0.1
ok 'port 3000' test "$(value LIFE_OS_GATEWAY_PORT)" = 3000
ok 'public URL is the gateway' test "$(value LIFE_OS_PUBLIC_URL)" = http://127.0.0.1:3000
ok 'no public hostname' test -z "$(value LIFE_OS_PUBLIC_HOSTNAME)"
ok 'timezone' test "$(value LIFE_OS_TIMEZONE)" = Europe/Berlin
ok 'currency EUR' test "$(value LIFE_OS_FINANCE_CURRENCY)" = EUR
ok 'backup dir set' test "$(value LIFE_OS_BACKUP_DIR)" = "$case_dir/backups"
ok 'backup dir mode 700' test "$(mode "$case_dir/backups")" = 700
ok 'Codex home set' test "$(value LIFE_OS_CODEX_HOME_HOST_PATH)" = "$case_dir/codex-home"
ok 'Codex home mode 700' test "$(mode "$case_dir/codex-home")" = 700
ok 'runtime UIDs are mine' test "$(value LIFE_OS_CODEX_RUNTIME_UID)$(value LIFE_OS_BACKUP_RUNTIME_UID)$(value LIFE_OS_BANKING_RUNTIME_UID)" = "$uid$uid$uid"
ok 'Docker socket group' test "$(value LIFE_OS_DOCKER_GID)" = "$sock_gid"
ok 'ntfy example host cleared' test -z "$(value LIFE_OS_NTFY_PUBLIC_URL)"
ok 'Whisper guesses the language' test "$(value LIFE_OS_WHISPER_LANGUAGE)" = auto
for key in "${password_keys[@]}"; do
  ok "$key is a new 48-digit hex password" grep -qE "^$key=[0-9a-f]{48}$" "$case_dir/.env"
done
ok 'every password differs' test "$(for key in "${password_keys[@]}"; do value "$key"; done | sort -u | wc -l)" -eq "${#password_keys[@]}"
for key in "${required_keys[@]}"; do
  ok "compose's required $key is set" test -n "$(value "$key")"
done
for key in "${example_keys[@]}"; do
  ok "$key from .env.example is in .env" grep -q "^$key=" "$case_dir/.env"
done
ok 'no template placeholder is left' bash -c "! grep -E '^[A-Z_]+=.*(example\\.com|/absolute/path|replace-with)' '$case_dir/.env'"
ok 'the comments stay' test "$(grep -c '^#' "$case_dir/.env")" -ge "$(grep -c '^#' .env.example)"
ok 'no duplicate keys' no_duplicate_keys
ok 'no secret printed' no_secret_printed
ok 'says what is next' output_has './setup.sh up'
fresh_sum=$(sha256sum <"$case_dir/.env")

# ---------- An existing .env is never overwritten ----------
run LIFE_OS_TIMEZONE=Asia/Tokyo -- --yes
ok 'refuses a second setup' test "$status" -eq 1
ok 'says why' output_has 'already exists'
ok '.env unchanged' test "$(sha256sum <"$case_dir/.env")" = "$fresh_sum"
run -- --yes --skip-checks
ok 'refuses with --skip-checks too' test "$status" -eq 1

# ---------- --force-new keeps a copy and the passwords ----------
old_password=$(value LIFE_OS_POSTGRES_PASSWORD)
old_tasks=$(value LIFE_OS_TASKS_DB_PASSWORD)
run LIFE_OS_TIMEZONE=America/New_York -- --yes --force-new
ok '--force-new exits 0' test "$status" -eq 0
backup=$(find "$case_dir" -maxdepth 1 -name '.env.backup-*' | head -n 1)
ok 'keeps a copy of the old .env' test -n "$backup"
ok 'the copy is mode 600' test "$(mode "$backup")" = 600
ok 'the copy is the old .env' test "$(sha256sum <"$backup")" = "$fresh_sum"
ok 'the copy has the old timezone' grep -qx 'LIFE_OS_TIMEZONE=Europe/Berlin' "$backup"
ok 'new settings' test "$(value LIFE_OS_TIMEZONE)" = America/New_York
ok 'admin password kept' test "$(value LIFE_OS_POSTGRES_PASSWORD)" = "$old_password"
ok 'service password kept' test "$(value LIFE_OS_TASKS_DB_PASSWORD)" = "$old_tasks"
ok 'says what it kept' output_has 'were kept from it'
ok 'no secret printed' no_secret_printed

# ---------- Where the gateway listens ----------
new_case public-bind
run -- --yes --bind 203.0.113.7
ok 'refuses a public address' test "$status" -eq 1
ok 'explains the refusal' output_has 'no login yet'
ok 'writes no .env' test ! -e "$case_dir/.env"
run -- --yes --bind 0.0.0.0
ok 'refuses every address (0.0.0.0)' test "$status" -eq 1
run -- --yes --bind 203.0.113.7 --allow-public-bind
ok 'allows it with --allow-public-bind' test "$status" -eq 0
ok 'with a loud warning' output_has 'It has NO LOGIN'
ok 'sets the address' test "$(value LIFE_OS_GATEWAY_BIND_ADDRESS)" = 203.0.113.7
run -- up --skip-checks
ok 'up refuses a public address without the flag' test "$status" -eq 1
ok 'up starts nothing then' bash -c "! grep -q 'compose up' '$case_dir.log'"

new_case vpn-bind
run -- --yes --bind 10.0.0.1 --port 3100
