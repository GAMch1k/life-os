#!/usr/bin/env bash
set -euo pipefail

# Tests setup.sh (docs/install) without Docker: each case copies setup.sh,
# .env.example, and compose.yaml (without its build sections, like the
# release's install compose) into a scratch directory and runs it there with
# stand-ins for docker and curl on PATH, which only record what they were
# asked. Nothing here talks to Docker, a registry, or the network, so it is
# safe on a server that runs Life OS. With shellcheck on PATH it checks both
# scripts first.
#
#   tools/test-setup

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck setup.sh tools/test-setup
  echo 'shellcheck: setup.sh and tools/test-setup are clean'
elif [[ -n ${CI:-} ]]; then
  echo 'test-setup: shellcheck is required in CI' >&2
  exit 2
else
  echo 'test-setup: shellcheck not found; skipping it' >&2
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/lifeos-test-setup.XXXXXX")
vapid_test=services/notifications/internal/webpush/zz_setup_keys_test.go
identity_test=pkg/identity/zz_setup_keys_test.go
trap 'rm -rf "$work"; rm -f "$vapid_test" "$identity_test"' EXIT
stubs=$work/bin
mkdir -p "$stubs"
touch "$work/docker.sock"

# docker: records each call (with LIFE_OS_VERSION, which update overrides
# for the pull, and LIFE_OS_PROCESSOR_IMAGE when the call sets it), answers
# what setup.sh reads, and fails where a STUB_* variable asks it to. docker
# ps lists STUB_LIFEOS_CONTAINERS, the lifeos project's containers as
# "<working directory>|<service>" lines. Images are files in STUB_IMAGES (the
# case's own): docker pull and docker compose pull add the release images
# with a registry digest that changes with STUB_DIGEST_SEED, docker build
# adds its tag with its labels (and keeps a copy of its build context next
# to the log), and docker image inspect, ls, and rm read them.
cat >"$stubs/docker" <<'EOF'
#!/usr/bin/env bash
printf 'docker %s [LIFE_OS_VERSION=%s]\n' "$*" "${LIFE_OS_VERSION:-}" >>"$STUB_LOG"
[[ -z ${LIFE_OS_PROCESSOR_IMAGE+set} ]] || printf '  with LIFE_OS_PROCESSOR_IMAGE=%s\n' "$LIFE_OS_PROCESSOR_IMAGE" >>"$STUB_LOG"
mkdir -p "$STUB_IMAGES"
image_file() { printf '%s/%s\n' "$STUB_IMAGES" "${1//\//%}"; }
add_release_image() {
  printf 'digest=%s@sha256:%s\n' "${1%:*}" "$(printf '%s %s' "$1" "${STUB_DIGEST_SEED:-1}" | sha256sum | cut -c 1-64)" >"$(image_file "$1")"
}
case $1 in
  info)
    if [[ -n ${STUB_INFO_ERROR:-} ]]; then echo "$STUB_INFO_ERROR" >&2; exit 1; fi
    case $* in
      *ServerVersion*) echo "${STUB_ENGINE:-29.4.3}" ;;
      *DockerRootDir*) echo "${STUB_WORK}" ;;
    esac
    ;;
  compose)
    shift
    [[ $1 != --profile ]] || shift 2
    case $* in
      'version --short') echo "${STUB_COMPOSE:-v5.1.3}" ;;
      'config --images') printf 'ghcr.io/gamch1k/life-os-tasks:preview\nbinwiederhier/ntfy:v2.37.2@sha256:1875ddcf815c8a3c981d6d78c67a93452d0abba79b1ab9520b1f5f5238902bd7\n' ;;
      'ps -q --status running backup') [[ ${STUB_BACKUP_RUNNING:-1} != 1 ]] || echo 3f1c0ffee ;;
      'ps -q --status running dashboard') [[ ${STUB_DASHBOARD_RUNNING:-1} != 1 ]] || echo d45hb0a2d ;;
      'ps --services --status running')
        # shellcheck disable=SC2086 # one service a word
        printf '%s\n' ${STUB_RUNNING:-postgres tasks inbox dashboard gateway voice}
        ;;
      'ps -q processor') : ;;
      'ps --all --format'*) cat "${STUB_PS_FILE:-/dev/null}" ;;
      exec*)
        case $* in
          # calendar-feeds' API from the Dashboard's container (./setup.sh
          # feed): the method and path after the script, the body on stdin
          # (logged as "feeds <method> <path> <body>"); "@@status" with
          # STUB_FEED_STATUS, then the body or STUB_FEEDS_LIST's lines. A
          # Compose warning on stderr first with STUB_COMPOSE_WARNING; no
          # status at all (calendar-feeds unreachable) with STUB_FEEDS_DOWN.
          *'calendar-feeds:8080'*)
            body=$(cat)
            printf 'feeds %s %s %s\n' "$7" "$8" "$body" >>"$STUB_LOG"
            [[ -z ${STUB_COMPOSE_WARNING:-} ]] || echo 'WARN[0000] The "X" variable is not set. Defaulting to a blank string.' >&2
            if [[ -n ${STUB_FEEDS_DOWN:-} ]]; then
              echo 'service "dashboard" is not running' >&2
              exit 1
            fi
            case $7 in
              GET) printf '@@status 200\n%b' "${STUB_FEEDS_LIST:-}" ;;
              DELETE) printf '@@status %s\n' "${STUB_FEED_STATUS:-204}" ;;
              *) printf '@@status %s\n%s\n' "${STUB_FEED_STATUS:-201}" "${STUB_FEED_BODY:-{\}}" ;;
            esac
            ;;
          # The readiness probe in the Dashboard's container: the services
          # named after the script that answer (all but STUB_NOT_READY).
          'exec -T dashboard node -e '*)
            for service in "${@:7}"; do [[ " ${STUB_NOT_READY:-} " == *" $service "* ]] || printf '%s ' "$service"; done
            echo
            ;;
          *'lifeos-auth.mjs setup-code'*)
            [[ -n ${STUB_ACCOUNT:-} ]] || printf 'Setup code: ABCD-EFGH-JKLM-NPQR\nOpen it at /setup.\n'
            ;;
          *'lifeos-auth.mjs'*) printf 'account command: %s\n' "${*:6}"; exit "${STUB_ACCOUNT_EXIT:-0}" ;;
          # A backup: STUB_BACKUP_EXIT fails it; the rotation after a
          # good one removes STUB_ROTATE's paths (runs and images).
          *'backup /service now'*)
            if [[ ${STUB_BACKUP_EXIT:-0} != 0 ]]; then
              echo 'Backup 20261122T130000Z failed in 0.2 s (manual, all databases), 0 B.'
              exit "$STUB_BACKUP_EXIT"
            fi
            for path in ${STUB_ROTATE:-}; do rm -r "$path"; done
            echo 'Backup 20261122T130000Z succeeded in 1.0 s (manual, all databases), 3.5 KiB.'
            ;;
          *) exit "${STUB_BACKUP_EXIT:-0}" ;;
        esac
        ;;
      pull*)
        [[ ${STUB_PULL_EXIT:-0} == 0 ]] || exit "$STUB_PULL_EXIT"
        add_release_image "${LIFE_OS_IMAGE_REGISTRY:-ghcr.io/gamch1k}/life-os-processor:${LIFE_OS_VERSION:-preview}"
        ;;
      *) : ;;
    esac
    ;;
  pull)
    [[ ${STUB_IMAGE_PULL_EXIT:-0} == 0 ]] || exit 1
    add_release_image "${!#}"
    ;;
  build)
    shift
    tag='' context=''
    labels=()
    while (($#)); do
      case $1 in
        --tag) tag=$2 && shift ;;
        --label) labels+=("$2") && shift ;;
        --build-arg) shift ;;
        *) context=$1 ;;
      esac
      shift
    done
    rm -rf "$STUB_LOG.context"
    cp -r "$context" "$STUB_LOG.context"
    [[ ${STUB_BUILD_EXIT:-0} == 0 ]] || exit "$STUB_BUILD_EXIT"
    # A tag built again leaves the earlier image dangling, labels and all.
    [[ ! -f $(image_file "$tag") ]] || mv "$(image_file "$tag")" "$STUB_IMAGES/dangling-$RANDOM"
    printf '%s\n' "${labels[@]}" >"$(image_file "$tag")"
    ;;
  image)
    case $2 in
      inspect)
        file=$(image_file "${!#}")
        [[ -f $file ]] || { echo "Error: No such image: ${!#}" >&2; exit 1; }
        case $* in
          *RepoDigests*) sed -n 's/^digest=//p' "$file" ;;
          *life-os.processor-base*) sed -n 's/^life-os.processor-base=//p' "$file" ;;
          *life-os.claude-code*) sed -n 's/^life-os.claude-code=//p' "$file" ;;
        esac
        ;;
      ls)
        for file in "$STUB_IMAGES"/*; do
          [[ -f $file ]] || continue
          name=${file##*/}
          case $* in
            *dangling=true*) [[ $name != dangling-* ]] || echo "$name" ;;
            *lifeos-processor-claude) [[ $name != lifeos-processor-claude:* ]] || echo "$name" ;;
          esac
        done
        ;;
      rm)
        file=$(image_file "${!#}")
        [[ -f $file && ${STUB_IMAGE_IN_USE:-} != "${!#}" ]] || exit 1
        rm -f "$file"
        ;;
    esac
    ;;
  ps)
    [[ -z ${STUB_PS_ERROR:-} ]] || exit 1
    printf '%b' "${STUB_LIFEOS_CONTAINERS:-}"
    ;;
  # Docker's architecture (docker version --format '{{.Server.Arch}}').
  version) echo "${STUB_DOCKER_ARCH:-amd64}" ;;
  run)
    # ntfy's `user hash`: a bcrypt-shaped hash of what it reads.
    cat >/dev/null
    echo 'password: '
    printf '$2a$10$%s\n' "$(head -c 120 /dev/urandom | base64 -w0 | tr -dc 'A-Za-z0-9' | head -c 53)"
    ;;
esac
EOF

# curl: the Access check (an https:// URL) prints STUB_ACCESS; the gateway
# answers unless STUB_GATEWAY_DOWN is set.
cat >"$stubs/curl" <<'EOF'
#!/usr/bin/env bash
printf 'curl %s\n' "$*" >>"$STUB_LOG"
url=${!#}
case $url in
  https://*) printf '%s' "${STUB_ACCESS:-302 https://team.cloudflareaccess.com/cdn-cgi/access/login/x}" ;;
  *) [[ -z ${STUB_GATEWAY_DOWN:-} ]] || exit 7 ;;
esac
EOF
# openssl: the host's, but with STUB_OPENSSL_FAIL set it makes no Ed25519
# key (the sign-in keys); passwords and the web push key still work.
cat >"$stubs/openssl" <<'EOF'
#!/usr/bin/env bash
[[ -z ${STUB_OPENSSL_FAIL:-} || $1 != genpkey ]] || exit 1
exec /usr/bin/openssl "$@"
EOF
chmod 755 "$stubs/docker" "$stubs/curl" "$stubs/openssl"

# restore-database (./setup.sh restore, LIFE_OS_SETUP_RESTORE_TOOLS): logs
# its arguments, where it works, and the registry; refuses a run that is
# gone, or (inbox_db) an image of it that is gone, as the tool does; fails
# --verify for STUB_VERIFY_FAIL's database and a restore for
# STUB_RESTORE_FAIL's. tools/test-restore-database tests the tool itself.
restore_tools=$work/restore-tools
mkdir -p "$restore_tools"
cat >"$restore_tools/restore-database" <<'EOF'
#!/usr/bin/env bash
printf 'restore-database %s [in %s, registry %s]\n' "$*" "$RESTORE_INSTALL_DIR" "$RESTORE_REGISTRY" >>"$STUB_LOG"
db=$1 run=$2
backups=$(sed -n 's/^LIFE_OS_BACKUP_DIR=//p' "$RESTORE_INSTALL_DIR/.env" | tail -n 1)
[[ -f $backups/auto/$run/manifest.json ]] || { echo "restore-database: there is no run $run in $backups/auto" >&2; exit 2; }
if [[ $3 == --verify ]]; then
  [[ $db != "${STUB_VERIFY_FAIL:-}" ]] || { echo "restore-database: the dump's SHA-256 is 00, the manifest says 11" >&2; exit 2; }
  echo "The dump of $db in run $run matches its manifest."
  exit 0
fi
[[ $db != "${STUB_RESTORE_FAIL:-}" ]] || { echo 'The restored database differs from the manifest:' >&2; exit 1; }
if [[ $db == inbox_db ]]; then
  for hash in $(jq -r '.[].sha256' "$backups/auto/$run/media-inbox.json"); do
    [[ -f $backups/media/${hash:0:2}/$hash ]] || { echo "restore-media: $hash is not in the media store" >&2; exit 1; }
  done
  echo "Restored Inbox images from run $run: copied 1, damaged 0."
fi
echo "Restored $db from run $run."
EOF
cp "$restore_tools/restore-database" "$restore_tools/restore-media"
cp infra/postgres/service-databases.conf "$restore_tools/"

# The install compose: compose.yaml as the release ships it, images only.
sed -E '/^[[:space:]]+build:/d' compose.yaml >"$work/compose.yaml"
# setup.sh as the release ships it, but with its version placeholder.
tools/build-install-bundle --setup-script >"$work/setup.sh"
chmod 755 "$work/setup.sh"

passed=0
failed=0
case_dir=
case_out=

ok() {
  local name=$1
  shift
  if "$@"; then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    printf 'FAIL [%s]: %s\n' "${case_dir##*/}" "$name" >&2
  fi
}

new_case() {
  case_dir=$work/$1
  mkdir -p "$case_dir"
  # setup.sh as a release ships it (the Claude Code build written in; its
  # version placeholder kept), unless the case asks for the repository's.
  cp "$work/setup.sh" "$case_dir/setup.sh"
  [[ ${2:-} != repository ]] || cp setup.sh "$case_dir/setup.sh"
  cp .env.example "$case_dir/"
  cp "$work/compose.yaml" "$case_dir/compose.yaml"
  case_out=$case_dir.out
  : >"$case_out"
  : >"$case_dir.log"
}

# The processors a case runs on (LIFE_OS_SETUP_CPUINFO): with AVX2 (the
# default), without, one setup.sh cannot read flags from, and a Raspberry
# Pi 4's (arm64, Cortex-A72: NEON, no flags line).
printf 'processor\t: 0\nmodel name\t: Test CPU with AVX2\nflags\t\t: fpu sse4_2 avx avx2 fma\n' >"$work/cpuinfo-avx2"
printf 'processor\t: 0\nmodel name\t: Intel(R) Celeron(R) J4125 CPU @ 2.00GHz\nflags\t\t: fpu sse4_2 aes rdrand\n' >"$work/cpuinfo-no-avx2"
printf 'processor\t: 0\n' >"$work/cpuinfo-unknown"
printf 'processor\t: 0\nBogoMIPS\t: 108.00\nFeatures\t: fp asimd evtstrm crc32 cpuid\nCPU implementer\t: 0x41\nCPU architecture: 8\nCPU part\t: 0xd08\n' >"$work/cpuinfo-arm64"

# run [VAR=value...] -- [setup.sh arguments...]: runs ./setup.sh in the case
# directory with a clean environment, stdin from $stdin (default: none).
# Sets status; appends the output to the case's output. With $stdout set to
# a file, the standard output goes there, apart (./setup.sh env --stdout);
# the case's output is then the standard error alone. A PATH among the
# variables replaces the stand-ins' (env -i takes the last).
stdin=/dev/null
stdout=
run() {
  local -a vars=() command=()
  while (($#)) && [[ $1 != -- ]]; do
    vars+=("$1")
    shift
  done
  shift
  command=(env -i HOME="$work/home" PATH="$stubs:/usr/bin:/bin" LANG=C.UTF-8
    STUB_LOG="$case_dir.log" STUB_WORK="$work" STUB_IMAGES="$case_dir.images" DOCKER_HOST="unix://$work/docker.sock"
    LIFE_OS_SETUP_CPUINFO="$work/cpuinfo-avx2" "${vars[@]}" ./setup.sh "$@")
  set +e
  if [[ -n $stdout ]]; then
    (cd "$case_dir" && "${command[@]}" <"$stdin" >"$stdout" 2>"$case_dir.last")
  else
    (cd "$case_dir" && "${command[@]}" <"$stdin" >"$case_dir.last" 2>&1)
  fi
  status=$?
  set -e
  cat "$case_dir.last" >>"$case_out"
}

value() { (cd "$case_dir" && grep -E "^$1=" .env | tail -n 1 | cut -d= -f2-); }
has_profile() { [[ ,$(value COMPOSE_PROFILES), == *",$1,"* ]]; }
has_line() { grep -qxF -- "$1" "$case_dir/.env"; }
output_has() { grep -qF -- "$1" "$case_dir.last"; }
logged() { grep -qF -- "$1" "$case_dir.log"; }
mode() { stat -c %a "$1"; }

# No secret from .env (or the .env file $1) appears in anything the case
# printed.
no_secret_printed() {
  local line key val
  while IFS= read -r line; do
    key=${line%%=*}
    val=${line#*=}
    val=${val#\'}
    val=${val%\'}
    [[ $key =~ (PASSWORD|SECRET|TOKEN|_KEY|_HASH)$ && ${#val} -ge 8 ]] || continue
    if grep -qF -- "$val" "$case_out"; then
      echo "  $key's value was printed" >&2
      return 1
    fi
  done < <(grep -E '^[A-Z_]+=' "${1:-$case_dir/.env}")
}

# Every uncommented key appears once.
no_duplicate_keys() {
  [[ -z $(grep -oE '^[A-Z][A-Z0-9_]*=' "$case_dir/.env" | sort | uniq -d) ]]
}

mkdir -p "$work/home"
uid=$(id -u)
sock_gid=$(stat -c %g "$work/docker.sock")
mapfile -t password_keys < <(sed -n 's/^\(LIFE_OS_[A-Z0-9_]*_PASSWORD\)=.*/\1/p' .env.example)
mapfile -t required_keys < <(grep -oE '\$\{LIFE_OS_[A-Z0-9_]+:\?' compose.yaml | sed -E 's/^\$\{//; s/:\?$//' | sort -u)
mapfile -t example_keys < <(grep -oE '^LIFE_OS_[A-Z0-9_]+=' .env.example | tr -d =)

# ---------- First setup, without questions ----------
new_case fresh
run LIFE_OS_TIMEZONE=Europe/Berlin -- --yes
ok 'exits 0' test "$status" -eq 0
ok '.env is mode 600' test "$(mode "$case_dir/.env")" = 600
ok 'prints the preview warning' output_has 'Life OS has a login, and it is new'
ok 'never says it has no login' bash -c "! grep -qi 'no login' '$case_dir.last'"
ok 'version falls back to preview' test "$(value LIFE_OS_VERSION)" = preview
ok 'gateway on loopback' test "$(value LIFE_OS_GATEWAY_BIND_ADDRESS)" = 127.0.0.1
ok 'port 3000' test "$(value LIFE_OS_GATEWAY_PORT)" = 3000
ok 'public URL is the gateway' test "$(value LIFE_OS_PUBLIC_URL)" = http://127.0.0.1:3000
ok 'no public hostname' test -z "$(value LIFE_OS_PUBLIC_HOSTNAME)"
ok 'timezone' test "$(value LIFE_OS_TIMEZONE)" = Europe/Berlin
ok 'currency EUR' test "$(value LIFE_OS_FINANCE_CURRENCY)" = EUR
ok 'backup dir set' test "$(value LIFE_OS_BACKUP_DIR)" = "$case_dir/backups"
ok 'backup dir mode 700' test "$(mode "$case_dir/backups")" = 700
ok 'Codex home set' test "$(value LIFE_OS_CODEX_HOME_HOST_PATH)" = "$case_dir/codex-home"
ok 'no Codex home until AI processing is on' test ! -e "$case_dir/codex-home"
ok 'the core alone: no module is on' has_line 'COMPOSE_PROFILES='
ok 'the .env lists its modules' test "$(value LIFE_OS_MODULES_LISTED)" = yes
ok 'says the core runs alone' output_has 'the core, and: none'
ok 'runtime UIDs are mine' test "$(value LIFE_OS_CODEX_RUNTIME_UID)$(value LIFE_OS_BACKUP_RUNTIME_UID)$(value LIFE_OS_BANKING_RUNTIME_UID)" = "$uid$uid$uid"
ok 'Docker socket group' test "$(value LIFE_OS_DOCKER_GID)" = "$sock_gid"
ok 'ntfy example host cleared' test -z "$(value LIFE_OS_NTFY_PUBLIC_URL)"
ok 'Whisper guesses the language' test "$(value LIFE_OS_WHISPER_LANGUAGE)" = auto
for key in "${password_keys[@]}"; do
  ok "$key is a new 48-digit hex password" grep -qE "^$key=[0-9a-f]{48}$" "$case_dir/.env"
done
ok 'every password differs' test "$(for key in "${password_keys[@]}"; do value "$key"; done | sort -u | wc -l)" -eq "${#password_keys[@]}"
for key in "${required_keys[@]}"; do
  ok "compose's required $key is set" test -n "$(value "$key")"
done
for key in "${example_keys[@]}"; do
  ok "$key from .env.example is in .env" grep -q "^$key=" "$case_dir/.env"
done
ok 'no template placeholder is left' bash -c "! grep -E '^[A-Z_]+=.*(example\\.com|/absolute/path|replace-with)' '$case_dir/.env'"
ok 'the comments stay' test "$(grep -c '^#' "$case_dir/.env")" -ge "$(grep -c '^#' .env.example)"
ok 'no duplicate keys' no_duplicate_keys
ok 'no secret printed' no_secret_printed
ok 'says what is next' output_has './setup.sh up'
fresh_sum=$(sha256sum <"$case_dir/.env")

# ---------- An existing .env is never overwritten ----------
run LIFE_OS_TIMEZONE=Asia/Tokyo -- --yes
ok 'refuses a second setup' test "$status" -eq 1
ok 'says why' output_has 'already exists'
ok '.env unchanged' test "$(sha256sum <"$case_dir/.env")" = "$fresh_sum"
run -- --yes --skip-checks
ok 'refuses with --skip-checks too' test "$status" -eq 1

# ---------- --force-new keeps a copy and the passwords ----------
old_password=$(value LIFE_OS_POSTGRES_PASSWORD)
old_tasks=$(value LIFE_OS_TASKS_DB_PASSWORD)
run LIFE_OS_TIMEZONE=America/New_York -- --yes --force-new
ok '--force-new exits 0' test "$status" -eq 0
backup=$(find "$case_dir" -maxdepth 1 -name '.env.backup-*' | head -n 1)
ok 'keeps a copy of the old .env' test -n "$backup"
ok 'the copy is mode 600' test "$(mode "$backup")" = 600
ok 'the copy is the old .env' test "$(sha256sum <"$backup")" = "$fresh_sum"
ok 'the copy has the old timezone' grep -qx 'LIFE_OS_TIMEZONE=Europe/Berlin' "$backup"
ok 'new settings' test "$(value LIFE_OS_TIMEZONE)" = America/New_York
ok 'admin password kept' test "$(value LIFE_OS_POSTGRES_PASSWORD)" = "$old_password"
ok 'service password kept' test "$(value LIFE_OS_TASKS_DB_PASSWORD)" = "$old_tasks"
ok 'says what it kept' output_has 'were kept from it'
ok 'no secret printed' no_secret_printed

# No key from openssl: the first setup stops before it writes a .env with an
# empty signing key.
new_case no-openssl
run STUB_OPENSSL_FAIL=1 LIFE_OS_TIMEZONE=UTC -- --yes
ok 'a first setup without a signing key stops' test "$status" -eq 1
ok 'and says why' output_has 'could not make'
ok 'and writes no .env' test ! -e "$case_dir/.env"

# ---------- Where the gateway listens ----------
new_case public-bind
run -- --yes --bind 203.0.113.7
ok 'refuses a public address' test "$status" -eq 1
ok 'explains the refusal' output_has 'refuses to listen there'
ok 'writes no .env' test ! -e "$case_dir/.env"
run -- --yes --bind 0.0.0.0
ok 'refuses every address (0.0.0.0)' test "$status" -eq 1
run -- --yes --bind 203.0.113.7 --allow-public-bind
ok 'allows it with --allow-public-bind' test "$status" -eq 0
ok 'with a loud warning' output_has 'over PLAIN HTTP'
ok 'sets the address' test "$(value LIFE_OS_GATEWAY_BIND_ADDRESS)" = 203.0.113.7
run -- up --skip-checks
ok 'up refuses a public address without the flag' test "$status" -eq 1
ok 'up starts nothing then' bash -c "! grep -q 'compose up' '$case_dir.log'"

new_case vpn-bind
run -- --yes --bind 10.0.0.1 --port 3100
ok 'a VPN address works' test "$status" -eq 0
ok 'warns that legacy access makes every peer the owner' output_has 'they act as the owner without signing in'
ok 'the address follows' test "$(value LIFE_OS_PUBLIC_URL)" = http://10.0.0.1:3100
ok 'the port' test "$(value LIFE_OS_GATEWAY_PORT)" = 3100
# Signing in over plain HTTP there: explained, and off unless allowed.
ok 'says the password crosses the network unencrypted' output_has 'sends your password and session across that network unencrypted'
ok 'and that HTTPS is better' output_has 'HTTPS is better: tailscale serve, or a reverse proxy'
ok 'without questions, plain-HTTP sign-in stays off' has_line 'LIFE_OS_INSECURE_LOGIN_HOSTS='
ok 'and says how to allow it' output_has './setup.sh gateway --allow-http-login'
run LIFE_OS_GOOGLE_CLIENT_ID=1-x.apps.googleusercontent.com LIFE_OS_GOOGLE_CLIENT_SECRET=GOCSPX-abc -- --yes google
ok "warns that Google refuses a plain http VPN address" output_has 'only on 127.0.0.1 or localhost'
run -- --yes gateway --allow-http-login
ok 'gateway --allow-http-login' test "$status" -eq 0
ok 'allows the VPN address' has_line 'LIFE_OS_INSECURE_LOGIN_HOSTS=10.0.0.1'
ok 'and says so' output_has 'Signing in over plain HTTP is allowed at 10.0.0.1'
run -- --yes gateway --allow-http-login
ok 'twice: listed once' has_line 'LIFE_OS_INSECURE_LOGIN_HOSTS=10.0.0.1'
ok 'and not offered again' bash -c "! grep -q 'unencrypted' '$case_dir.last'"
run LIFE_OS_SETUP_WAIT_SECONDS=1 -- up --skip-checks
