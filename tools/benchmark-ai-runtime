  [ -n "$sophie_due" ] && sophie_hour=$((10#$(TZ=$zone date -d "$sophie_due" +%H)))
  day=$(date -u -d "$(captured_day "${ids[followup_task_first]}") + 1 day" +%F)
  check followup_task "$([ "$s" = resolved ] && [ -n "$sophie_due" ] && [ "$(TZ=$zone date -d "$sophie_due" +%F)" = "$day" ] && [ "$sophie_hour" -ge 6 ] && [ "$sophie_hour" -le 12 ] && [ "$(follows followup_task followup_task_first)" -ge 1 ] && echo 1 || echo 0)" "state=$s tasks=$(jq -c 'map({title, dueAt})' <<<"$sophie") want=$day morning linked=$(follows followup_task followup_task_first)"
  # followup_unrelated: the gym Task stays as it was (no due date, open);
  # the dry cleaning is a Task of its own, not linked to the gym capture.
  s=$(state "${ids[followup_unrelated]}")
  local gym
  gym=$(api "$gateway/api/tasks/v1/tasks?query=gym&limit=100" | jq -c '[.items[] | select(.title | test("gym"; "i"))]')
  check followup_unrelated "$([ "$s" = resolved ] && [ "$(state "${ids[followup_unrelated_first]}")" = resolved ] && [ "$(jq 'length' <<<"$gym")" = 1 ] && [ "$(jq -r '.[0].dueAt // "none"' <<<"$gym")" = none ] && [ "$(jq -r '.[0].completed' <<<"$gym")" = false ] && [ "$(tasks_matching "dry clean")" = 1 ] && [ "$(follows followup_unrelated followup_unrelated_first)" = 0 ] && echo 1 || echo 0)" "state=$s gym=$(jq -c 'map({title, dueAt, completed})' <<<"$gym") dry_cleaning_tasks=$(tasks_matching "dry clean") linked=$(follows followup_unrelated followup_unrelated_first)"
  # The seeded bananas plus milk, eggs, bread, cheese, toothpaste, shower
  # gel, minced meat, tomatoes, the staple butter, and the oat milk, each
  # once; the yoghurt and the seeded spaghetti and rice in the pantry; the
  # seeded butter and the new coffee as staples; Wednesday's dinner,
  # Friday's lunch, and the Saturday breakfasts but the one cleared.
  check no_extra_shopping_items "$([ "$(jq '.items | length' <<<"$list")" = 11 ] && [ "$(jq '[.items[].normalizedName] | unique | length' <<<"$list")" = 11 ] && echo 1 || echo 0)" "items=$(jq -c '[.items[] | {name, amount, storeName, state}]' <<<"$list") (expected 11)"
  check no_extra_pantry_items "$([ "$(jq '.items | length' <<<"$pantry")" = 4 ] && echo 1 || echo 0)" "items=$(jq -c '[.items[] | {name, location, expiresOn}]' <<<"$pantry") (expected 4)"
  check no_extra_staples "$([ "$(jq '.items | length' <<<"$staples")" = 2 ] && echo 1 || echo 0)" "staples=$(jq -c '[.items[].name]' <<<"$staples") (expected 2)"
  # Recipe links: a page's recipe, and a post's from its caption, each saved
  # once with the link as its source; the seeded recipe and these two only.
  local recipes
  recipes=$(api "$gateway/api/food/v1/recipes?limit=200")
  imported() { # imported <title word> <link> <ingredients>: recipes so saved
    jq --arg word "$1" --arg link "$2" --argjson n "$3" '[.items[] | select((.normalizedTitle | contains($word)) and .sourceUrl == $link and (.ingredients | length) == $n)] | length' <<<"$recipes"
  }
  s=$(state "${ids[recipe_link_structured]}")
  check recipe_link_structured "$([ "$s" = resolved ] && [ "$(imported rindergulasch http://ics-fixture/gulasch.html 3)" = 1 ] && echo 1 || echo 0)" "state=$s recipes=$(jq -c '[.items[] | {title, sourceUrl, ingredients: (.ingredients | length)}]' <<<"$recipes")"
  s=$(state "${ids[recipe_caption]}")
  check recipe_caption "$([ "$s" = resolved ] && [ "$(imported shakshuka http://ics-fixture/reel-DGx7abc.html 4)" = 1 ] && echo 1 || echo 0)" "state=$s"
  # Recipes by the owner's words (P15-12). The reel sent to the Tasks: one
  # Task with the link in its notes, and no recipe from it.
  local reel_tasks
  reel_tasks=$(api "$gateway/api/tasks/v1/tasks?query=DPbench01&limit=100" | jq -c '[.items[] | select((.notes // "") | contains("instagram.com/reel/DPbench01"))]')
  from_reel() { jq --arg id "$1" '[.items[] | select((.sourceUrl // "") | contains($id))] | length' <<<"$recipes"; }
  s=$(state "${ids[recipe_reel_task]}")
  check recipe_reel_task "$([ "$s" = resolved ] && [ "$(jq 'length' <<<"$reel_tasks")" = 1 ] && [ "$(from_reel DPbench01)" = 0 ] && echo 1 || echo 0)" "state=$s tasks=$(jq -c 'map({title, notes, dueAt})' <<<"$reel_tasks") recipes_from_reel=$(from_reel DPbench01)"
  # The dish named with the reel: a stub "Брауни" with the link, to review,
  # never titled "Instagram".
  local stubs
  stubs=$(jq -c '[.items[] | select(.sourceUrl == "http://ics-fixture/reel-brownie.html")]' <<<"$recipes")
  s=$(state "${ids[recipe_named_reel]}")
  check recipe_named_reel "$([ "$s" = resolved ] && [ "$(jq '[.[] | select(.normalizedTitle == "брауни" and (.tags | index("to-review")))] | length' <<<"$stubs")" = 1 ] && [ "$(jq 'length' <<<"$stubs")" = 1 ] && echo 1 || echo 0)" "state=$s stubs=$(jq -c 'map({title, tags})' <<<"$stubs")"
  # The bare reel: Human Review, nothing saved.
  s=$(state "${ids[recipe_bare_reel]}")
  check recipe_bare_reel "$([ "$s" = human_review ] && [ "$(from_reel DPbench03)" = 0 ] && echo 1 || echo 0)" "state=$s reason=\"$(item "${ids[recipe_bare_reel]}" | jq -r '.processingMetadata.humanReview.errorSummary // ""')\" recipes_from_reel=$(from_reel DPbench03)"
  # The dictated recipe: one recipe by the AI, to review, without a link,
  # with its ingredients and steps as Codex built them.
  local dictated
  dictated=$(jq -c '[.items[] | select((.normalizedTitle | test("chicken|куриц|h(ä|a)hnchen")) and (.tags | index("to-review")))]' <<<"$recipes")
  s=$(state "${ids[recipe_dictated]}")
  check recipe_dictated "$([ "$s" = resolved ] && [ "$(jq '[.[] | select(.sourceUrl == null and (.ingredients | length) >= 3 and ((.steps // "") | length) > 0 and .createdBy.kind == "agent" and .createdBy.name == "codex-inbox-processor")] | length' <<<"$dictated")" = 1 ] && [ "$(jq 'length' <<<"$dictated")" = 1 ] && echo 1 || echo 0)" "state=$s recipes=$(jq -c 'map({title, tags, sourceUrl, ingredients: [.ingredients[] | (.amount // "") + " " + .name], steps})' <<<"$dictated")"
  # Recipe ideas: 1 to 3 from the job, none with the disliked mushrooms, one
  # at least with the chicken that expires tomorrow (the words vary, so the
  # checks are structural).
  local ideas count
  ideas=$(api "$gateway/api/food/v1/ideas?state=new&limit=100" | jq -c '[.items[] | select(.createdBy.kind == "agent" and .createdBy.name == "codex-recipe-ideas")]')
  count=$(jq 'length' <<<"$ideas")
  check ideas_run "$([ "$(jq -r '.lastRun.outcome // ""' <<<"$ideas_job")" = created ] && [ "$count" -ge 1 ] && [ "$count" -le 3 ] && echo 1 || echo 0)" "run=$(jq -c '.lastRun' <<<"$ideas_job") ideas=$(jq -c 'map({title, methods, ingredients: [.ingredients[].name]})' <<<"$ideas")"
  check ideas_no_dislike "$([ "$count" -ge 1 ] && [ "$(jq '[.[] | select((.title | test("pilz|mushroom|гриб"; "i")) or any(.ingredients[]; .name | test("pilz|mushroom|гриб"; "i")))] | length' <<<"$ideas")" = 0 ] && echo 1 || echo 0)" "ideas=$count"
  check ideas_expiring "$([ "$(jq '[.[] | select(any(.ingredients[]; .name | test("h(ä|a)hnchen"; "i")))] | length' <<<"$ideas")" -ge 1 ] && echo 1 || echo 0)" "ideas=$count"
  # The air fryer is the first preferred method: at least 2 ideas use it.
  check ideas_air_fryer "$([ "$(jq '[.[] | select(.methods | index("air_fryer"))] | length' <<<"$ideas")" -ge 2 ] && echo 1 || echo 0)" "methods=$(jq -c 'map(.methods)' <<<"$ideas") run=$(jq -c '.lastRun | {withFirstMethod, fromWeb}' <<<"$ideas_job")"
  # AI categories: the restaurant in Eating out, the hosting bill in
  # Subscriptions or Utilities & phone (both fit), both marked as the AI's;
  # the bare transfer to a person left alone.
  local categories
  categories=$(api "$gateway/api/finance/v1/categories")
  ai_txn() { # ai_txn <id>: the transaction with its category's system key
    api "$gateway/api/finance/v1/transactions/$1" | jq -c --argjson categories "$categories" \
      '. as $t | {counterparty, categorizedBy, category: ([$categories.items[] | select(.id == $t.categoryId) | .systemKey][0] // null)}'
  }
  local got
  got=$(ai_txn "$restaurant")
  check ai_restaurant "$(jq -e '.categorizedBy == "ai" and .category == "eating_out"' <<<"$got" >/dev/null && echo 1 || echo 0)" "$got"
  got=$(ai_txn "$hosting")
  check ai_hosting "$(jq -e '.categorizedBy == "ai" and (.category == "subscriptions" or .category == "utilities")' <<<"$got" >/dev/null && echo 1 || echo 0)" "$got"
  got=$(ai_txn "$ambiguous")
  check ai_ambiguous_left "$(jq -e '.category == null and .categorizedBy == null' <<<"$got" >/dev/null && echo 1 || echo 0)" "$got"
  # AI budget plan: ready, so Finance's checks passed (a line for every
  # category with history, amounts of 0 or more, savings within the spending
  # they come from, totals that add up), with 2 to 5 ways to spend less and
  # the rent kept; at least one way is in the benchmark's eating out (P13-09).
  check budget_plan_valid "$(jq -e --arg rent "$plan_rent" '.state == "ready" and (.result.suggestions | length) >= 2 and (.result.suggestions | length) <= 5 and any(.result.lines[]; .categoryId == $rent and .proposed.amount > 0)' <<<"$budget_plan" >/dev/null && echo 1 || echo 0)" "state=$(jq -r '.state // "missing"' <<<"$budget_plan") attempts=$(jq -r '.attempts // ""' <<<"$budget_plan") error=\"$(jq -r '.error // ""' <<<"$budget_plan")\" headline=\"$(jq -r '.result.headline // ""' <<<"$budget_plan")\" total=$(jq -r '.result.projectedTotal.amount // ""' <<<"$budget_plan")"
  check budget_plan_eating_out "$(jq -e --arg eating "$plan_eating" '[.result.suggestions[]? | select(.categoryId == $eating and .monthlySaving.amount > 0)] | length >= 1' <<<"$budget_plan" >/dev/null && echo 1 || echo 0)" "suggestions=$(jq -c '[.result.suggestions[]? | {title, category: .categoryName, merchants, saving: .monthlySaving.amount}]' <<<"$budget_plan")"
  # The seeded recipe and the two imports; the stub and the dictated recipe
  # are the only ones to review.
  check no_extra_recipes "$([ "$(jq '[.items[] | select(.tags | index("to-review") | not)] | length' <<<"$recipes")" = 3 ] && echo 1 || echo 0)" "recipes=$(jq -c '[.items[] | select(.tags | index("to-review") | not) | .title]' <<<"$recipes") (expected 3)"
  check no_extra_review_recipes "$([ "$(jq '[.items[] | select(.tags | index("to-review"))] | length' <<<"$recipes")" = 2 ] && echo 1 || echo 0)" "recipes=$(jq -c '[.items[] | select(.tags | index("to-review")) | .title]' <<<"$recipes") (expected 2)"
  check no_extra_meals "$([ "$(jq '.items | length' <<<"$plan")" = $((1 + ${#saturdays[@]})) ] && echo 1 || echo 0)" "meals=$(jq -c '[.items[] | {date, slot, title}]' <<<"$plan") (expected $((1 + ${#saturdays[@]})))"
  # No fallback or invented entities: thirteen seeds plus three creates,
  # the flash drive, the call to the plumber, the Finanzamt letter, and the
  # follow-ups' Sophie, gym, and dry cleaning; the reel's Task is checked
  # on its own (recipe_reel_task).
  local total
  total=$(api "$gateway/api/tasks/v1/tasks?limit=100" | jq '[.items[] | select((.notes // "") | contains("DPbench01") | not)] | length')
  check no_extra_tasks "$([ "$total" = 22 ] && echo 1 || echo 0)" "tasks=$total (expected 22): $(api "$gateway/api/tasks/v1/tasks?limit=100" | jq -c '[.items[].title]')"
  # Five seeded events plus the dentist and the coffee created, none cancelled.
  local all
  all=$(api "$gateway/api/calendar/v1/events?from=2026-01-01T00:00:00Z&to=$(date -u -d '+60 days' +%Y-%m-%dT%H:%M:%SZ)&includeCancelled=true&limit=100")
  check no_extra_events "$([ "$(jq '.items | length' <<<"$all")" = 7 ] && [ "$(jq '[.items[] | select(.status != "active")] | length' <<<"$all")" = 0 ] && echo 1 || echo 0)" "events=$(jq -c '[.items[] | {title, status}]' <<<"$all") (expected 7 active)"

  # Codex's own usage and the processing time of each planning run.
  local status runtime
  status=$("${compose[@]}" exec -T processor wget -q -O - http://127.0.0.1:8081/status)
  runtime=$(jq -c '{model, reasoningEffort, runs: .runtime.tokens.runs, input: .runtime.tokens.input, cachedInput: .runtime.tokens.cachedInput, output: .runtime.tokens.output, reasoning: .runtime.tokens.reasoning, completed: .runtime.completed, failed: .runtime.failed}' <<<"$status")
  local seconds=0 n=0
  for key in "${!ids[@]}"; do
    while read -r started completed; do
      [ -n "$started" ] && [ -n "$completed" ] || continue
      seconds=$((seconds + $(date -d "$completed" +%s) - $(date -d "$started" +%s)))
      n=$((n + 1))
    done < <(api "$gateway/api/inbox/v1/inbox-items/${ids[$key]}/processing-attempts" | jq -r '.items[] | "\(.startedAt // "") \(.completedAt // "")"')
  done
  local passed failed
  passed=$(grep -c $'\tPASS\t' "$results" || true)
  failed=$(grep -c $'\tFAIL\t' "$results" || true)
  printf '%s\tpassed=%s\tfailed=%s\tattempts=%s\tavg_attempt_s=%s\t%s\n' "$profile" "$passed" "$failed" "$n" "$((n > 0 ? seconds / n : 0))" "$runtime" | tee -a "$out/summary.tsv"
  column -t -s $'\t' "$results" | sed 's/^/   /'
}

for profile in "$@"; do run_profile "$profile"; done
echo
echo "results: $out"
