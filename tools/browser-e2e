#!/usr/bin/env bash
set -euo pipefail

# The browser suite (apps/dashboard/e2e) on the disposable verification stack.
# Arguments go to Playwright: tools/browser-e2e e2e/food.spec.ts, or, without
# a Codex sign-in as in CI, tools/browser-e2e --grep-invert @codex. The stack
# runs the modules tools/verify-compose picks (LIFE_OS_VERIFY_MODULES; empty:
# the core alone), and the tests of modules that are off skip themselves.

compose=(./tools/verify-compose)
# The Calendar feed tests serve their own ICS files from a fixture container
# (verify-only overlay; never used for the deployed stack).
ics_dir=$(mktemp -d)
chmod 755 "$ics_dir"
export LIFE_OS_E2E_ICS_DIR=$ics_dir
export LIFE_OS_VERIFY_OVERLAYS=${LIFE_OS_VERIFY_OVERLAYS:+$LIFE_OS_VERIFY_OVERLAYS:}tools/fixtures/calendar-ics.compose.yaml
# The Android download tests read a made-up release, published into a
# releases directory of this run's own, which tools/verify-compose mounts
# into the gateway (never the owner's).
android_dir=$(mktemp -d)
install -d -m 755 "$android_dir/releases"
tools/fixtures/android-release "$android_dir/release" 0.1.0 1
LIFE_OS_ANDROID_RELEASES_DIR="$android_dir/releases" tools/publish-android-release "$android_dir/release" --notes 'Browser test release' >/dev/null
export LIFE_OS_VERIFY_ANDROID_RELEASES_DIR="$android_dir/releases" LIFE_OS_E2E_ANDROID_RELEASE=1
cleanup() { "${compose[@]}" down --volumes --remove-orphans >/dev/null; rm -rf "$ics_dir" "$android_dir"; }
trap cleanup EXIT
# The verification overlay deliberately uses immutable local image names. Build
# the dashboard first so this browser test always exercises the current branch,
# rather than whichever dashboard image was built by a prior ticket.
docker compose build --pull dashboard
"${compose[@]}" up --detach --no-build
# The modules the stack runs, as its Dashboard has them.
LIFE_OS_E2E_MODULES=$("${compose[@]}" config --format json | jq -r '.services.dashboard.environment.LIFE_OS_MODULES // ""')
export LIFE_OS_E2E_MODULES
echo "browser-e2e: optional modules on: ${LIFE_OS_E2E_MODULES:-none (the core alone)}"
# The Finance specs create their own accounts through the API.
LIFE_OS_E2E_URL=http://127.0.0.1:13001 npm --prefix apps/dashboard run test:e2e -- "$@"
