#!/usr/bin/env bash
set -euo pipefail

# Checks the gateway's sign-in (infra/nginx/life-os.conf.template;
# docs/architecture/multi-user.md#the-gateway) in throwaway containers, never
# the deployed gateway or the verification stack: the gateway's nginx with
# its configuration rendered as compose.yaml has it rendered (made-up hosts),
# a stand-in Dashboard whose auth check answers by a made-up cookie
# (lifeos=good: 204 with an identity token naming the original method and
# URI; forbidden: 403 forbidden_origin; odd: 403 with a reason the
# gateway does not know; boom: 500; none: 401) or bearer (Authorization:
# Bearer good-key: 204; device-key: 403 credential_not_allowed; any other:
# 401, for /api/mcp/ with MCP's challenge),
# and one stand-in for every service that echoes what reached it, on a
# network of their own. It checks:
#  - every service location asks the auth check, and its refusals are JSON
#    (401 unauthenticated, 403 with the check's reason from a fixed list,
#    such as credential_not_allowed or forbidden_origin, 503
#    auth_unavailable when the check fails), while the gateway's own 403
#    (the tunnel without Access's token) is plain forbidden;
#  - a service gets the check's identity token, never a client's copy, nor
#    the cookie or an Authorization header;
#  - the public routes (the login, Better Auth's /api/auth/, the app's
#    files) and the Dashboard's own locations reach the Dashboard without
#    the check, with the cookie; a client's X-Life-OS-Identity never does;
#  - /internal/ is 404 from outside, the check included;
#  - /android/ needs a sign-in; its page sends a browser to the login;
#  - a device key or token (Authorization: Bearer) reaches the check, which
#    decides, and never a service; MCP's 401 carries the check's
#    WWW-Authenticate (P21-06); the OAuth metadata and the phone's pairing
#    reach the Dashboard without the check;
#  - every service location tells the check its route (X-Life-OS-Route),
#    and a client's copy never passes;
#  - a path with an encoded slash, backslash, or dot, a backslash, or a dot
#    segment is 400 forbidden_path before any location, whatever the
#    credential, and neither the Dashboard nor a service ever gets it (their
#    logs); encoded URLs in a query string pass as before;
#  - the security headers: a content security policy for frames, <base>,
#    plugins, and forms, X-Frame-Options DENY, and HSTS over HTTPS only
#    (through Cloudflare; a client's own X-Forwarded-Proto is not believed);
#  - LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS: on (empty), the tunnel path needs
#    Access's token, as before; off, Life OS's sign-in alone decides.
#
#   tools/test-gateway-auth

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
command -v docker >/dev/null 2>&1 || { echo 'test-gateway-auth: docker is required' >&2; exit 2; }
image=$(sed -n 's/^FROM //p' infra/nginx/Dockerfile | head -n 1)
[[ -n "$image" ]] || { echo "test-gateway-auth: no base image in infra/nginx/Dockerfile" >&2; exit 2; }
name=lifeos-verify-gwauth-$$
work=$(mktemp -d)
cleanup() {
  docker rm -f "$name-gateway" "$name-access-on" "$name-access-off" "$name-dashboard" "$name-services" >/dev/null 2>&1 || true
  docker network rm "$name" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT
fail() {
  printf 'test-gateway-auth: %s\n' "$*" >&2
  exit 1
}

nginx_dir=$repo_root/infra/nginx
template=$nginx_dir/life-os.conf.template
gateway_args=(-e NGINX_ENTRYPOINT_QUIET_LOGS=1 -e NGINX_ENVSUBST_FILTER=^LIFE_OS_
  -e LIFE_OS_PUBLIC_HOSTNAME=lifeos.example.com -e LIFE_OS_GATEWAY_BIND_ADDRESS=127.0.0.1
  -e "LIFE_OS_BACKEND_NETWORK=$name"
  -v "$nginx_dir/server-names.envsh:/docker-entrypoint.d/16-lifeos-server-names.envsh:ro"
  -v "$nginx_dir/modules.envsh:/docker-entrypoint.d/17-lifeos-modules.envsh:ro"
  -v "$nginx_dir/trusted-proxies.envsh:/docker-entrypoint.d/15-lifeos-trusted-proxies.envsh:ro"
  -v "$nginx_dir/module-routes:/etc/nginx/lifeos/module-routes:ro")

# The service locations, from the template: every one that proxies to an
# upstream other than the Dashboard.
mapfile -t service_paths < <(awk '
  /^  location / { path = $2; if (path == "=" || path == "^~") path = $3 }
  /set \$upstream [a-z-]+:[0-9]+;/ && $3 !~ /^dashboard:/ && path != "" { print path }
' "$template" | sort -u)
((${#service_paths[@]} >= 10)) || fail "found only ${#service_paths[@]} service locations in the template"
# shellcheck disable=SC2016 # nginx variables, not the shell's
mapfile -t services < <(sed -n 's/^ *set \$upstream \([a-z-]*\):8080;$/\1/p' "$template" | sort -u)

# A releases directory for /android/.
releases=$work/android
install -d -m 755 "$releases"
printf '<!doctype html><title>Android</title>\n' >"$releases/index.html"
printf '{"apps":{}}\n' >"$releases/updates.json"
chmod 644 "$releases"/*

# The stand-in Dashboard: the auth check, and everything else echoed.
cat >"$work/dashboard.conf" <<'EOF'
server {
  listen 3000;
  default_type text/plain;
  location = /internal/auth/check {
    if ($http_authorization = "Bearer good-key") {
      add_header X-Life-OS-Identity "key:$http_x_original_method:$http_x_original_uri:route=$http_x_life_os_route" always;
      return 204;
    }
    if ($http_authorization = "Bearer device-key") {
      add_header X-Life-OS-Auth-Error credential_not_allowed always;
      return 403;
    }
    set $challenge "";
    if ($http_x_original_uri ~ "^/api/mcp/") {
      set $challenge 'Bearer resource_metadata="https://lifeos.example.com/.well-known/oauth-protected-resource/api/mcp"';
    }
    if ($http_authorization ~ "^Bearer ") {
      add_header WWW-Authenticate $challenge always;
      return 401;
    }
    if ($http_cookie ~ "lifeos=good") {
      add_header X-Life-OS-Identity "ok:$http_x_original_method:$http_x_original_uri:$http_x_real_ip:route=$http_x_life_os_route" always;
      return 204;
    }
    if ($http_cookie ~ "lifeos=forbidden") {
      add_header X-Life-OS-Auth-Error forbidden_origin always;
      return 403;
    }
    if ($http_cookie ~ "lifeos=odd") {
      add_header X-Life-OS-Auth-Error 'x","code":"admin' always;
      return 403;
    }
    if ($http_cookie ~ "lifeos=boom") { return 500; }
    add_header WWW-Authenticate $challenge always;
    return 401;
  }
  location / {
    return 200 "dashboard identity=[$http_x_life_os_identity] cookie=[$http_cookie] authorization=[$http_authorization]\n";
  }
}
EOF
# Every service: what reached it.
cat >"$work/services.conf" <<'EOF'
server {
  listen 8080;
  default_type text/plain;
  location / {
    return 200 "service $request_method $request_uri identity=[$http_x_life_os_identity] cookie=[$http_cookie] authorization=[$http_authorization]\n";
  }
}
EOF
chmod 644 "$work"/*.conf

docker network create "$name" >/dev/null
docker run -d --rm --name "$name-dashboard" --network "$name" --network-alias dashboard \
  -v "$work/dashboard.conf:/etc/nginx/conf.d/default.conf:ro" "$image" >/dev/null
aliases=()
for service in "${services[@]}"; do aliases+=(--network-alias "$service"); done
docker run -d --rm --name "$name-services" --network "$name" "${aliases[@]}" \
  -v "$work/services.conf:/etc/nginx/conf.d/default.conf:ro" "$image" >/dev/null

start() { # <container> <template> <LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS>: base URL in $base
  docker run --rm "${gateway_args[@]}" -e LIFE_OS_MODULES="$(cut -d ' ' -f 1 "$nginx_dir/module-routes" | grep -v '^#' | sort -u | paste -sd, -)" \
    -e LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS="$3" -v "$2:/etc/nginx/templates/default.conf.template:ro" \
    "$image" nginx -t -q || fail "nginx -t failed for $1"
  docker run -d --rm --name "$1" --network "$name" -p 127.0.0.1::80 "${gateway_args[@]}" \
    -e LIFE_OS_MODULES="$(cut -d ' ' -f 1 "$nginx_dir/module-routes" | grep -v '^#' | sort -u | paste -sd, -)" \
    -e LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS="$3" -v "$2:/etc/nginx/templates/default.conf.template:ro" \
    -v "$releases:/srv/android:ro" "$image" >/dev/null
  base="http://127.0.0.1:$(docker port "$1" 80/tcp | head -n 1 | sed 's/.*://')"
  for _ in $(seq 1 40); do
    curl --silent --output /dev/null "$base/login" && return
    sleep 0.25
  done
  docker logs "$1" >&2
  fail "the gateway in $1 did not start"
}
request() { # <method> <path> [curl options…]: status in $code, body in $body, headers in $work/headers
  local method=$1 path=$2
  shift 2
  code=$(curl --silent --path-as-is --max-time 15 --request "$method" --output "$work/body" \
    --dump-header "$work/headers" --write-out '%{http_code}' "$@" "$base$path")
  body=$(<"$work/body")
}
expect() { # <method> <path> <status> [curl options…]
  local method=$1 path=$2 want=$3
  shift 3
  request "$method" "$path" "$@"
  [[ "$code" == "$want" ]] || { cat "$work/headers" "$work/body" >&2; fail "$method $path $*: $code, want $want"; }
}
expect_body() { # <text>
  grep -qF -- "$1" <<<"$body" || { printf '%s\n' "$body" >&2; fail "the answer lacks: $1"; }
}
refuse_body() { # <text>
  ! grep -qF -- "$1" <<<"$body" || { printf '%s\n' "$body" >&2; fail "the answer has: $1"; }
}

start "$name-gateway" "$template" ''

printf '==> Every service location asks the auth check (%d)\n' "${#service_paths[@]}"
for path in "${service_paths[@]}"; do
  expect GET "${path}v1/x" 401
  expect_body '"code":"unauthenticated"'
  expect GET "${path}v1/x" 200 --cookie 'lifeos=good' -H 'X-Life-OS-Route: forged'
  expect_body "identity=[ok:GET:${path}v1/x:"
  # Every service location names its route for the check, never a client.
  grep -q 'route=[a-z]' <<<"$body" || { printf '%s\n' "$body" >&2; fail "${path} names no route for the check"; }
  refuse_body 'route=forged'
  expect_body 'cookie=[]'
  expect_body 'authorization=[]'
  expect GET "${path}v1/x" 403 --cookie 'lifeos=forbidden'
  expect_body '"code":"forbidden_origin"'
  expect GET "${path}v1/x" 403 -H 'Authorization: Bearer device-key'
  expect_body '"code":"credential_not_allowed"'
  # A reason the gateway does not know is never echoed.
  expect GET "${path}v1/x" 403 --cookie 'lifeos=odd'
  expect_body '{"error":{"code":"forbidden",'
  refuse_body admin
  expect GET "${path}v1/x" 503 --cookie 'lifeos=boom'
  expect_body '"code":"auth_unavailable"'
done

printf '==> A client cannot pass an identity, a cookie, or a credential to a service\n'
# (Basic: a proxy's own credential, which Life OS ignores; Bearer is a
# Life OS credential, below.)
expect POST /api/tasks/v1/tasks 200 --cookie 'lifeos=good; other=1' \
  -H 'X-Life-OS-Identity: forged' -H 'Authorization: Basic YWJjOmRlZg==' --data '{}'
expect_body 'identity=[ok:POST:/api/tasks/v1/tasks:'
refuse_body forged
expect_body 'cookie=[]'
expect_body 'authorization=[]'
expect GET /api/tasks/v1/tasks 401 -H 'X-Life-OS-Identity: forged'

printf '==> A device key or token: the check decides, and a service never sees it\n'
expect POST /api/voice/v1/audio-jobs 200 -H 'Authorization: Bearer good-key' --data '{}'
expect_body 'identity=[key:POST:/api/voice/v1/audio-jobs:route=voice]'
expect_body 'authorization=[]'
expect GET /api/tasks/v1/tasks 401 -H 'Authorization: Bearer bad-key'
expect_body '"code":"unauthenticated"'
# A bad key with a good cookie: the key decides.
expect GET /api/tasks/v1/tasks 401 -H 'Authorization: Bearer bad-key' --cookie 'lifeos=good'
expect GET /android/updates 200 -H 'Authorization: Bearer good-key'
expect GET /android/updates 401 -H 'Authorization: Bearer bad-key'

printf '==> The check judges the route nginx reaches, not the raw URI\n'
# A path nginx would decode and resolve to another location is refused
# before any location (below); the route names the location's module.
expect POST '/api/finance/..%2Fmcp/mcp' 400 -H 'Authorization: Bearer good-key' --data '{}'
expect_body '"code":"forbidden_path"'
expect GET /api/integrations/banking/v1/connections 200 -H 'Authorization: Bearer good-key'
expect_body 'route=finance]'
expect GET /android/updates 200 -H 'Authorization: Bearer good-key'

printf '==> MCP: the 401 carries the challenge that starts OAuth\n'
# MCP's limit (5 a second, bursts of 10) counts every request, the
# refused ones too: let the requests above to /api/mcp/ age out first, or a
# fast runner gets 429 instead of the answers checked here.
sleep 2.5
expect POST /api/mcp/mcp 401 --data '{}'
expect_body '"code":"unauthenticated"'
grep -qi '^www-authenticate: Bearer resource_metadata="https://lifeos.example.com/.well-known/oauth-protected-resource/api/mcp"' "$work/headers" ||
  { cat "$work/headers" >&2; fail "MCP's 401 lacks the challenge"; }
[ "$(grep -ci '^www-authenticate:' "$work/headers")" = 1 ] || { cat "$work/headers" >&2; fail "MCP's 401 has the challenge more than once"; }
grep -qi '^x-content-type-options: nosniff' "$work/headers" || { cat "$work/headers" >&2; fail "MCP's 401 lost the security headers"; }
expect POST /api/mcp/mcp 401 -H 'Authorization: Bearer bad-key' --data '{}'
grep -qi '^www-authenticate: Bearer resource_metadata=' "$work/headers" || { cat "$work/headers" >&2; fail "MCP's 401 for a bad token lacks the challenge"; }
expect POST /api/mcp/mcp 200 -H 'Authorization: Bearer good-key' --data '{}'
expect_body 'identity=[key:POST:/api/mcp/mcp:route=mcp]'
expect_body 'authorization=[]'
expect POST /api/mcp/mcp 403 --cookie 'lifeos=forbidden' --data '{}'
expect_body '"code":"forbidden_origin"'
expect POST /api/mcp/mcp 403 -H 'Authorization: Bearer device-key' --data '{}'
expect_body '"code":"credential_not_allowed"'
expect POST /api/mcp/mcp 503 --cookie 'lifeos=boom' --data '{}'
expect_body '"code":"auth_unavailable"'
# Other routes carry no challenge.
expect GET /api/tasks/v1/tasks 401
! grep -qi '^www-authenticate:' "$work/headers" || { cat "$work/headers" >&2; fail "a 401 outside MCP has a challenge"; }

printf '==> Public routes and the Dashboard reach the Dashboard without the check\n'
for path in /login /setup /reset/abc /api/auth/get-session /_next/static/chunk.js /sw.js \
  /app.webmanifest /icons/icon-192.png /privacy /terms / /tasks /settings/security /api/account \
  /api/status /share /calendar/google/callback /finance/bank/callback \
  /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/api/mcp \
  /oauth/consent /settings/devices /api/auth/devices/child; do
  expect GET "$path" 200 --cookie 'lifeos=good; theme=dark' -H 'X-Life-OS-Identity: forged' -H 'Authorization: Bearer abc'
  expect_body dashboard
  expect_body 'cookie=[lifeos=good; theme=dark]'
  expect_body 'identity=[]'
  expect_body 'authorization=[Bearer abc]'
done
expect POST /api/auth/sign-in/username 200 --data '{}'
expect_body dashboard

printf '==> A path with encoded separators or dot segments reaches nothing\n'
# Encoded separators must not change the target: whatever the credential,
# such a path is 400 before any location, the auth check, the Dashboard,
# or a service. The stand-ins' logs must never show the made-up address
# (192.0.2.1, a documentation address) these paths name.
marker=192.0.2.1
bad_paths=()
for path in "${service_paths[@]}" /api/backups/ /api/processor/ /api/status/ /api/ /; do
  bad_paths+=("${path}http:%2F%2F$marker%2Fx.html%3F/..%2F..%2F..%2F..%2F..")
done
bad_paths+=(
  "/api/tasks/http:%2f%2f$marker%2fx.html%3f/..%2f..%2f..%2f..%2f.."
  "/api/tasks/http:%2F%2F$marker%2Fx.html%3F/%2E%2E%2F%2E%2E%2F%2E%2E%2F%2E%2E%2F%2E%2E"
  "/api/tasks/http:%2F%2F$marker%2Fx.html%3F/%2e%2e/%2e%2e/%2e%2e/%2e%2e/%2e%2e"
  "/api/tasks/http:%5C%5C$marker%5Cx.html%3F/..%5C..%5C..%5C..%5C.."
  "/api/tasks/http:%5c%5c$marker%5cx.html%3f/..%5c..%5c..%5c..%5c.."
  "/api/tasks/http:\\\\$marker\\x.html/..\\..\\..\\..\\.."
  "/api/tasks/http:%2F%2F$marker%2Fx/../../../.."
  "/api/tasks/./http:%2F%2F$marker"
  "/api/tasks/v1/..?$marker"
  "/api/tasks/v1/.?$marker"
  "/x/..%2F/api/tasks/http:%2F%2F$marker"
  "/api/tasks/%2e%2e%2f%2e%2e%2fhttp:$marker"
  "/api/tasks/v1%2e$marker"
)
for path in "${bad_paths[@]}"; do
  for method in GET POST; do
    for credential in none cookie key; do
      case $credential in
        none) as=() ;;
        cookie) as=(--cookie 'lifeos=good') ;;
        key) as=(-H 'Authorization: Bearer good-key') ;;
      esac
      expect "$method" "$path" 400 "${as[@]}" --data '{}'
      refuse_body dashboard
      refuse_body service
      # The gateway's refusal, with its headers; or, for the two paths that
      # leave the root once resolved (under / and /api/), nginx's own,
      # before it reads any location.
      if grep -qF '"code":"forbidden_path"' <<<"$body"; then
        grep -qi '^x-content-type-options: nosniff' "$work/headers" ||
          { cat "$work/headers" >&2; fail "$method $path: the 400 lacks the security headers"; }
      elif [[ $path != /http:* && $path != /api/http:* ]] || ! grep -qF '<title>400 Bad Request</title>' <<<"$body"; then
        printf '%s\n' "$body" >&2
        fail "$method $path ($credential): not the gateway's refusal"
      fi
    done
  done
done
# Encoded URLs in a query string are as before: the recipe link, OAuth's
# redirect_uri.
expect GET '/api/integrations/recipe-import/v1/preview?url=https%3A%2F%2Frecipes.example%2Fa%2F..%2Fb' 200 --cookie 'lifeos=good'
expect_body 'service GET /v1/preview?url=https%3A%2F%2Frecipes.example%2Fa%2F..%2Fb '
expect GET '/api/auth/oauth2/authorize?redirect_uri=http%3A%2F%2F127.0.0.1%3A3118%2Fcallback&state=..%2F..' 200
expect_body dashboard
# The stand-ins log every request they get (the image's access log): a
# request with the marker in the query reaches them and shows, the paths
# above never did.
expect GET "/api/tasks/v1/tasks?probe=gw-log-$$" 200 --cookie 'lifeos=good'
docker logs "$name-services" 2>&1 | grep -q "probe=gw-log-$$" || fail "the stand-in services' log does not show the requests they get"
for standin in dashboard services; do
  ! docker logs "$name-$standin" 2>&1 | grep -qF "$marker" || {
    docker logs "$name-$standin" 2>&1 | grep -F "$marker" >&2
    fail "the stand-in $standin got a request with a refused path"
  }
done

printf '==> Security headers: a strict frame and form policy; HSTS over HTTPS only\n'
policy() { # <http|https> <what>: the last answer has the policy, and HSTS only over HTTPS
  grep -qi "^content-security-policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" "$work/headers" ||
    { cat "$work/headers" >&2; fail "$2 lacks the content security policy"; }
  grep -qi '^x-frame-options: DENY' "$work/headers" || { cat "$work/headers" >&2; fail "$2 lacks X-Frame-Options: DENY"; }
  if [[ $1 == https ]]; then
    [[ "$(tr -d '\r' <"$work/headers" | grep -ci '^strict-transport-security: max-age=31536000$')" == 1 ]] ||
      { cat "$work/headers" >&2; fail "$2 over HTTPS lacks HSTS for a year (once, no preload)"; }
  else
    ! grep -qi '^strict-transport-security:' "$work/headers" || { cat "$work/headers" >&2; fail "$2 over plain HTTP has HSTS"; }
  fi
}
# Plain HTTP, where a client's own X-Forwarded-Proto is not believed.
for path in /login /tasks /api/auth/get-session; do
  expect GET "$path" 200 -H 'X-Forwarded-Proto: https'
  policy http "GET $path"
done
expect GET /api/tasks/v1/tasks 200 --cookie 'lifeos=good' -H 'X-Forwarded-Proto: https'
policy http 'a service'
expect GET /android/ 302 -H 'X-Forwarded-Proto: https'
policy http 'the login redirect'
expect GET /api/tasks/v1/tasks 401
policy http "the gateway's 401"
expect GET "/api/tasks/http:%2F%2F$marker" 400
policy http "the gateway's 400"

printf '==> /internal/ is not reachable from outside\n'
for path in /internal/auth/check /internal/status /internal/ /internal/x; do
  expect GET "$path" 404 --cookie 'lifeos=good'
  refuse_body dashboard
done

printf '==> /android/ needs a sign-in\n'
expect GET /android/ 302
grep -qi '^location: /login?next=/android/' "$work/headers" || { cat "$work/headers" >&2; fail "/android/ does not send to the login"; }
expect GET /android/updates 401
expect_body '"code":"unauthenticated"'
expect GET /android/ 200 --cookie 'lifeos=good'
expect_body Android
expect GET /android/updates 200 --cookie 'lifeos=good'
expect GET /android/updates 403 -H 'Authorization: Bearer device-key'
expect_body '"code":"credential_not_allowed"'

# The Cloudflare path: every client counts as arriving through Cloudflare's
# edge network.
# shellcheck disable=SC2016 # nginx variables, not the shell's
sed '/^geo \$realip_remote_addr \$via_cloudflare {/,/^}/ s/default 0;/default 1;/' "$template" >"$work/access.conf.template"
! cmp -s "$template" "$work/access.conf.template" || fail "could not make the Access variant of the configuration"
chmod 644 "$work/access.conf.template"

printf '==> LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS empty: Access is required on the tunnel, as before\n'
start "$name-access-on" "$work/access.conf.template" ''
expect GET /api/tasks/v1/x 403 --cookie 'lifeos=good'
expect_body '"code":"forbidden"'
expect GET /login 403
expect_body '"code":"forbidden"'
expect GET /api/tasks/v1/x 200 --cookie 'lifeos=good' -H 'Cf-Access-Jwt-Assertion: token'
refuse_body token
# Through Cloudflare the request came over HTTPS: HSTS.
policy https 'a service through Cloudflare'
expect GET "/api/tasks/http:%2F%2F$marker%2Fx/..%2F.." 400 --cookie 'lifeos=good' -H 'Cf-Access-Jwt-Assertion: token'
expect_body '"code":"forbidden_path"'
policy https "the gateway's 400 through Cloudflare"
docker rm -f "$name-access-on" >/dev/null

printf '==> LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS=off: the sign-in alone decides\n'
start "$name-access-off" "$work/access.conf.template" off
expect GET /login 200
policy https 'the login through Cloudflare'
expect GET /api/tasks/v1/x 401
expect GET /api/tasks/v1/x 200 --cookie 'lifeos=good'
expect GET "/api/tasks/http:%2F%2F$marker%2Fx.html%3F/..%2F..%2F..%2F..%2F.." 400
expect_body '"code":"forbidden_path"'
for standin in dashboard services; do
  ! docker logs "$name-$standin" 2>&1 | grep -qF "$marker" || fail "the stand-in $standin got a request with a refused path"
done

printf '\ngateway auth: all checks passed\n'
