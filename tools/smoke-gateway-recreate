#!/usr/bin/env bash
set -euo pipefail

# Proves the gateway follows a recreated service (BUG-37), on the disposable
# verification stack only. Each service below is removed and started again,
# as a redeploy does, while the gateway is left running, and it must come
# back on a new address: Docker would otherwise hand the freed address back
# to it, and a gateway that never re-resolves would still pass. So while
# the service is down, a throwaway placeholder container holds its old
# address on the verification stack's backend network (which has a fixed
# subnet for this, compose.verify.yaml). The gateway must then reach the new
# container through its path within 15 seconds (it re-resolves names every
# 10), without being recreated or restarted. Before BUG-37 nginx resolved
# each name once, at start, and would have sent the traffic to the
# placeholder.
#
# It only ever touches the lifeos-verify project: every container it stops,
# and the network it joins, must belong to it.

compose=(./tools/verify-compose)
gateway=http://127.0.0.1:13001
placeholder=lifeos-verify-ip-hold
cd "$(dirname "${BASH_SOURCE[0]}")/.."

remove_placeholder() { docker rm --force "$placeholder" >/dev/null 2>&1 || true; }
cleanup() {
  remove_placeholder
  "${compose[@]}" down --volumes --remove-orphans >/dev/null
}
trap cleanup EXIT

fail() {
  echo "gateway recreate smoke: $*" >&2
  exit 1
}

remove_placeholder
"${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
"${compose[@]}" up --detach --no-build --scale processor=0 >/dev/null

# Each service with its gateway path.
services=(food:/api/food recipe-import:/api/integrations/recipe-import calendar:/api/calendar)

ready() { curl --fail --silent --max-time 3 "$gateway$1/ready" >/dev/null; }
container() { "${compose[@]}" ps -q "$1"; }
# network <service>: "<network> <ip>" for each network the service is on
# (the backend only).
network() { docker inspect --format '{{range $name, $net := .NetworkSettings.Networks}}{{$name}} {{$net.IPAddress}}{{"\n"}}{{end}}' "$(container "$1")" | sed '/^$/d'; }
started() { docker inspect --format '{{.Id}} {{.State.StartedAt}}' "$(container gateway)"; }
# verify_only <container>: refuse anything outside the verification project.
verify_only() {
  local project
  project=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$1")
  [ "$project" = lifeos-verify ] || fail "refusing to touch container $1 of project '$project': only lifeos-verify"
}

for entry in "${services[@]}"; do
  path=${entry#*:}
  for _ in $(seq 1 90); do ready "$path" && break; sleep 1; done
  ready "$path" || fail "${entry%%:*} is not reachable through the gateway at all"
done
gateway_id=$(container gateway)
[ -n "$gateway_id" ] || fail "no gateway container"
verify_only "$gateway_id"
gateway_before=$(started)

for entry in "${services[@]}"; do
  service=${entry%%:*} path=${entry#*:}
  id=$(container "$service")
  [ -n "$id" ] || fail "no $service container"
  verify_only "$id"
  attached=$(network "$service")
  [ "$(wc -l <<<"$attached")" = 1 ] || fail "$service is on more than one network: $attached"
  read -r net before <<<"$attached"
  # Never the live project's networks.
  [[ "$net" == lifeos-verify* ]] || fail "refusing network '$net': only lifeos-verify networks"
  [ -n "$before" ] || fail "$service has no address on $net"

  # Down, its address held by the placeholder, and up again: a new address.
  "${compose[@]}" rm --stop --force "$service" >/dev/null 2>&1
  docker run --detach --rm --network "$net" --ip "$before" --name "$placeholder" \
    --label lifeos.verify.ip-hold=true alpine:3.22 sleep 120 >/dev/null ||
    fail "could not hold $before on $net for the placeholder"
  "${compose[@]}" up --detach --no-build --no-deps "$service" >/dev/null 2>&1
  read -r _ after <<<"$(network "$service")"
  [ -n "$after" ] && [ "$after" != "$before" ] ||
    fail "$service came back on '$after', not a new address (was $before), so this run cannot test re-resolution"

  # The container's own readiness first, so its startup time is not blamed
  # on the gateway.
  for _ in $(seq 1 60); do
    "${compose[@]}" exec -T gateway wget -q -O /dev/null "http://$service:8080/ready" 2>/dev/null && break
    sleep 1
  done
  deadline=$(($(date +%s) + 15))
  until ready "$path"; do
    [ "$(date +%s)" -lt "$deadline" ] ||
      fail "$service moved from $before to $after (the old address held by a placeholder) and the gateway did not reach it within 15 s ($gateway$path/ready)"
    sleep 1
  done
  remove_placeholder
  echo "$service: $before -> $after on $net, reached through $path"
done

[ "$(started)" = "$gateway_before" ] || fail "the gateway was recreated or restarted during the run"
echo "gateway recreate smoke passed: recreated services on new addresses are reached through the gateway without restarting it"
