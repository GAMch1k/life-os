#!/usr/bin/env bash
set -euo pipefail

# The verification stack must never share Docker resources with the deployed
# Life OS project. Keep the project name explicit even if Compose's `name:`
# field changes later.
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

compose=(docker compose --project-name lifeos-verify -f compose.yaml -f compose.verify.yaml)
# The verification stack never runs optional profiles from .env: a second
# cloudflared with the real tunnel token would receive production traffic.
export COMPOSE_PROFILES=
# Nor does it import the owner's personal feeds from .env: calendar-feeds' ZAW
# preset would fetch their real waste calendar and mix it into test data
# (compose.verify.yaml also blanks it, and the plan is refused with one).
export LIFE_OS_ZAW_ICS_URL=
# Nor the owner's Google OAuth client or token key: the verification stack
# never talks to Google (the google-calendar integration gets them blank,
# compose.verify.yaml points its Google endpoints nowhere, and browser tests
# stub the integration's endpoints).
export LIFE_OS_GOOGLE_CLIENT_ID= LIFE_OS_GOOGLE_CLIENT_SECRET= LIFE_OS_GOOGLE_TOKEN_KEY=
# Nor the owner's ntfy accounts, token, topic, or channel list: a test
# notification must never reach the owner's phone. ntfy itself stays off (its
# profile is cleared above). A smoke may choose channels, such as "log", with
# LIFE_OS_VERIFY_NOTIFICATIONS_CHANNELS.
export LIFE_OS_NOTIFICATIONS_CHANNELS="${LIFE_OS_VERIFY_NOTIFICATIONS_CHANNELS:-}"
export LIFE_OS_NTFY_TOPIC=verify LIFE_OS_NTFY_PUBLISHER_TOKEN= LIFE_OS_NTFY_PUBLISHER_PASSWORD_HASH= LIFE_OS_NTFY_PHONE_PASSWORD_HASH=
# Nor the owner's web push keys: devices subscribed to the owner's Life OS
# accept pushes signed with them only, so the verification stack has none
# (web push shows as not set up there; browser tests stub it in the page).
export LIFE_OS_WEBPUSH_VAPID_PUBLIC_KEY= LIFE_OS_WEBPUSH_VAPID_PRIVATE_KEY= LIFE_OS_WEBPUSH_SUBJECT=
# Nor the owner's Enable Banking application, its key, or the session key:
# the verification stack never talks to a bank (compose.verify.yaml also
# blanks them and points banking at an address that resolves nowhere).
export LIFE_OS_ENABLE_BANKING_APP_ID= LIFE_OS_ENABLE_BANKING_KEY_FILE= LIFE_OS_BANKING_TOKEN_KEY=
# Nor the AI categories job: the verification stack's processor uses the
# real Codex sign-in, and categorizing the browser tests' transactions behind
# their back would make them flaky. A smoke or benchmark that wants it sets
# LIFE_OS_VERIFY_AI_CATEGORIES=on.
export LIFE_OS_AI_CATEGORIES="${LIFE_OS_VERIFY_AI_CATEGORIES:-off}"
# Nor the AI budget plan job, for the same reason: the browser tests leave
# the AI's plans themselves. A smoke or benchmark that wants it sets
# LIFE_OS_VERIFY_AI_BUDGET_PLANS=on; the monthly plan stays off there.
export LIFE_OS_AI_BUDGET_PLANS="${LIFE_OS_VERIFY_AI_BUDGET_PLANS:-off}" LIFE_OS_AI_BUDGET_PLAN_MONTHLY=off
# Nor the owner's backups: the backup service writes to a scratch directory
# of the verification stack's own (LIFE_OS_VERIFY_BACKUP_DIR, by default under
# TMPDIR), never to LIFE_OS_BACKUP_DIR from .env, and the plan is refused with
# the owner's backup directory.
owner_setting() { # <variable>: the owner's directory setting in .env
  local value
  value=$(sed -n "s/^$1=//p" .env 2>/dev/null | tail -n 1)
  value=${value#[\"\']}; value=${value%[\"\']}
  value=${value/#\~/${HOME:-}}
  value=${value//'${HOME}'/${HOME:-}}; value=${value//'$HOME'/${HOME:-}}
  printf '%s' "$value"
}
live_backup_dir=$(owner_setting LIFE_OS_BACKUP_DIR)
export LIFE_OS_BACKUP_DIR="${LIFE_OS_VERIFY_BACKUP_DIR:-${TMPDIR:-/tmp}/lifeos-verify-backups}"
mkdir -p -m 700 "$LIFE_OS_BACKUP_DIR"
# Nor the owner's Android releases: the gateway serves /android/ from a
# directory of the verification stack's own (LIFE_OS_VERIFY_ANDROID_RELEASES_DIR,
# where tools/browser-e2e publishes a made-up release; by default an empty
# one under TMPDIR), never LIFE_OS_ANDROID_RELEASES_DIR from .env or the
# default ~/life-os.android, and the plan is refused with the owner's.
live_android_dir=$(owner_setting LIFE_OS_ANDROID_RELEASES_DIR)
export LIFE_OS_ANDROID_RELEASES_DIR="${LIFE_OS_VERIFY_ANDROID_RELEASES_DIR:-${TMPDIR:-/tmp}/lifeos-verify-android}"
mkdir -p -m 755 "$LIFE_OS_ANDROID_RELEASES_DIR"
# A smoke may add overlays (colon-separated paths); the isolation check below
# still applies to the merged plan.
if [[ -n "${LIFE_OS_VERIFY_OVERLAYS:-}" ]]; then
  IFS=: read -r -a overlays <<<"$LIFE_OS_VERIFY_OVERLAYS"
  for overlay in "${overlays[@]}"; do compose+=(-f "$overlay"); done
fi

require_isolated_resources() {
  command -v jq >/dev/null 2>&1 || { echo "verify-compose: jq is required" >&2; exit 2; }
  local config volume network
  config=$("${compose[@]}" config --format json)
  if jq -e '.services | has("cloudflared")' <<<"$config" >/dev/null; then
    echo "verify-compose: refusing a plan with the cloudflared connector" >&2
    exit 2
  fi
  if jq -e '(.services | has("ntfy")) or ((.services.notifications.environment.NOTIFICATIONS_NTFY_TOKEN // "") != "")' <<<"$config" >/dev/null; then
    echo "verify-compose: refusing a plan with ntfy or an ntfy token: it could reach the owner's phone" >&2
    exit 2
  fi
  if jq -e '((.services.notifications.environment.NOTIFICATIONS_WEBPUSH_VAPID_PRIVATE_KEY // "") != "")' <<<"$config" >/dev/null; then
    echo "verify-compose: refusing a plan with a web push key: it could reach the owner's devices" >&2
    exit 2
  fi
  if jq -e '((.services.banking.environment.LIFE_OS_ENABLE_BANKING_APP_ID // "") != "") or ((.services.banking.environment.LIFE_OS_BANKING_TOKEN_KEY // "") != "") or ([.services.banking.volumes[]? | select(.source != "/dev/null")] | length > 0)' <<<"$config" >/dev/null; then
    echo "verify-compose: refusing a plan with Enable Banking credentials or a bank key: it could reach the owner's bank" >&2
    exit 2
  fi
  # PostgreSQL reads the whole .env (env_file) but never calls Google; every
  # other service must come without the owner's Google OAuth settings.
  if jq -e '[.services | to_entries[] | select(.key != "postgres") | .value.environment // {} | (.LIFE_OS_GOOGLE_CLIENT_ID // ""), (.LIFE_OS_GOOGLE_CLIENT_SECRET // ""), (.LIFE_OS_GOOGLE_TOKEN_KEY // "")] | any(. != "")' <<<"$config" >/dev/null; then
    echo "verify-compose: refusing a plan with Google OAuth settings: it could reach the owner's Google account" >&2
    exit 2
  fi
  if jq -e '((.services["calendar-feeds"].environment.LIFE_OS_ZAW_ICS_URL // "") != "")' <<<"$config" >/dev/null; then
    echo "verify-compose: refusing a plan with a ZAW feed URL: it would import the owner's real waste calendar" >&2
    exit 2
  fi
  local backup_source owner_dir
  while IFS= read -r backup_source; do
    backup_source=$(realpath -m -- "$backup_source")
    for owner_dir in "${HOME:-}/life-os.backups" "$live_backup_dir"; do
      [[ -n "$owner_dir" && "$owner_dir" != /life-os.backups ]] || continue
      owner_dir=$(realpath -m -- "$owner_dir")
      if [[ "$backup_source" == "$owner_dir" || "$backup_source" == "$owner_dir"/* || "$owner_dir" == "$backup_source"/* ]]; then
        printf "verify-compose: refusing a plan whose backup service writes to the owner's backups: %s\n" "$backup_source" >&2
        exit 2
      fi
    done
  done < <(jq -r '.services.backup.volumes[]? | select(.type == "bind" and (.read_only // false | not)) | .source' <<<"$config")
  local android_source
  while IFS= read -r android_source; do
    android_source=$(realpath -m -- "$android_source")
    for owner_dir in "${HOME:-}/life-os.android" "$live_android_dir"; do
      [[ -n "$owner_dir" && "$owner_dir" != /life-os.android ]] || continue
      owner_dir=$(realpath -m -- "$owner_dir")
      if [[ "$android_source" == "$owner_dir" || "$android_source" == "$owner_dir"/* || "$owner_dir" == "$android_source"/* ]]; then
        printf "verify-compose: refusing a plan that mounts the owner's Android releases: %s\n" "$android_source" >&2
        exit 2
      fi
    done
  done < <(jq -r '.services | to_entries[] | .value.volumes[]? | select(.type == "bind") | .source' <<<"$config")
  # Nor the host itself: no service may mount the Docker socket (it controls
  # every container on the host), the host's root, /proc, or /sys (the
  # containers' cgroups), or the Docker data root. On this stack host-health
  # reports a made-up host (compose.verify.yaml) and the docker gateway does
  # not run.
  local host_source
  while IFS= read -r host_source; do
    printf "verify-compose: refusing a plan that mounts the host's %s into a service\n" "$host_source" >&2
    exit 2
  done < <(jq -r --arg docker_root "${LIFE_OS_DOCKER_ROOT:-/var/lib/docker}" '
    .services | to_entries[] | .value.volumes[]? | select(.type == "bind") | .source
    | select(. == "/" or . == "/proc" or startswith("/proc/") or . == "/sys" or startswith("/sys/") or test("(^|/)docker\\.sock$") or . == $docker_root or startswith($docker_root + "/"))' <<<"$config")
  while IFS= read -r volume; do
    [[ "$volume" == lifeos-verify-* ]] || {
      printf 'verify-compose: refusing shared verification volume: %s\n' "$volume" >&2
      exit 2
    }
  done < <(jq -r '.volumes // {} | to_entries[] | .value.name // ("lifeos-verify-" + .key)' <<<"$config")
  while IFS= read -r network; do
    [[ "$network" == lifeos-verify-* ]] || {
      printf 'verify-compose: refusing shared verification network: %s\n' "$network" >&2
      exit 2
    }
  done < <(jq -r '.networks // {} | to_entries[] | .value.name // ("lifeos-verify-" + .key)' <<<"$config")
}

require_isolated_resources
exec "${compose[@]}" "$@"
