#!/usr/bin/env bash
set -euo pipefail

# The verification stack must never share Docker resources with the deployed
# Life OS project. Keep the project name explicit even if Compose's `name:`
# field changes later.
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

compose=(docker compose --project-name lifeos-verify -f compose.yaml -f compose.verify.yaml)
# The verification stack never runs optional profiles from .env: a second
# cloudflared with the real tunnel token would receive production traffic.
export COMPOSE_PROFILES=
# Nor does it import the owner's personal feeds from .env: calendar-feeds' ZAW
# preset would fetch their real waste calendar and mix it into test data
# (compose.verify.yaml also blanks it, and the plan is refused with one).
export LIFE_OS_ZAW_ICS_URL=
# Nor the owner's Google OAuth client: the verification stack never talks to
# Google (its browser tests stub the Google endpoints).
export LIFE_OS_GOOGLE_CLIENT_ID= LIFE_OS_GOOGLE_CLIENT_SECRET= LIFE_OS_GOOGLE_TOKEN_KEY=
# Nor the owner's ntfy accounts, token, topic, or channel list: a test
# notification must never reach the owner's phone. ntfy itself stays off (its
# profile is cleared above). A smoke may choose channels, such as "log", with
# LIFE_OS_VERIFY_NOTIFICATIONS_CHANNELS.
export LIFE_OS_NOTIFICATIONS_CHANNELS="${LIFE_OS_VERIFY_NOTIFICATIONS_CHANNELS:-}"
export LIFE_OS_NTFY_TOPIC=verify LIFE_OS_NTFY_PUBLISHER_TOKEN= LIFE_OS_NTFY_PUBLISHER_PASSWORD_HASH= LIFE_OS_NTFY_PHONE_PASSWORD_HASH=
# A smoke may add overlays (colon-separated paths); the isolation check below
# still applies to the merged plan.
if [[ -n "${LIFE_OS_VERIFY_OVERLAYS:-}" ]]; then
  IFS=: read -r -a overlays <<<"$LIFE_OS_VERIFY_OVERLAYS"
  for overlay in "${overlays[@]}"; do compose+=(-f "$overlay"); done
fi

require_isolated_resources() {
  command -v jq >/dev/null 2>&1 || { echo "verify-compose: jq is required" >&2; exit 2; }
  local config volume network
  config=$("${compose[@]}" config --format json)
  if jq -e '.services | has("cloudflared")' <<<"$config" >/dev/null; then
    echo "verify-compose: refusing a plan with the cloudflared connector" >&2
    exit 2
  fi
  if jq -e '(.services | has("ntfy")) or ((.services.notifications.environment.NOTIFICATIONS_NTFY_TOKEN // "") != "")' <<<"$config" >/dev/null; then
    echo "verify-compose: refusing a plan with ntfy or an ntfy token: it could reach the owner's phone" >&2
    exit 2
  fi
  if jq -e '((.services["calendar-feeds"].environment.LIFE_OS_ZAW_ICS_URL // "") != "")' <<<"$config" >/dev/null; then
    echo "verify-compose: refusing a plan with a ZAW feed URL: it would import the owner's real waste calendar" >&2
    exit 2
  fi
  while IFS= read -r volume; do
    [[ "$volume" == lifeos-verify-* ]] || {
      printf 'verify-compose: refusing shared verification volume: %s\n' "$volume" >&2
      exit 2
    }
  done < <(jq -r '.volumes // {} | to_entries[] | .value.name // ("lifeos-verify-" + .key)' <<<"$config")
  while IFS= read -r network; do
    [[ "$network" == lifeos-verify-* ]] || {
      printf 'verify-compose: refusing shared verification network: %s\n' "$network" >&2
      exit 2
    }
  done < <(jq -r '.networks // {} | to_entries[] | .value.name // ("lifeos-verify-" + .key)' <<<"$config")
}

require_isolated_resources
exec "${compose[@]}" "$@"
