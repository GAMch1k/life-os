#!/usr/bin/env bash
set -euo pipefail

# Runs govulncheck on every Go module (GOWORK=off, as the images build
# them): the known vulnerabilities in the Go version and the dependencies
# that the code can reach. CI runs it (docs/operations/ci.md).
#
#   tools/check-vulnerabilities [module…]
#
# govulncheck is the pinned version below, from PATH when it is that
# version, else installed into a scratch directory. It needs the network for
# the module downloads and the vulnerability database (vuln.go.dev). The run
# fails when a module has a finding, listed by its IDs at the end, or when
# govulncheck cannot check a module.

govulncheck_version=v1.9.0

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

if [[ $# -gt 0 ]]; then
  modules=("${@%/}")
else
  mapfile -t modules < <(find pkg services templates tools -name go.mod -type f -not -path '*/node_modules/*' -printf '%h\n' | sort)
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
govulncheck=govulncheck
if ! govulncheck -version 2>/dev/null | grep -q "govulncheck@$govulncheck_version\$"; then
  printf '==> go install golang.org/x/vuln/cmd/govulncheck@%s\n' "$govulncheck_version"
  GOBIN=$work GOWORK=off go install "golang.org/x/vuln/cmd/govulncheck@$govulncheck_version"
  govulncheck=$work/govulncheck
fi

failed=()
for module in "${modules[@]}"; do
  [[ -f "$module/go.mod" ]] || { printf 'check-vulnerabilities: %s is not a Go module\n' "$module" >&2; exit 2; }
  [[ "${GITHUB_ACTIONS:-}" != true ]] || printf '::group::govulncheck: %s\n' "$module"
  printf '==> govulncheck: %s\n' "$module"
  log="$work/$(tr '/' '_' <<<"$module").log"
  status=0
  (cd "$module" && GOWORK=off "$govulncheck" ./...) >"$log" 2>&1 || status=$?
  cat "$log"
  [[ "${GITHUB_ACTIONS:-}" != true ]] || printf '::endgroup::\n'
  case "$status" in
    0) ;;
    # Exit status 3: findings, listed by their IDs.
    3) failed+=("$module: $(grep -oE '^Vulnerability #[0-9]+: [A-Z]+-[0-9]+-[0-9]+' "$log" | sed 's/.*: //' | tr '\n' ' ' | sed 's/ $//')") ;;
    *) failed+=("$module: govulncheck exited $status") ;;
  esac
done

if [[ ${#failed[@]} -gt 0 ]]; then
  printf '\n' >&2
  printf 'check-vulnerabilities: %s\n' "${failed[@]}" >&2
  [[ "${GITHUB_ACTIONS:-}" != true ]] || printf '::error title=govulncheck::%s\n' "${failed[@]}"
  exit 1
fi
printf '\nNo known vulnerabilities in %d Go modules.\n' "${#modules[@]}"
