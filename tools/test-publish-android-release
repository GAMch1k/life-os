#!/usr/bin/env bash
set -euo pipefail

# Exercises tools/publish-android-release against scratch directories only
# (made-up releases from tools/fixtures/android-release): a release
# publishes, the same one again publishes nothing, a downgrade and a SHA-256
# mismatch are refused with nothing changed, the newest 5 versions of each
# app are kept, and a publish killed midway leaves the old manifest and its
# APKs intact. The GitHub step runs against a made-up GitHub
# (tools/fixtures/fake-gh, which stands in for gh on PATH): a release goes
# there as a draft and is then published as the latest, the same one again
# changes nothing, --dry-run changes nothing anywhere, every refusal comes
# before any change, and a publish that failed on GitHub is finished by
# running it again. No Docker, no network.
#
#   tools/test-publish-android-release

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fail() {
  printf 'test-publish-android-release: %s\n' "$*" >&2
  exit 1
}
target=$work/android
# Never the owner's directory or zone from .env, and no GitHub step until
# the GitHub tests below turn it on.
export LIFE_OS_ANDROID_RELEASES_DIR=$target LIFE_OS_TIMEZONE=Europe/Berlin LIFE_OS_ANDROID_GITHUB_REPO=off

# Stands in for mv: when a rename's target matches $INTERRUPT_AT, it kills
# the publish (SIGKILL, so no cleanup runs), as a crash or a power cut would.
mkdir -p "$work/bin"
cat >"$work/bin/mv" <<EOF
#!/usr/bin/env bash
target=\${!#}
if [[ -n "\${INTERRUPT_AT:-}" && "\${target##*/}" == \$INTERRUPT_AT ]]; then
  kill -KILL "\$PPID"
  exit 1
fi
exec $(command -v mv) "\$@"
EOF
chmod +x "$work/bin/mv"
# gh is always the stand-in, so no test ever reaches the real GitHub.
github=$work/github
export FAKE_GH_DIR=$github
printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$repo_root/tools/fixtures/fake-gh" >"$work/bin/gh"
chmod +x "$work/bin/gh"

fresh() { # an empty releases directory
  rm -rf "$target"
  install -d -m 755 "$target"
}
release() { # <name> <versionName> <versionCode> [apps…]: a made-up release in $work/<name>
  local name=$1
  shift
  rm -rf "${work:?}/$name"
  tools/fixtures/android-release "$work/$name" "$@"
}
publish() { # <arguments…>; status in $status, output in $work/out
  set +e
  # (The group's stderr takes bash's "Killed" report of an interrupted run.)
  { env PATH="$work/bin:$PATH" INTERRUPT_AT="${interrupt:-}" tools/publish-android-release "$@" >"$work/out" 2>&1; } 2>/dev/null
  status=$?
  set -e
}
expect() { # <status> <message> <arguments…>
  local want=$1 message=$2
  shift 2
  publish "$@"
  [[ "$status" == "$want" ]] || { cat "$work/out"; fail "publish $* exited $status, want $want"; }
  grep -qF -- "$message" "$work/out" || { cat "$work/out"; fail "publish $* did not say: $message"; }
}
manifest() { jq -r "$1" "$target/updates.json"; }
apks() { # <app>: the versionCodes of its APKs in the releases directory
  find "$target" -maxdepth 1 -name "lifeos-$1-*.apk" -printf '%f\n' | sed -E 's/.*-([0-9]+)\.apk$/\1/' | sort -n | tr '\n' ' ' | sed 's/ $//'
}
consistent() { # every APK the manifest lists is there; the latest ones match it
  local url
  while IFS= read -r url; do
    [[ -f "$target/${url#/android/}" ]] || fail "the manifest lists $url, which is missing"
  done < <(manifest '.apps[] | .url, .previous[].url')
  while IFS=$'\t' read -r url sha size; do
    [[ "$(sha256sum <"$target/${url#/android/}" | cut -d ' ' -f 1)" == "$sha" ]] || fail "$url does not match the manifest's SHA-256"
    [[ "$(stat -c %s "$target/${url#/android/}")" == "$size" ]] || fail "$url does not match the manifest's size"
  done < <(manifest '.apps[] | [.url, .sha256, .size] | @tsv')
}
snapshot() { cp "$target/updates.json" "$work/updates.before"; cp "$target/index.html" "$work/index.before"; }
unchanged() { # the manifest and the page are as at the last snapshot
  cmp -s "$target/updates.json" "$work/updates.before" || fail "the manifest changed"
  cmp -s "$target/index.html" "$work/index.before" || fail "the page changed"
}

printf '==> A release publishes\n'
fresh
release r1 0.1.0 1
expect 0 'published phone 0.1.0 (1): /android/lifeos-phone-0.1.0-1.apk' "$work/r1" --notes 'First <b>build</b> & more'
grep -qF 'published wear 0.1.0 (1): /android/lifeos-wear-0.1.0-1.apk' "$work/out" || fail "the wear app was not published"
for app in phone wear; do
  jq -e --arg app "$app" --slurpfile release "$work/r1/release.json" '
    .formatVersion == 1 and (.apps[$app] | del(.publishedAt)) == ($release[0][$app] + {
      url: "/android/lifeos-\($app)-0.1.0-1.apk", notes: "First <b>build</b> & more", previous: []})
    and (.apps[$app].publishedAt | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
  ' "$target/updates.json" >/dev/null || { cat "$target/updates.json"; fail "the manifest's $app entry is not the release's"; }
  cmp -s "$work/r1/lifeos-$app-0.1.0-1.apk" "$target/lifeos-$app-0.1.0-1.apk" || fail "the $app APK was not copied as is"
done
consistent
[[ -z "$(find "$target" -type f ! -perm 644)" ]] || fail "a published file is not mode 644 (the gateway reads them)"
[[ -z "$(find "$target" -name '.publish-*')" ]] || fail "a temporary file was left behind"
grep -qF '<a class="download" href="/android/lifeos-phone-0.1.0-1.apk">Download Life OS 0.1.0</a>' "$target/index.html" || fail "the page has no phone download"
grep -qF 'href="/android/lifeos-wear-0.1.0-1.apk"' "$target/index.html" || fail "the page does not list the watch APK"
grep -qF 'First &lt;b&gt;build&lt;/b&gt; &amp; more' "$target/index.html" || fail "the page does not show the notes, escaped"
! grep -qF '<b>build' "$target/index.html" || fail "the page shows the notes unescaped"

printf '==> The same release again publishes nothing\n'
snapshot
expect 0 'nothing new to publish' "$work/r1"
grep -qF 'unchanged phone 0.1.0 (1)' "$work/out" || fail "the phone app was not reported unchanged"
cmp -s "$target/updates.json" "$work/updates.before" || fail "the manifest was rewritten"

printf '==> A downgrade is refused\n'
release r3 0.1.2 3
expect 0 'published phone 0.1.2 (3)' "$work/r3"
snapshot
release r2 0.1.1 2
expect 2 'versionCode 2 (0.1.1) is older than the published 3 (0.1.2); refusing a downgrade' "$work/r2"
unchanged
[[ ! -e "$target/lifeos-phone-0.1.1-2.apk" && ! -e "$target/lifeos-wear-0.1.1-2.apk" ]] || fail "a refused APK was copied"
release r3b 0.1.2 3
expect 2 'versionCode 3 is already published with a different APK' "$work/r3b"
unchanged
expect 0 'published phone 0.1.1 (2)' "$work/r2" --force
[[ "$(manifest '[.apps.phone.versionCode, .apps.phone.previous[0].versionCode] | @tsv')" == $'2\t3' ]] || fail "--force did not publish the older version over the newer one"
consistent

printf '==> A build from uncommitted changes is refused\n'
snapshot
release r9 0.1.9 9
jq '.phone.commit = "0123abc-dirty"' "$work/r9/release.json" >"$work/r9/release.tmp" && mv "$work/r9/release.tmp" "$work/r9/release.json"
expect 2 'came from uncommitted changes (commit ends in -dirty)' "$work/r9"
unchanged
[[ ! -e "$target/lifeos-phone-0.1.9-9.apk" ]] || fail "a refused -dirty APK was copied"
expect 0 'published phone 0.1.9 (9)' "$work/r9" --force
consistent

printf '==> A SHA-256 or size mismatch is refused\n'
fresh
expect 0 'published phone 0.1.0 (1)' "$work/r1"
snapshot
release r4 0.2.0 4
jq --arg sha "$(printf 'other' | sha256sum | cut -d ' ' -f 1)" '.wear.sha256 = $sha' "$work/r4/release.json" >"$work/r4/release.edited"
mv "$work/r4/release.edited" "$work/r4/release.json"
expect 2 'the SHA-256 of lifeos-wear-0.2.0-4.apk is' "$work/r4"
unchanged
[[ "$(apks phone)" == 1 && "$(apks wear)" == 1 ]] || fail "a refused release copied an APK (phone: $(apks phone); wear: $(apks wear))"
release r4 0.2.0 4
printf 'x' >>"$work/r4/lifeos-phone-0.2.0-4.apk"
expect 2 "lifeos-phone-0.2.0-4.apk is $(stat -c %s "$work/r4/lifeos-phone-0.2.0-4.apk") bytes, release.json says" "$work/r4"
unchanged

printf '==> Invalid releases and directories are refused\n'
release r5 0.3.0 5
jq 'del(.phone.minSdk) | .wear.versionName = "../../etc"' "$work/r5/release.json" >"$work/r5/release.edited"
mv "$work/r5/release.edited" "$work/r5/release.json"
expect 2 'phone.minSdk must be a whole number' "$work/r5"
grep -qF 'wear.versionName must be' "$work/out" || fail "a versionName with a path was not refused"
release r5 0.3.0 5
rm "$work/r5/lifeos-wear-0.3.0-5.apk"
expect 2 'wear: lifeos-wear-0.3.0-5.apk is not in' "$work/r5"
printf 'not json' >"$work/r5/release.json"
expect 2 'is not a JSON object' "$work/r5"
printf '{"watch": {}}' >"$work/r5/release.json"
expect 2 'describes neither phone nor wear' "$work/r5"
unchanged
release r5 0.3.0 5
chmod 700 "$target"
expect 2 'the gateway cannot read' "$work/r5"
chmod 755 "$target"
LIFE_OS_ANDROID_RELEASES_DIR=$work/missing expect 2 'does not exist: create it with install -d -m 755' "$work/r5"
exec 8<"$target"
flock 8
expect 2 'another publish to' "$work/r5"
exec 8<&-
unchanged

printf '==> The newest 5 versions of each app are kept\n'
fresh
for code in 1 2 3 4 5 6 7; do
  release "v$code" "0.0.$code" "$code"
  expect 0 "published phone 0.0.$code ($code)" "$work/v$code"
done
grep -qF 'deleted lifeos-phone-0.0.2-2.apk (keeping the newest 5 of each app)' "$work/out" || fail "the deletion was not reported"
[[ "$(apks phone)" == '3 4 5 6 7' && "$(apks wear)" == '3 4 5 6 7' ]] || fail "kept phone $(apks phone) and wear $(apks wear), want 3 4 5 6 7"
[[ "$(manifest '[.apps.phone.previous[].versionCode] | join(" ")')" == '6 5 4 3' ]] || fail "the phone's previous versions are not 6 5 4 3"
consistent
grep -qF 'Phone 0.0.3 (3)</a>' "$target/index.html" || fail "the page does not list the older versions"
! grep -qF '0.0.2' "$target/index.html" || fail "the page lists a deleted version"

printf '==> A publish killed midway leaves the old manifest\n'
snapshot
release v8 0.0.8 8
for interrupt in 'lifeos-wear-*.apk' updates.json; do
  publish "$work/v8"
  [[ "$status" == 137 ]] || { cat "$work/out"; fail "the publish was not killed at $interrupt (status $status)"; }
  unchanged
  consistent
  [[ "$(manifest '.apps.phone.versionCode')" == 7 ]] || fail "the manifest moved on after a kill at $interrupt"
done
interrupt=''
[[ -n "$(find "$target" -name '.publish-*')" ]] || fail "the kill left no temporary file (did it happen before the rename?)"
expect 0 'published phone 0.0.8 (8)' "$work/v8"
[[ -z "$(find "$target" -name '.publish-*')" ]] || fail "the next publish left the killed one's temporary files"
[[ "$(apks phone)" == '4 5 6 7 8' ]] || fail "kept phone $(apks phone) after the next publish, want 4 5 6 7 8"
consistent

printf '==> A release under "apps", with one app\n'
release p9 0.0.9 9 phone
jq '{apps: .}' "$work/p9/release.json" >"$work/p9/release.edited"
mv "$work/p9/release.edited" "$work/p9/release.json"
expect 0 'published phone 0.0.9 (9)' "$work/p9"
! grep -q 'wear' "$work/out" || { cat "$work/out"; fail "the wear app was touched"; }
[[ "$(manifest '[.apps.phone.versionCode, .apps.wear.versionCode] | @tsv')" == $'9\t8' ]] || fail "the manifest is not phone 9 and wear 8"
consistent

# ---- The GitHub step, against the made-up GitHub (tools/fixtures/fake-gh)

c1=1111111111111111111111111111111111111111
c2=2222222222222222222222222222222222222222
c3=3333333333333333333333333333333333333333
fresh_github() { # an empty made-up GitHub that has the commits c1 and c2
  rm -rf "$github"
  mkdir -p "$github"
  printf '%s\n' "$c1" "$c2" >"$github/commits"
}
gh_release() { # <tag> <jq filter>: the filter over the release with that tag (drafts included)
  local file
  for file in "$github"/releases/*/release.json; do
    if [[ ! -f "$file" ]] || ! jq -e --arg tag "$1" '.tag_name == $tag' "$file" >/dev/null; then continue; fi
    jq -r "$2" "$file"
    return
  done
  printf 'none\n'
}
gh_asset() { # <tag> <name>: the path of that asset of the release with that tag
  local file
  for file in "$github"/releases/*/release.json; do
    [[ -f "$file" ]] && jq -e --arg tag "$1" '.tag_name == $tag' "$file" >/dev/null && { printf '%s\n' "${file%/release.json}/assets/$2"; return; }
  done
  printf '%s\n' "$github/none"
}
releases_on_github() { find "$github/releases" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l; }
calls_mark() { touch "$github/calls"; wc -l <"$github/calls" >"$work/calls.mark"; }
calls_since() { tail -n +"$(($(cat "$work/calls.mark") + 1))" "$github/calls"; }
no_github_writes() { # no gh call since the mark changed anything
  ! calls_since | grep -E '^(release create|api -X)' || fail "gh was asked to change something"
}
github_release() { # <name> <versionName> <versionCode> <commit> [apps…]
  local name=$1 version=$2 code=$3 commit=$4
  shift 4
  rm -rf "${work:?}/$name"
  ANDROID_FIXTURE_COMMIT=$commit tools/fixtures/android-release "$work/$name" "$version" "$code" "$@"
}
gh_expect() { LIFE_OS_ANDROID_GITHUB_REPO=GAMch1k/life-os-app expect "$@"; }

printf '==> A release goes to GitHub too: a draft with both APKs and updates.json, then the latest\n'
fresh
fresh_github
github_release g13 0.4.6 13 "$c1"
gh_expect 0 'github: published v0.4.6-13 on GAMch1k/life-os-app as the latest release: https://github.com/GAMch1k/life-os-app/releases/tag/v0.4.6-13' "$work/g13" --notes 'Updates from GitHub'
grep -qF 'published phone 0.4.6 (13): /android/lifeos-phone-0.4.6-13.apk' "$work/out" || fail "the server's part was not published"
consistent
[[ "$(releases_on_github)" == 1 ]] || fail "GitHub has $(releases_on_github) releases, want 1"
[[ "$(gh_release v0.4.6-13 '[.draft, .target_commitish, .name] | @tsv')" == $'false\t'"$c1"$'\tLife OS for Android 0.4.6 (13)' ]] ||
  fail "the GitHub release is not published at the build's commit: $(gh_release v0.4.6-13 .)"
[[ "$(cat "$github/latest")" == "$(gh_release v0.4.6-13 .id)" ]] || fail "the GitHub release is not the latest"
grep -qE '^release create v0\.4\.6-13 --repo GAMch1k/life-os-app --draft --target '"$c1"' ' "$github/calls" || fail "the release was not created as a draft first"
grep -qF 'make_latest=true' "$github/calls" || fail "the release was not published as the latest"
for app in phone wear; do
  cmp -s "$work/g13/lifeos-$app-0.4.6-13.apk" "$(gh_asset v0.4.6-13 "lifeos-$app-0.4.6-13.apk")" || fail "the $app APK on GitHub is not the release's"
  jq -e --arg app "$app" --slurpfile release "$work/g13/release.json" '
    .formatVersion == 1 and (.apps[$app] | del(.publishedAt)) == ($release[0][$app] + {
      url: "https://github.com/GAMch1k/life-os-app/releases/download/v0.4.6-13/lifeos-\($app)-0.4.6-13.apk",
      notes: "Updates from GitHub", previous: []})
  ' "$(gh_asset v0.4.6-13 updates.json)" >/dev/null || { cat "$(gh_asset v0.4.6-13 updates.json)"; fail "GitHub's updates.json does not describe the $app APK"; }
done
gh_release v0.4.6-13 .body | grep -qF "$(jq -r .phone.sha256 "$work/g13/release.json")  lifeos-phone-0.4.6-13.apk" || fail "the release notes do not give the phone APK's SHA-256"
gh_release v0.4.6-13 .body | grep -qF 'Updates from GitHub' || fail "the release notes do not carry --notes"

printf '==> The same release again changes nothing, here or on GitHub\n'
snapshot
calls_mark
gh_expect 0 'github: unchanged, the release v0.4.6-13 on GAMch1k/life-os-app has these APKs' "$work/g13"
grep -qF 'nothing new to publish' "$work/out" || fail "the server's part published something"
unchanged
no_github_writes

printf '==> --dry-run changes nothing, here or on GitHub\n'
github_release g14 0.4.7 14 "$c2"
calls_mark
gh_expect 0 'dry run: github: would create the release v0.4.7-14 on GAMch1k/life-os-app at '"$c2" "$work/g14" --dry-run
grep -qF 'dry run: would publish phone 0.4.7 (14): /android/lifeos-phone-0.4.7-14.apk' "$work/out" || fail "the dry run does not say what it would publish"
grep -qF 'dry run: nothing was changed' "$work/out" || fail "the dry run does not say it changed nothing"
unchanged
[[ ! -e "$target/lifeos-phone-0.4.7-14.apk" ]] || fail "the dry run copied an APK"
no_github_writes
[[ "$(releases_on_github)" == 1 ]] || fail "the dry run made a GitHub release"
expect 0 'dry run: github: skipped (LIFE_OS_ANDROID_GITHUB_REPO=off)' "$work/g14" --dry-run

printf '==> Without the GitHub step: --no-github, or LIFE_OS_ANDROID_GITHUB_REPO=off\n'
calls_mark
fresh
gh_expect 0 'github: skipped (--no-github)' "$work/g14" --no-github
grep -qF 'published phone 0.4.7 (14)' "$work/out" || fail "--no-github did not publish here"
fresh
expect 0 'github: skipped (LIFE_OS_ANDROID_GITHUB_REPO=off)' "$work/g14"
[[ -z "$(calls_since)" ]] || fail "gh was called without the GitHub step: $(calls_since)"

printf '==> What GitHub must not get is refused, before anything changes\n'
fresh
fresh_github
gh_expect 0 'github: published v0.4.6-13' "$work/g13"
snapshot
refused_everywhere() { # <message> <arguments…>: refused with nothing changed here or on GitHub
  calls_mark
  gh_expect 2 "$@"
  if [[ -e "$work/updates.before" ]]; then unchanged; else [[ ! -e "$target/updates.json" ]] || fail "a refused release was published here"; fi
  no_github_writes
}
github_release g15 0.4.8 15 "$c3"
refused_everywhere 'the build'"'"'s commit '"$c3"' is not on GitHub (GAMch1k/life-os-app): push it first' "$work/g15"
github_release g15 0.4.8 15 "$c2-dirty"
refused_everywhere 'a build from uncommitted changes never goes to GitHub, not even with --force' "$work/g15" --force
github_release g15 0.4.8 15 0123abc
refused_everywhere 'must be a full SHA (40 hexadecimal digits), not 0123abc' "$work/g15"
github_release g15 0.4.8 15 "$c2" phone
refused_everywhere 'a GitHub release carries both apps, and '"$work/g15"'/release.json has only phone' "$work/g15"
github_release g15 0.4.8 15 "$c2"
jq '.wear.versionCode = 16 | .wear.versionName = "0.4.9"' "$work/g15/release.json" >"$work/g15/release.edited"
mv "$work/g15/release.edited" "$work/g15/release.json"
mv "$work/g15/lifeos-wear-0.4.8-15.apk" "$work/g15/lifeos-wear-0.4.9-16.apk"
refused_everywhere 'the phone and the watch differ in versionName, versionCode, or commit' "$work/g15"
# Here the server has nothing, so only GitHub can refuse.
github_release g12 0.4.5 12 "$c2"
fresh
rm "$work/updates.before"
refused_everywhere 'versionCode 12 is not above the latest GitHub release, v0.4.6-13 (phone 13, wear 13); refusing a downgrade' "$work/g12"
github_release g13b 0.4.6 13 "$c2"
refused_everywhere 'the GitHub release v0.4.6-13 already exists with other APKs' "$work/g13b"
printf 'false\n' >"$github/push"
refused_everywhere 'may not publish releases on GAMch1k/life-os-app (no push access)' "$work/g14"
rm "$github/push"
FAKE_GH_LOGGED_OUT=1 refused_everywhere 'gh api repos/GAMch1k/life-os-app failed: gh: To get started with GitHub CLI' "$work/g14"
LIFE_OS_ANDROID_GITHUB_REPO='not a repository' expect 2 'LIFE_OS_ANDROID_GITHUB_REPO must be a GitHub repository' "$work/g14"
LIFE_OS_ANDROID_GITHUB_REPO=someone/else expect 2 'gh does not see the repository someone/else' "$work/g14"
[[ ! -e "$target/updates.json" ]] || fail "a refused release was published here"

printf '==> --force publishes an older version on GitHub too\n'
gh_expect 0 'github: published v0.4.5-12' "$work/g12" --force
[[ "$(cat "$github/latest")" == "$(gh_release v0.4.5-12 .id)" ]] || fail "--force did not make v0.4.5-12 the latest"

printf '==> A publish that failed on GitHub is finished by running it again\n'
fresh
fresh_github
FAKE_GH_FAIL='api -X PATCH *' gh_expect 1 'the GitHub release v0.4.6-13 is not published (see above); everything here is. Run the same command again to finish it' "$work/g13"
consistent
[[ "$(manifest .apps.phone.versionCode)" == 13 ]] || fail "the server's part was not published before the GitHub step"
[[ "$(gh_release v0.4.6-13 .draft)" == true ]] || fail "the failed publish did not leave its draft"
[[ ! -s "$github/latest" ]] || fail "a draft became the latest"
gh_expect 0 'github: published v0.4.6-13 on GAMch1k/life-os-app as the latest release' "$work/g13"
grep -qF 'nothing new to publish' "$work/out" || fail "the second run published something here again"
[[ "$(releases_on_github)" == 1 && "$(gh_release v0.4.6-13 .draft)" == false ]] || fail "the second run did not replace the draft with one published release"
grep -qE '^api -X DELETE repos/GAMch1k/life-os-app/releases/[0-9]+$' "$github/calls" || fail "the old draft was not deleted"

printf '==> An upload GitHub got wrong is never published\n'
fresh
fresh_github
FAKE_GH_DAMAGE=1 gh_expect 1 'does not hold the files as uploaded' "$work/g13"
[[ "$(gh_release v0.4.6-13 .draft)" == true && ! -s "$github/latest" ]] || fail "a damaged draft was published"
gh_expect 0 'github: published v0.4.6-13' "$work/g13"
cmp -s "$work/g13/lifeos-phone-0.4.6-13.apk" "$(gh_asset v0.4.6-13 lifeos-phone-0.4.6-13.apk)" || fail "the run after a damaged upload did not upload the APK whole"

printf '\npublish-android-release: all checks passed\n'
