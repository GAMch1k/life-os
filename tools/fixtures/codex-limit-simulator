#!/bin/sh
# Stands in for the Codex CLI in the retry-scheduling smoke only.
#
# A real usage limit cannot be triggered on demand, so this wrapper simulates
# one at the CLI's command-line boundary. While the unix time in
# $SIM_DIR/until is in the future:
#   mode "limit": `codex exec` fails with the CLI's usage-limit message and
#                 `codex app-server` reports the codex bucket as reached,
#                 resetting at that time;
#   mode "fail":  `codex exec` fails with a transport error and app-server is
#                 the real one (no recovery time is known).
# Every other call, and every call after that time, runs the real Codex CLI.
SIM_DIR=${SIM_DIR:-/opt/lifeos-sim}
until=$(cat "$SIM_DIR/until" 2>/dev/null || echo 0)
mode=$(cat "$SIM_DIR/mode" 2>/dev/null || echo limit)
if [ "$(date +%s)" -lt "$until" ]; then
  case "$1:$mode" in
    exec:limit)
      echo "ERROR: You’ve hit your usage limit. Upgrade to Pro (https://chatgpt.com/explore/pro), visit https://chatgpt.com/codex/settings/usage to purchase more credits or try again later."
      exit 1
      ;;
    exec:fail)
      echo "ERROR: stream disconnected before completion"
      exit 1
      ;;
    app-server:limit)
      limit="{\"limitId\":\"codex\",\"primary\":{\"usedPercent\":100,\"windowDurationMins\":300,\"resetsAt\":$until},\"planType\":\"plus\",\"rateLimitReachedType\":\"rate_limit_reached\"}"
      while IFS= read -r line; do
        case "$line" in
          *'"method":"initialize"'*) echo '{"id":1,"result":{"userAgent":"codex-limit-simulator"}}' ;;
          *'"method":"account/read"'*) echo '{"id":2,"result":{"account":{"type":"chatgpt","planType":"plus"},"requiresOpenaiAuth":true}}' ;;
          *'"method":"account/rateLimits/read"'*) echo "{\"id\":3,\"result\":{\"rateLimits\":$limit,\"rateLimitsByLimitId\":{\"codex\":$limit}}}" ;;
        esac
      done
      exit 0
      ;;
  esac
fi
exec codex "$@"
