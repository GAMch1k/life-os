#!/usr/bin/env bash
set -euo pipefail

# Checks the gateway's /android/ (infra/nginx/life-os.conf.template) in
# throwaway containers, never the deployed gateway or the verification stack:
# the gateway's nginx with its configuration, rendered from the template as
# compose.yaml has it rendered (with made-up hosts), a release published with
# tools/publish-android-release into a scratch directory mounted read-only
# at /srv/android as compose.yaml does, and a stand-in Dashboard, on a
# network of their own. It checks the manifest, the page, the APKs (a 20 MB
# one whole, a range, the headers), that missing files, other names,
# symbolic links, traversal, and other methods get nothing, and that /android/
# needs Cloudflare Access's token on the Cloudflare path like everything
# else.
#
#   tools/test-android-gateway

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
command -v docker >/dev/null 2>&1 || { echo 'test-android-gateway: docker is required' >&2; exit 2; }
# The gateway image's base (infra/nginx/Dockerfile); the configuration is
# mounted, as the Access variant below changes it.
image=$(sed -n 's/^FROM //p' infra/nginx/Dockerfile | head -n 1)
[[ -n "$image" ]] || { echo "test-android-gateway: no base image in infra/nginx/Dockerfile" >&2; exit 2; }
name=lifeos-verify-android-$$
work=$(mktemp -d)
cleanup() {
  docker rm -f "$name-gateway" "$name-access" "$name-dashboard" >/dev/null 2>&1 || true
  docker network rm "$name" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT
fail() {
  printf 'test-android-gateway: %s\n' "$*" >&2
  exit 1
}

printf '==> A published release: a 20 MB phone APK and a watch APK\n'
releases=$work/android
install -d -m 755 "$releases"
export LIFE_OS_ANDROID_RELEASES_DIR=$releases LIFE_OS_TIMEZONE=Europe/Berlin
ANDROID_FIXTURE_APK_BYTES=20000000 tools/fixtures/android-release "$work/phone" 0.1.0 1 phone
tools/fixtures/android-release "$work/wear" 0.1.0 1 wear
tools/publish-android-release "$work/phone" --no-github --notes 'Gateway test' >/dev/null
tools/publish-android-release "$work/wear" --no-github >/dev/null
phone_url=$(jq -r .apps.phone.url "$releases/updates.json")
phone_sha=$(jq -r .apps.phone.sha256 "$releases/updates.json")
phone_size=$(jq -r .apps.phone.size "$releases/updates.json")
# Files the gateway must never serve, next to the published ones.
printf 'secret\n' >"$releases/notes.txt"
cp "$work/phone/release.json" "$releases/release.json"
printf 'partial\n' >"$releases/.publish-leftover"
ln -s /etc/passwd "$releases/lifeos-phone-9.9.9-99.apk"
mkdir -m 755 "$releases/lifeos-wear-9.9.9-98.apk"

# The gateway's template, its settings, server-names.envsh, and the
# modules' routes, as compose.yaml and infra/nginx/Dockerfile give them: the
# image renders the template into conf.d/default.conf when nginx starts.
template=$repo_root/infra/nginx/life-os.conf.template
gateway_args=(-e NGINX_ENTRYPOINT_QUIET_LOGS=1 -e NGINX_ENVSUBST_FILTER=^LIFE_OS_
  -e LIFE_OS_PUBLIC_HOSTNAME=lifeos.example.com -e LIFE_OS_GATEWAY_BIND_ADDRESS=127.0.0.1 -e LIFE_OS_MODULES=
  -e LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS=
  -v "$repo_root/infra/nginx/server-names.envsh:/docker-entrypoint.d/16-lifeos-server-names.envsh:ro"
  -v "$repo_root/infra/nginx/modules.envsh:/docker-entrypoint.d/17-lifeos-modules.envsh:ro"
  -v "$repo_root/infra/nginx/module-routes:/etc/nginx/lifeos/module-routes:ro")

printf '==> nginx -t\n'
docker run --rm "${gateway_args[@]}" -v "$template:/etc/nginx/templates/default.conf.template:ro" \
  "$image" nginx -t -q || fail "nginx -t failed"

# The Access variant: every client counts as arriving through Cloudflare's
# edge network, where the gateway requires Access's token.
sed '/^geo \$realip_remote_addr \$via_cloudflare {/,/^}/ s/default 0;/default 1;/' "$template" >"$work/access.conf.template"
! cmp -s "$template" "$work/access.conf.template" || fail "could not make the Access variant of the configuration"
# The stand-in Dashboard answers everything the gateway passes to it.
printf 'server { listen 3000; default_type text/plain; return 200 "dashboard\\n"; }\n' >"$work/dashboard.conf"

docker network create "$name" >/dev/null
docker run -d --rm --name "$name-dashboard" --network "$name" --network-alias dashboard \
  -v "$work/dashboard.conf:/etc/nginx/conf.d/default.conf:ro" "$image" >/dev/null
start() { # <container> <template>: base URL in $base
  docker run -d --rm --name "$1" --network "$name" -p 127.0.0.1::80 "${gateway_args[@]}" \
    -v "$2:/etc/nginx/templates/default.conf.template:ro" -v "$releases:/srv/android:ro" "$image" >/dev/null
  base="http://127.0.0.1:$(docker port "$1" 80/tcp | head -n 1 | sed 's/.*://')"
  for _ in $(seq 1 40); do
    curl --silent --output /dev/null "$base/android/updates" && return
    sleep 0.25
  done
  docker logs "$1" >&2
  fail "the gateway in $1 did not start"
}
get() { # <path> [curl options…]: status in $code, headers in $work/headers, body in $work/body
  local path=$1
  shift
  code=$(curl --silent --path-as-is --max-time 30 --output "$work/body" --dump-header "$work/headers" \
    --write-out '%{http_code}' "$@" "$base$path")
}
header() { grep -i "^$1:" "$work/headers" | head -n 1 | cut -d ' ' -f 2- | tr -d '\r'; }
expect() { # <path> <status> [curl options…]
  local path=$1 want=$2
  shift 2
  get "$path" "$@"
  [[ "$code" == "$want" ]] || { cat "$work/headers" "$work/body" >&2; fail "GET $path $*: $code, want $want"; }
}
expect_header() { # <name> <value>
  [[ "$(header "$1")" == "$2" ]] || { cat "$work/headers" >&2; fail "$1 is '$(header "$1")', want '$2'"; }
}

start "$name-gateway" "$template"

printf '==> The manifest\n'
for path in /android/updates /android/updates.json; do
  expect "$path" 200
  expect_header Content-Type application/json
  expect_header Cache-Control no-cache
  expect_header X-Content-Type-Options nosniff
  [[ -z "$(header Content-Disposition)" ]] || fail "$path is sent as an attachment"
  cmp -s "$work/body" "$releases/updates.json" || fail "$path is not updates.json"
done

printf '==> The page\n'
expect /android/ 200
expect_header Content-Type 'text/html; charset=utf-8'
expect_header Cache-Control no-cache
cmp -s "$work/body" "$releases/index.html" || fail "/android/ is not index.html"
grep -qF "href=\"$phone_url\"" "$work/body" || fail "the page does not link the phone APK"
expect /android 301
expect_header Location /android/

printf '==> The APKs\n'
expect "$phone_url" 200
expect_header Content-Type application/vnd.android.package-archive
expect_header Content-Disposition attachment
expect_header Cache-Control 'private, max-age=31536000, immutable'
expect_header Content-Length "$phone_size"
expect_header X-Content-Type-Options nosniff
expect_header X-Frame-Options SAMEORIGIN
[[ "$(sha256sum <"$work/body" | cut -d ' ' -f 1)" == "$phone_sha" ]] || fail "the phone APK did not arrive whole"
expect "$(jq -r .apps.wear.url "$releases/updates.json")" 200
expect_header Content-Type application/vnd.android.package-archive
expect "$phone_url" 206 --header 'Range: bytes=100-199'
[[ "$(stat -c %s "$work/body")" == 100 ]] || fail "a range request did not return the range"
expect "$phone_url" 200 --head

printf '==> Nothing else\n'
for path in /android/lifeos-phone-9.9.8-97.apk /android/index.html /android/release.json /android/notes.txt \
  /android/.publish-leftover /android/updates.json.bak /android/updates/ /android/lifeos-tablet-0.1.0-1.apk \
  "$phone_url.sha256" /android/missing/ /android/lifeos-wear-9.9.9-98.apk/; do
  expect "$path" 404
done
expect /android/lifeos-phone-9.9.9-99.apk 403
! grep -q 'root:' "$work/body" || fail "a symbolic link was followed"
for method in POST PUT DELETE PATCH OPTIONS; do
  expect /android/updates 405 --request "$method" --data '{}'
  expect "$phone_url" 405 --request "$method"
  expect /android/ 405 --request "$method"
done

printf '==> No way out of /srv/android\n'
for path in /android/../etc/passwd /android/%2e%2e/%2e%2e/etc/passwd /android/..%2f..%2f..%2fetc%2fpasswd \
  /android/lifeos-phone-..%2f..%2f..%2fetc%2fpasswd-1.apk /android/updates/../../../../etc/passwd \
  '/android/..\..\etc\passwd' /android/%252e%252e/etc/passwd; do
  get "$path"
  [[ "$code" != 200 || "$(cat "$work/body")" == dashboard ]] || fail "GET $path: 200 with a file"
  ! grep -q 'root:' "$work/body" || fail "GET $path read a file outside /srv/android"
done

printf '==> Behind Cloudflare Access like everything else\n'
start "$name-access" "$work/access.conf.template"
for path in /android/ /android/updates "$phone_url"; do
  expect "$path" 403
  expect "$path" 200 --header 'Cf-Access-Jwt-Assertion: token'
done

printf '\nandroid gateway: all checks passed\n'
