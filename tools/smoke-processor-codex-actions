#!/usr/bin/env bash
set -euo pipefail

# Writes are attributed to this script as a development tool, never to the
# owner (CONTRIBUTING.md, "Development tools and live data").
actor=(-H 'X-Life-OS-Actor: dev:smoke-processor-codex-actions')

# Opt-in, disposable proof that the deployed processor uses the authenticated
# local Codex CLI to route explicit Calendar and Finance captures. It does not
# call the processor directly or inject actions through the MCP service.
compose=(./tools/verify-compose)
cleanup() { "${compose[@]}" down --volumes --remove-orphans >/dev/null; }
trap cleanup EXIT

"${compose[@]}" up --detach --no-build
gateway=http://127.0.0.1:13001
# The owner's timezone as the stack runs it: date-only captures resolve in it.
zone=${LIFE_OS_TIMEZONE:-$(grep -m1 '^LIFE_OS_TIMEZONE=' .env 2>/dev/null | cut -d= -f2- || true)}
zone=${zone:-UTC}
for service in inbox calendar finance; do
  for _ in $(seq 1 60); do
    curl --fail --silent "$gateway/api/$service/ready" >/dev/null && break
    sleep 1
  done
  curl --fail --silent "$gateway/api/$service/ready" >/dev/null
done

stamp=$(date +%s)
calendar_title="P7 Codex calendar $stamp"
finance_note="P7 Codex finance $stamp"

capture() {
  local content=$1
  curl "${actor[@]}" --fail --silent -H 'content-type: application/json' \
    --data "$(jq -nc --arg content "$content" '{content:$content,source:"web",sourceMetadata:{verification:"p7-09-codex-actions"}}')" \
    "$gateway/api/inbox/v1/inbox-items" | jq -r '.id'
}

wait_for_action() {
  local item_id=$1 tool=$2
  for _ in $(seq 1 90); do
    attempts=$(curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$item_id/processing-attempts")
    if jq -e --arg tool "$tool" '.items | length == 1 and .[0].status == "processed" and (. [0].actions | length) == 1 and .[0].actions[0].tool == $tool' >/dev/null <<<"$attempts"; then
      return
    fi
    sleep 2
  done
  echo "Codex action smoke: $tool was not automatically processed for $item_id" >&2
  return 1
}

wait_for_human_review() {
  local item_id=$1
  for _ in $(seq 1 90); do
    item=$(curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$item_id")
    if jq -e '.state == "human_review"' >/dev/null <<<"$item"; then
      return
    fi
    sleep 2
  done
  echo "Codex action smoke: ambiguous capture did not reach Human Review for $item_id" >&2
  return 1
}

calendar_id=$(capture "Create an all-day calendar event titled $calendar_title on 2026-10-12.")
wait_for_action "$calendar_id" calendar_create
curl --fail --silent "$gateway/api/calendar/v1/events?from=2026-10-12T00:00:00Z&to=2026-10-13T00:00:00Z" | jq -e --arg title "$calendar_title" '.items | map(select(.title == $title)) | length == 1' >/dev/null

# Cash spending lands in the built-in Cash account (EUR), on the day named.
finance_id=$(capture "Spent 123 euros in cash at $finance_note on 2026-10-08.")
wait_for_action "$finance_id" finance_create_manual_transaction
cash_id=$(curl --fail --silent "$gateway/api/finance/v1/accounts" | jq -r '[.items[] | select(.builtIn)][0].id')
curl --fail --silent "$gateway/api/finance/v1/transactions?limit=100" | jq -e --arg note "$finance_note" --arg cash "$cash_id" '.items | map(select(.accountId == $cash and .amount.amount == -12300 and .amount.currency == "EUR" and .bookingDate == "2026-10-08" and (((.notes // "") + " " + (.counterparty // "") + " " + (.description // "")) | ascii_downcase | contains($note | ascii_downcase)))) | length == 1' >/dev/null

task_title="P8 Codex mutation $stamp"
task_id=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data "$(jq -nc --arg title "$task_title" '{title:$title}')" "$gateway/api/tasks/v1/tasks" | jq -r '.id')
mutation_id=$(capture "Mark the task titled $task_title as done.")
wait_for_action "$mutation_id" task_complete
curl --fail --silent "$gateway/api/tasks/v1/tasks/$task_id" | jq -e --arg title "$task_title" '.title == $title and .completed == true' >/dev/null

reopen_id=$(capture "Reopen the task titled $task_title.")
wait_for_action "$reopen_id" task_reopen
curl --fail --silent "$gateway/api/tasks/v1/tasks/$task_id" | jq -e --arg title "$task_title" '.title == $title and .completed == false' >/dev/null

update_title="P8 Codex update $stamp"
updated_title="P8 Codex updated $stamp"
update_task_id=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data "$(jq -nc --arg title "$update_title" '{title:$title}')" "$gateway/api/tasks/v1/tasks" | jq -r '.id')
update_id=$(capture "Rename the task titled $update_title to $updated_title.")
wait_for_action "$update_id" task_update
curl --fail --silent "$gateway/api/tasks/v1/tasks/$update_task_id" | jq -e --arg title "$updated_title" '.title == $title and .completed == false' >/dev/null

reschedule_id=$(capture "Set the due date for the task titled $updated_title to October 14, 2026.")
wait_for_action "$reschedule_id" task_update
# "2026-10-14" is the owner's local date (LIFE_OS_TIMEZONE); compare in that zone.
due=$(curl --fail --silent "$gateway/api/tasks/v1/tasks/$update_task_id" | jq -r '.dueAt')
[ "$(TZ="$zone" date -d "$due" +%F)" = 2026-10-14 ] || {
  echo "Codex action smoke: rescheduled dueAt $due is not 2026-10-14 in the owner's timezone" >&2
  exit 1
}

clear_date_id=$(capture "Clear the due date for the task titled $updated_title.")
wait_for_action "$clear_date_id" task_update
curl --fail --silent "$gateway/api/tasks/v1/tasks/$update_task_id" | jq -e '.dueAt == null' >/dev/null

ambiguous_title="P8 Codex ambiguous $stamp"
ambiguous_task_a=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data "$(jq -nc --arg title "$ambiguous_title" '{title:$title}')" "$gateway/api/tasks/v1/tasks" | jq -r '.id')
ambiguous_task_b=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data "$(jq -nc --arg title "$ambiguous_title" '{title:$title}')" "$gateway/api/tasks/v1/tasks" | jq -r '.id')
ambiguous_id=$(capture "Mark the task titled $ambiguous_title as done.")
wait_for_human_review "$ambiguous_id"
# Ambiguity waits for the user with both Tasks as candidates (Phase 8).
curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$ambiguous_id" |
  jq -e --arg a "$ambiguous_task_a" --arg b "$ambiguous_task_b" \
    '.resolvedAt == null and ([.processingMetadata.humanReview.candidates[].id] | contains([$a, $b]))' >/dev/null
curl --fail --silent "$gateway/api/tasks/v1/tasks/$ambiguous_task_a" | jq -e '.completed == false' >/dev/null
curl --fail --silent "$gateway/api/tasks/v1/tasks/$ambiguous_task_b" | jq -e '.completed == false' >/dev/null

echo "authenticated Codex Calendar, Finance, and Task mutation/ambiguity capture smoke passed"
