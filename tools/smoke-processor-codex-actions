#!/usr/bin/env bash
set -euo pipefail

# Writes are attributed to this script as a development tool, never to the
# owner (CONTRIBUTING.md, "Development tools and live data").
actor=(-H 'X-Life-OS-Actor: dev:smoke-processor-codex-actions')

# Opt-in, disposable proof that the deployed processor uses the authenticated
# local Codex CLI to route explicit Calendar, Finance, grocery, running-low,
# meal, and recipe link captures. It does not call the processor directly or inject
# actions through the MCP service.
compose=(./tools/verify-compose)
# The recipe page a capture links to, served at http://ics-fixture/ by the
# browser tests' verify-only overlay, which lets recipe-import fetch it.
pages=$(mktemp -d)
chmod 755 "$pages"
export LIFE_OS_E2E_ICS_DIR=$pages
export LIFE_OS_VERIFY_OVERLAYS=${LIFE_OS_VERIFY_OVERLAYS:+$LIFE_OS_VERIFY_OVERLAYS:}tools/fixtures/calendar-ics.compose.yaml
cleanup() {
  "${compose[@]}" down --volumes --remove-orphans >/dev/null
  rm -rf "$pages"
}
trap cleanup EXIT
cat >"$pages/smoke-pilaf.html" <<'HTML'
<!doctype html>
<html><head><title>Smoke Pilaf</title>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Recipe","name":"Smoke Pilaf","recipeIngredient":["300 g Reis","1 Karotte"],"recipeInstructions":["Reis waschen.","Alles zusammen garen."]}</script>
</head><body></body></html>
HTML
chmod 644 "$pages/smoke-pilaf.html"

"${compose[@]}" up --detach --no-build
gateway=http://127.0.0.1:13001
# The owner's timezone as the stack runs it: date-only captures resolve in it.
zone=${LIFE_OS_TIMEZONE:-$(grep -m1 '^LIFE_OS_TIMEZONE=' .env 2>/dev/null | cut -d= -f2- || true)}
zone=${zone:-UTC}
for service in inbox calendar finance food integrations/recipe-import; do
  for _ in $(seq 1 60); do
    curl --fail --silent "$gateway/api/$service/ready" >/dev/null && break
    sleep 1
  done
  curl --fail --silent "$gateway/api/$service/ready" >/dev/null
done

stamp=$(date +%s)
calendar_title="P7 Codex calendar $stamp"
finance_note="P7 Codex finance $stamp"

capture() {
  local content=$1
  curl "${actor[@]}" --fail --silent -H 'content-type: application/json' \
    --data "$(jq -nc --arg content "$content" '{content:$content,source:"web",sourceMetadata:{verification:"p7-09-codex-actions"}}')" \
    "$gateway/api/inbox/v1/inbox-items" | jq -r '.id'
}

wait_for_action() {
  local item_id=$1 tool=$2
  for _ in $(seq 1 90); do
    attempts=$(curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$item_id/processing-attempts")
    if jq -e --arg tool "$tool" '.items | length == 1 and .[0].status == "processed" and (. [0].actions | length) == 1 and .[0].actions[0].tool == $tool' >/dev/null <<<"$attempts"; then
      return
    fi
    sleep 2
  done
  echo "Codex action smoke: $tool was not automatically processed for $item_id" >&2
  return 1
}

wait_for_human_review() {
  local item_id=$1
  for _ in $(seq 1 90); do
    item=$(curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$item_id")
    if jq -e '.state == "human_review"' >/dev/null <<<"$item"; then
      return
    fi
    sleep 2
  done
  echo "Codex action smoke: ambiguous capture did not reach Human Review for $item_id" >&2
  return 1
}

calendar_id=$(capture "Create an all-day calendar event titled $calendar_title on 2026-10-12.")
wait_for_action "$calendar_id" calendar_create
curl --fail --silent "$gateway/api/calendar/v1/events?from=2026-10-12T00:00:00Z&to=2026-10-13T00:00:00Z" | jq -e --arg title "$calendar_title" '.items | map(select(.title == $title)) | length == 1' >/dev/null

# Cash spending lands in the built-in Cash account (EUR), on the day named.
finance_id=$(capture "Spent 123 euros in cash at $finance_note on 2026-10-08.")
wait_for_action "$finance_id" finance_create_manual_transaction
cash_id=$(curl --fail --silent "$gateway/api/finance/v1/accounts" | jq -r '[.items[] | select(.builtIn)][0].id')
curl --fail --silent "$gateway/api/finance/v1/transactions?limit=100" | jq -e --arg note "$finance_note" --arg cash "$cash_id" '.items | map(select(.accountId == $cash and .amount.amount == -12300 and .amount.currency == "EUR" and .bookingDate == "2026-10-08" and (((.notes // "") + " " + (.counterparty // "") + " " + (.description // "")) | ascii_downcase | contains($note | ascii_downcase)))) | length == 1' >/dev/null

# Groceries go on the shopping list, once, marked as coming from the capture.
oat_milk() {
  curl --fail --silent "$gateway/api/food/v1/shopping-items?state=needed&limit=200" | jq -c '[.items[] | select(.normalizedName == "oat milk")]'
}
grocery_id=$(capture "Buy oat milk.")
wait_for_action "$grocery_id" food_add_shopping_items
jq -e --arg ref "$grocery_id" 'length == 1 and .[0].source == "capture" and .[0].sourceRef == $ref' >/dev/null <<<"$(oat_milk)"
# Replaying the processor's write, as after a crash before its outcome was
# recorded, returns the first answer: its key reached Food. The body is the
# one MCP sent for the planned items (trimmed, blank fields left out, marked
# as from the capture; Go writes object keys sorted).
grocery_action=$(curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$grocery_id/processing-attempts" | jq -c '.items[0].actions[0]')
grocery_body=$(jq -cS '.arguments as $a | {items: [$a.items[] | with_entries(.value |= (if type == "string" then gsub("^\\s+|\\s+$"; "") else . end)) | with_entries(select(.value != null and .value != "")) | . + {source: "capture", sourceRef: $a.sourceRef}]}' <<<"$grocery_action")
replayed=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' -H "Idempotency-Key: $(jq -r '.arguments.idempotencyKey' <<<"$grocery_action")" --data "$grocery_body" "$gateway/api/food/v1/shopping-items")
jq -e --arg id "$(jq -r '.result.items[0].item.id' <<<"$grocery_action")" '.items[0].item.id == $id and .items[0].merged == false' >/dev/null <<<"$replayed"
jq -e 'length == 1' >/dev/null <<<"$(oat_milk)"
# The same capture again is planned again: it merges into that item.
grocery_again_id=$(capture "Buy oat milk.")
wait_for_action "$grocery_again_id" food_add_shopping_items
curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$grocery_again_id/processing-attempts" | jq -e '.items[0].actions[0].result.items[0].merged == true' >/dev/null
jq -e --arg ref "$grocery_id" 'length == 1 and .[0].sourceRef == $ref' >/dev/null <<<"$(oat_milk)" || {
  echo "Codex action smoke: the repeated grocery capture duplicated the list item: $(oat_milk)" >&2
  exit 1
}

# Something running low that is a staple goes back on the list by itself,
# once, as the staple's item (not the capture's): the processor names the
# staple and adds nothing of its own.
mustard_staple=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data '{"name":"Mustard"}' "$gateway/api/food/v1/staples" | jq -r '.id')
low_id=$(capture "We're almost out of mustard.")
wait_for_action "$low_id" food_mark_running_low
curl --fail --silent "$gateway/api/food/v1/shopping-items?state=needed&limit=200" |
  jq -e --arg staple "$mustard_staple" '[.items[] | select(.normalizedName == "mustard")] | length == 1 and .[0].source == "staple" and .[0].sourceRef == $staple' >/dev/null || {
  echo "Codex action smoke: the running-low staple is not on the list once as the staple's item" >&2
  exit 1
}
# A meal is planned once, with the recipe its words name, in the slot it
# says; replaying the processor's write returns the first answer. The body
# is the one MCP sent: the planned arguments but the slot's date and slot,
# trimmed, blank fields left out (Go writes object keys sorted).
porridge_id=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data '{"title":"Oat porridge","ingredients":[{"name":"Oats","amount":"80 g"}]}' "$gateway/api/food/v1/recipes" | jq -r '.id')
breakfasts() {
  curl --fail --silent "$gateway/api/food/v1/meal-plan?from=2026-10-14&to=2026-10-14" | jq -c '[.items[] | select(.slot == "breakfast")]'
}
meal_id=$(capture "Oat porridge for breakfast on 2026-10-14.")
wait_for_action "$meal_id" food_plan_meal
jq -e --arg recipe "$porridge_id" 'length == 1 and .[0].recipeId == $recipe' >/dev/null <<<"$(breakfasts)"
meal_action=$(curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$meal_id/processing-attempts" | jq -c '.items[0].actions[0]')
meal_body=$(jq -cS '.arguments | del(.date, .slot, .idempotencyKey) | with_entries(.value |= (if type == "string" then gsub("^\\s+|\\s+$"; "") else . end)) | with_entries(select(.value != null and .value != ""))' <<<"$meal_action")
replayed=$(curl "${actor[@]}" --fail --silent -X PUT -H 'content-type: application/json' -H "Idempotency-Key: $(jq -r '.arguments.idempotencyKey' <<<"$meal_action")" --data "$meal_body" "$gateway/api/food/v1/meal-plan/2026-10-14/breakfast")
jq -e --arg id "$(jq -r '.result.id' <<<"$meal_action")" '.id == $id' >/dev/null <<<"$replayed"
jq -e 'length == 1' >/dev/null <<<"$(breakfasts)" || {
  echo "Codex action smoke: the replayed meal changed the plan: $(breakfasts)" >&2
  exit 1
}

# A recipe link is saved once, from the page's recipe data, with the link as
# its source. Replaying the processor's save (the link alone, as MCP sends it
# for a recipe page, with its key) returns the same recipe, and the link
# captured again finds it saved.
recipe_link=http://ics-fixture/smoke-pilaf.html
pilafs() {
  curl --fail --silent "$gateway/api/food/v1/recipes?q=pilaf&limit=200" | jq -c --arg link "$recipe_link" '[.items[] | select(.sourceUrl == $link)]'
}
recipe_capture=$(capture "Save this recipe: $recipe_link")
wait_for_action "$recipe_capture" recipe_import
jq -e 'length == 1 and (.[0].ingredients | length) == 2' >/dev/null <<<"$(pilafs)"
recipe_action=$(curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$recipe_capture/processing-attempts" | jq -c '.items[0].actions[0]')
jq -e '.arguments.title == null and .result.saved == true' >/dev/null <<<"$recipe_action"
replayed=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' -H "Idempotency-Key: $(jq -r '.arguments.idempotencyKey' <<<"$recipe_action")" --data "$(jq -cn --arg url "$recipe_link" '{url: $url}')" "$gateway/api/integrations/recipe-import/v1/imports")
jq -e --arg id "$(jq -r '.result.recipeId' <<<"$recipe_action")" '.recipe.id == $id' >/dev/null <<<"$replayed"
recipe_again=$(capture "Save this recipe: $recipe_link")
wait_for_action "$recipe_again" recipe_import
curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$recipe_again/processing-attempts" | jq -e --arg id "$(jq -r '.result.recipeId' <<<"$recipe_action")" '.items[0].actions[0].result | .alreadySaved == true and .recipeId == $id' >/dev/null
jq -e 'length == 1' >/dev/null <<<"$(pilafs)" || {
  echo "Codex action smoke: the recipe link was saved more than once: $(pilafs)" >&2
  exit 1
}

task_title="P8 Codex mutation $stamp"
task_id=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data "$(jq -nc --arg title "$task_title" '{title:$title}')" "$gateway/api/tasks/v1/tasks" | jq -r '.id')
mutation_id=$(capture "Mark the task titled $task_title as done.")
wait_for_action "$mutation_id" task_complete
curl --fail --silent "$gateway/api/tasks/v1/tasks/$task_id" | jq -e --arg title "$task_title" '.title == $title and .completed == true' >/dev/null

reopen_id=$(capture "Reopen the task titled $task_title.")
wait_for_action "$reopen_id" task_reopen
curl --fail --silent "$gateway/api/tasks/v1/tasks/$task_id" | jq -e --arg title "$task_title" '.title == $title and .completed == false' >/dev/null

update_title="P8 Codex update $stamp"
updated_title="P8 Codex updated $stamp"
update_task_id=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data "$(jq -nc --arg title "$update_title" '{title:$title}')" "$gateway/api/tasks/v1/tasks" | jq -r '.id')
update_id=$(capture "Rename the task titled $update_title to $updated_title.")
wait_for_action "$update_id" task_update
curl --fail --silent "$gateway/api/tasks/v1/tasks/$update_task_id" | jq -e --arg title "$updated_title" '.title == $title and .completed == false' >/dev/null

reschedule_id=$(capture "Set the due date for the task titled $updated_title to October 14, 2026.")
wait_for_action "$reschedule_id" task_update
# "2026-10-14" is the owner's local date (LIFE_OS_TIMEZONE); compare in that zone.
due=$(curl --fail --silent "$gateway/api/tasks/v1/tasks/$update_task_id" | jq -r '.dueAt')
[ "$(TZ="$zone" date -d "$due" +%F)" = 2026-10-14 ] || {
  echo "Codex action smoke: rescheduled dueAt $due is not 2026-10-14 in the owner's timezone" >&2
  exit 1
}

clear_date_id=$(capture "Clear the due date for the task titled $updated_title.")
wait_for_action "$clear_date_id" task_update
curl --fail --silent "$gateway/api/tasks/v1/tasks/$update_task_id" | jq -e '.dueAt == null' >/dev/null

ambiguous_title="P8 Codex ambiguous $stamp"
ambiguous_task_a=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data "$(jq -nc --arg title "$ambiguous_title" '{title:$title}')" "$gateway/api/tasks/v1/tasks" | jq -r '.id')
ambiguous_task_b=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' --data "$(jq -nc --arg title "$ambiguous_title" '{title:$title}')" "$gateway/api/tasks/v1/tasks" | jq -r '.id')
ambiguous_id=$(capture "Mark the task titled $ambiguous_title as done.")
wait_for_human_review "$ambiguous_id"
# Ambiguity waits for the user with both Tasks as candidates (Phase 8).
curl --fail --silent "$gateway/api/inbox/v1/inbox-items/$ambiguous_id" |
  jq -e --arg a "$ambiguous_task_a" --arg b "$ambiguous_task_b" \
    '.resolvedAt == null and ([.processingMetadata.humanReview.candidates[].id] | contains([$a, $b]))' >/dev/null
curl --fail --silent "$gateway/api/tasks/v1/tasks/$ambiguous_task_a" | jq -e '.completed == false' >/dev/null
curl --fail --silent "$gateway/api/tasks/v1/tasks/$ambiguous_task_b" | jq -e '.completed == false' >/dev/null

echo "authenticated Codex Calendar, Finance, grocery, running-low staple, meal, recipe link, and Task mutation/ambiguity capture smoke passed"
