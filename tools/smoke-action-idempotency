#!/usr/bin/env bash
set -euo pipefail

# Writes are attributed to this script as a development tool, never to the
# owner (CONTRIBUTING.md, "Development tools and live data").
actor=(-H 'X-Life-OS-Actor: dev:smoke-action-idempotency')

# Exercises the durable owner boundary used to recover from a processor crash
# after an owner has committed, but before Inbox attempt bookkeeping succeeds.
# It deliberately discards each first response and replays the exact request.
compose=(./tools/verify-compose)
cleanup() { "${compose[@]}" down --volumes --remove-orphans >/dev/null; }
trap cleanup EXIT

"${compose[@]}" up --detach --no-build
gateway=http://127.0.0.1:13001

wait_ready() {
  local url=$1
  for _ in $(seq 1 45); do
    curl --fail --silent "$url/ready" >/dev/null && return
    sleep 1
  done
  echo "idempotency smoke: service not ready: $url" >&2
  return 1
}
for service in "$gateway/api/tasks" "$gateway/api/calendar" "$gateway/api/finance"; do
  wait_ready "$service"
done

replay() {
  local endpoint=$1 key=$2 body=$3
  local first second first_id second_id
  first=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' -H "Idempotency-Key: $key" -d "$body" "$endpoint")
  # The processor's successful owner response has been lost at this point.
  second=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' -H "Idempotency-Key: $key" -d "$body" "$endpoint")
  first_id=$(jq -r '.id' <<<"$first")
  second_id=$(jq -r '.id' <<<"$second")
  [[ "$first_id" != null && "$first_id" == "$second_id" ]] || {
    echo "idempotency smoke: replay produced a different record for $endpoint" >&2
    return 1
  }
}

stamp=$(date +%s)
replay "$gateway/api/tasks/v1/tasks" "p7-task-$stamp" "{\"title\":\"P7 task crash replay $stamp\"}"
replay "$gateway/api/calendar/v1/events" "p7-event-$stamp" "{\"title\":\"P7 event crash replay $stamp\",\"allDay\":true,\"startDate\":\"2026-10-08\",\"endDate\":\"2026-10-08\"}"

# A Finance account for this run, through Finance's public API.
account_id=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' -d "{\"name\":\"P7 idempotency smoke $stamp\",\"kind\":\"other\",\"currency\":\"USD\"}" "$gateway/api/finance/v1/accounts" | jq -r '.id')
replay "$gateway/api/finance/v1/transactions" "p7-finance-$stamp" "{\"accountId\":\"$account_id\",\"amount\":{\"amount\":-125,\"currency\":\"USD\"},\"bookingDate\":\"2026-10-08\",\"notes\":\"P7 finance crash replay\"}"
# Cash spending needs no account.
replay "$gateway/api/finance/v1/transactions" "p7-cash-$stamp" "{\"amount\":{\"amount\":-300,\"currency\":\"EUR\"},\"counterparty\":\"P7 cash replay\"}"

echo "action idempotency crash-replay smoke passed"
