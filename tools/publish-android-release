#!/usr/bin/env bash
set -Eeuo pipefail

# Publishes a build of the Android apps at the gateway's /android/ and as a
# GitHub Release of the app repository (docs/operations/android-releases.md):
#
#   tools/publish-android-release <release-dir> [--notes "…"] [--force] [--no-github] [--dry-run]
#
# <release-dir> is what the app repository's build writes: release.json and
# the APKs it describes, lifeos-<app>-<versionName>-<versionCode>.apk for
# the phone and the watch (wear). Before it changes anything, the script
# checks release.json (every field of each app, and a versionCode newer than
# the published one: a downgrade, or the same versionCode with other bytes,
# is refused unless --force; so is a -dirty build) and every APK (present, with the size and
# SHA-256 release.json gives). It then copies the APKs into the releases
# directory and writes updates.json (the manifest the app checks) and
# index.html (the download page), each through a temporary file renamed
# into place: readers see the old file or the new one, and an interrupted
# publish leaves the old manifest. It keeps the newest 5 versions of each
# app, deletes older APKs, and prints what it did. The notes go with every
# app it publishes. Run again with the same release, it publishes nothing
# and only rewrites the page and finishes the pruning.
#
# The GitHub step (P20-06), after the server's: the same APKs and an
# updates.json for them, as the release v<versionName>-<versionCode> of
# LIFE_OS_ANDROID_GITHUB_REPO (by default GAMch1k/life-os-app; off turns the
# step off), made with gh as a draft, then published as the latest. Apps not
# connected to the owner's server update from there. It needs both apps of
# one build from a commit that is on GitHub, never a -dirty one, and a
# versionCode above the latest GitHub release's (--force allows a lower one).
# It checks all of that, read-only, before anything changes here or there.
# The release with the same APKs already there is not an error; run again
# after a GitHub failure, the script publishes nothing here and finishes the
# release. Only signed APKs are uploaded: the signing key stays where the
# build ran. --no-github skips the step for this run.
#
# --dry-run checks everything (GitHub too, read-only) and prints what a
# publish would do, without changing anything.
#
# The releases directory is LIFE_OS_ANDROID_RELEASES_DIR (the environment,
# else .env), else ~/life-os.android, as for the gateway's mount. It must
# exist, be writable by whoever runs this (its owner: never root), and be
# readable by everyone (the gateway's nginx).
#
# Exit status: 0 published (or nothing new), 2 refused (nothing changed),
# 1 failed.

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
usage='usage: tools/publish-android-release <release-dir> [--notes "…"] [--force] [--no-github] [--dry-run]'
keep=5
url_prefix=/android/
default_github_repo=GAMch1k/life-os-app

refuse() {
  printf 'publish-android-release: %s\n' "$*" >&2
  exit 2
}
fail() {
  printf 'publish-android-release: %s\n' "$*" >&2
  exit 1
}

release_arg='' notes='' force=false github=true dry_run=false
while (($#)); do
  case "$1" in
    --notes)
      (($# >= 2)) || refuse "--notes needs a text"
      notes=$2
      shift
      ;;
    --notes=*) notes=${1#--notes=} ;;
    --force) force=true ;;
    --no-github) github=false ;;
    --dry-run) dry_run=true ;;
    -h | --help)
      printf '%s\n' "$usage"
      exit 0
      ;;
    -*) refuse "unknown option $1" ;;
    *) [[ -z "$release_arg" ]] || refuse "too many arguments"; release_arg=$1 ;;
  esac
  shift
done
[[ -n "$release_arg" ]] || refuse "$usage"
(($(id -u) != 0)) || refuse "run it as the releases directory's owner, not as root"
for command in jq sha256sum flock; do
  command -v "$command" >/dev/null 2>&1 || refuse "$command is required"
done
release_dir=$(realpath -e -- "$release_arg" 2>/dev/null) && [[ -d "$release_dir" ]] ||
  refuse "$release_arg is not a directory"
cd "$repo_root"

# Settings from the environment, else from .env, as Compose reads them.
# shellcheck source=tools/lib/settings.bash
. tools/lib/settings.bash

dir=$(setting LIFE_OS_ANDROID_RELEASES_DIR)
dir=${dir:-${HOME:-}/life-os.android}
[[ -d "$dir" ]] || refuse "the releases directory $dir does not exist: create it with install -d -m 755 $dir"
[[ -w "$dir" ]] || refuse "the releases directory $dir is not writable by $(id -un) (if Docker created it for the gateway, it belongs to root: sudo chown $(id -u):$(id -g) $dir)"
[[ -n "$(find "$dir" -maxdepth 0 -perm -o=rx)" ]] || refuse "the gateway cannot read $dir: chmod 755 $dir"
dir=$(realpath -e -- "$dir")
[[ "$dir" != "$release_dir" ]] || refuse "the release directory is the releases directory itself"
# The page shows times in the owner's zone (and the browser's, once loaded).
zone=$(setting LIFE_OS_TIMEZONE)
zone=${zone:-Europe/Berlin}

# One publish at a time; a publish killed midway left only temporary files.
exec 9<"$dir"
flock --nonblock 9 || refuse "another publish to $dir is running"
[[ "$dry_run" == true ]] || find "$dir" -maxdepth 1 -type f -name '.publish-*' -delete
temps=()
# Scratch space for the GitHub step (its manifest, notes, gh's answers).
scratch=$(mktemp -d)
trap 'rm -f -- "${temps[@]}"; rm -rf -- "$scratch"' EXIT
trap 'printf "publish-android-release: failed (line %s)\n" "$LINENO" >&2; exit 1' ERR

# The release. The one place where release.json's names map to the
# contract's: the apps may sit under "apps" or at the top level, and only
# phone and wear count. The app's tools/build writes the commit as
# "gitCommit". Map other spellings here if the build ever writes them.
release_file=$release_dir/release.json
[[ -f "$release_file" ]] || refuse "$release_file is missing"
release=$(jq -c '
  (if type == "object" and has("apps") then .apps else . end)
  | if type == "object" then . else error("not an object") end
  | {phone, wear}
  | with_entries(select(.value != null))
  | map_values(if type == "object" then {versionCode, versionName, minSdk, sha256, size, builtAt, commit: (.commit // .gitCommit)} else . end)
' "$release_file" 2>/dev/null) || refuse "$release_file is not a JSON object"
[[ "$release" != '{}' ]] || refuse "$release_file describes neither phone nor wear"
problems=$(jq -r '
  def count: type == "number" and . == floor and . >= 1;
  to_entries[] | .key as $app | .value
  | if type != "object" then "\($app) must be an object" else
      (if .versionCode | count and . <= 2100000000 then empty
       else "\($app).versionCode must be a whole number from 1 to 2100000000" end),
      (if .versionName | type == "string" and test("^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$") then empty
       else "\($app).versionName must be 1 to 64 letters, digits, dots, _, +, or -, starting with a letter or digit" end),
      (if .minSdk | count then empty else "\($app).minSdk must be a whole number from 1" end),
      (if .sha256 | type == "string" and test("^[0-9a-f]{64}$") then empty
       else "\($app).sha256 must be 64 lowercase hexadecimal digits" end),
      (if .size | count then empty else "\($app).size must be a whole number of bytes" end),
      (if .builtAt | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$") then empty
       else "\($app).builtAt must be an RFC 3339 time such as 2026-10-12T10:00:00Z" end),
      (if .commit | type == "string" and test("^[0-9A-Za-z._+-]{1,64}$") then empty
       else "\($app).commit must be 1 to 64 letters, digits, dots, _, +, or -" end)
    end
' <<<"$release")
[[ -z "$problems" ]] || refuse "$release_file is not a valid release:"$'\n'"$problems"
# A build from a tree with uncommitted changes (the app build marks its
# commit "-dirty") cannot be traced to a commit: refused unless --force.
dirty=$(jq -r 'to_entries[] | select(.value.commit | endswith("-dirty")) | .key' <<<"$release")
[[ -z "$dirty" || "$force" == true ]] || refuse "the $(tr '\n' ' ' <<<"$dirty")build came from uncommitted changes (commit ends in -dirty): commit and rebuild, or pass --force"

# The published manifest, if any.
manifest=$dir/updates.json
published='{"apps": {}}'
if [[ -e "$manifest" ]]; then
  published=$(jq -c '
    if type == "object" and (.apps | type) == "object"
      and all(.apps[]; (.versionCode | type) == "number" and .versionCode == (.versionCode | floor)
        and (.sha256 | type) == "string" and (.url | type) == "string")
    then . else error("not a manifest") end
  ' "$manifest" 2>/dev/null) ||
    refuse "the published manifest $manifest is unreadable: repair it, or remove it to start over (the next publish then deletes the APKs it no longer lists)"
fi

# Every APK, and the decision per app, before anything changes.
declare -A file sha
apps=() publish=() unchanged=()
mapfile -t apps < <(jq -r 'keys_unsorted[]' <<<"$release")
for app in "${apps[@]}"; do
  IFS=$'\t' read -r name code digest size < <(jq -r --arg app "$app" '.[$app] | [.versionName, .versionCode, .sha256, .size] | @tsv' <<<"$release")
  file[$app]="lifeos-$app-$name-$code.apk"
  sha[$app]=$digest
  source="$release_dir/${file[$app]}"
  [[ -f "$source" ]] || refuse "$app: ${file[$app]} is not in $release_dir"
  actual=$(stat -L -c %s -- "$source")
  [[ "$actual" == "$size" ]] || refuse "$app: ${file[$app]} is $actual bytes, release.json says $size"
  actual=$(sha256sum <"$source" | cut -d ' ' -f 1)
  [[ "$actual" == "${sha[$app]}" ]] || refuse "$app: the SHA-256 of ${file[$app]} is $actual, release.json says ${sha[$app]}"

  IFS=$'\t' read -r current_code current_sha current_name < <(jq -r --arg app "$app" '.apps[$app] // {} | [.versionCode // 0, .sha256 // "", .versionName // ""] | @tsv' <<<"$published")
  if ((code > current_code)); then
    publish+=("$app")
  elif ((code == current_code)) && [[ "${sha[$app]}" == "$current_sha" ]]; then
    unchanged+=("$app")
  elif [[ "$force" == true ]]; then
    publish+=("$app")
  elif ((code == current_code)); then
    refuse "$app: versionCode $code is already published with a different APK; build it with a higher versionCode (or publish it anyway with --force)"
  else
    refuse "$app: versionCode $code ($name) is older than the published $current_code ($current_name); refusing a downgrade (--force publishes it anyway)"
  fi
done

# The manifest. A published app's former entry moves to the front of its
# "previous" list, which keeps the 4 before it.
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
updated=$(jq -n --argjson old "$published" --argjson release "$release" \
  --arg now "$now" --arg notes "$notes" --arg prefix "$url_prefix" --argjson keep "$keep" '
  $ARGS.positional as $publish
  | reduce $publish[] as $app ($old.apps;
      .[$app] as $current
      | $release[$app] as $r
      | ($prefix + "lifeos-\($app)-\($r.versionName)-\($r.versionCode).apk") as $url
      | .[$app] = {versionCode: $r.versionCode, versionName: $r.versionName, minSdk: $r.minSdk, sha256: $r.sha256,
          size: $r.size, url: $url, publishedAt: $now, builtAt: $r.builtAt, commit: $r.commit, notes: $notes,
          previous: ((if $current then [$current | del(.previous)] + ($current.previous // []) else [] end)
            | map(select(.url != $url)) | .[:$keep - 1])})
  | {formatVersion: 1,
     updatedAt: (if ($publish | length) > 0 then $now else ($old.updatedAt // $now) end),
     apps: ({phone, wear} | with_entries(select(.value != null)))}
' --args "${publish[@]}")

# The download page, from the new manifest; written every time.
times='{}'
while IFS= read -r at; do
  times=$(jq -c --arg at "$at" --arg shown "$(TZ=$zone date -d "$at" '+%-d %B %Y, %H:%M %Z')" '.[$at] = $shown' <<<"$times")
done < <(jq -r '[.apps[] | .publishedAt, .previous[]?.publishedAt] | unique[]' <<<"$updated")
# shellcheck disable=SC2016 # jq's $v, not the shell's
jq_android='def android: (if . >= 26 and . <= 36 then {"26":"8.0","27":"8.1","28":"9","29":"10","30":"11","31":"12","32":"12L","33":"13","34":"14","35":"15","36":"16"}[tostring] else null end) as $v
  | if $v then "Android \($v) or newer" else "Android API level \(.) or newer" end;'
page_program=$jq_android$'\n'$(cat <<'JQ'
def mb: if . < 1000000 then "\(. / 1000 | ceil) kB" else "\(. / 100000 | round / 10) MB" end;
def when: @html "<time datetime=\"\(.)\">\($times[.] // .)</time>";
def facts: @html "Version \(.versionName) (\(.versionCode)) · \(.size | mb) · \(.minSdk | android) · published " + (.publishedAt | when);
def notes: if (.notes // "") != "" then @html "<p>\(.notes)</p>" else "" end;
def app_name: {phone: "Phone", wear: "Watch"}[.];
.apps as $apps
| [
  "<!doctype html>",
  "<html lang=\"en\">",
  "<head>",
  "<meta charset=\"utf-8\">",
  "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
  "<meta name=\"robots\" content=\"noindex\">",
  "<title>Life OS for Android</title>",
  "<style>",
  ":root { color-scheme: light dark; font-family: system-ui, sans-serif; line-height: 1.5; }",
  "body { max-width: 36rem; margin: 2rem auto; padding: 0 1rem; }",
  ".download { display: block; padding: 1rem; border-radius: 0.75rem; background: #2563eb; color: #fff; text-align: center; font-size: 1.25rem; font-weight: 600; text-decoration: none; }",
  ".meta { opacity: 0.75; font-size: 0.875rem; }",
  "code { overflow-wrap: anywhere; }",
  "</style>",
  "</head>",
  "<body>",
  "<h1>Life OS for Android</h1>",
  (if $apps.phone then $apps.phone | (
    @html "<p><a class=\"download\" href=\"\(.url)\">Download Life OS \(.versionName)</a></p>",
    "<p class=\"meta\">" + facts + "</p>",
    notes,
    @html "<p class=\"meta\">SHA-256 <code>\(.sha256)</code></p>"
  ) else "<p>No phone build has been published yet.</p>" end),
  "<h2>First install</h2>",
  "<ol>",
  "<li>Open this page on the phone and tap <strong>Download</strong>.</li>",
  "<li>Open the downloaded file. The first time, Android asks to allow installing apps from this browser (<em>Install unknown apps</em>): allow it, then tap <strong>Install</strong>.</li>",
  "<li>From then on the app finds its updates itself, in <a href=\"/android/updates\">the manifest</a>. Android installs an update only when it is signed with the same key as the installed app.</li>",
  "</ol>",
  "<h2>Watch</h2>",
  (if $apps.wear then $apps.wear | (
    @html "<p><a href=\"\(.url)\">Life OS for Wear OS \(.versionName)</a></p>",
    "<p class=\"meta\">" + facts + "</p>",
    notes,
    @html "<p class=\"meta\">Install it on the watch with wireless debugging on (Developer options): <code>adb install \(.url | ltrimstr("/android/"))</code>. SHA-256 <code>\(.sha256)</code></p>"
  ) else "<p>No watch build has been published yet.</p>" end),
  ([$apps | to_entries[] | .key as $app | .value.previous[]? | . + {app: $app}] as $older
   | if ($older | length) > 0 then
       "<h2>Older versions</h2>",
       "<p class=\"meta\">Kept for reference: Android does not install an older version over a newer one.</p>",
       "<ul>",
       ($older[] | "<li>" + (@html "<a href=\"\(.url)\">\(.app | app_name) \(.versionName) (\(.versionCode))</a> · \(.size | mb) · published ") + (.publishedAt | when) + "</li>"),
       "</ul>"
     else empty end),
  "<script>",
  "for (const time of document.querySelectorAll(\"time[datetime]\")) {",
  "  time.textContent = new Date(time.dateTime).toLocaleString(undefined, { day: \"numeric\", month: \"long\", year: \"numeric\", hour: \"2-digit\", minute: \"2-digit\", timeZoneName: \"short\" });",
  "}",
  "</script>",
  "</body>",
  "</html>"
] | map(select(. != "")) | join("\n")
JQ
)
page=$(jq -r --argjson times "$times" "$page_program" <<<"$updated")

# The GitHub Release (P20-06), planned and checked read-only before
# anything changes, here or on GitHub. $github_action ends up create
# (a draft with the APKs and updates.json, then published as the latest) or
# unchanged (the release is there with these APKs); $github_skipped says why
# there is none.
github_repo=$(setting LIFE_OS_ANDROID_GITHUB_REPO)
github_repo=${github_repo:-$default_github_repo}
github_action='' github_skipped='' github_drafts=()
if [[ "$github" != true ]]; then
  github_skipped='--no-github'
elif [[ "${github_repo,,}" == off ]]; then
  github_skipped='LIFE_OS_ANDROID_GITHUB_REPO=off'
fi

# gh_get <API path>: GitHub's JSON answer in $answer. Returns 1 when GitHub
# has no such thing (404, or 422 for an unknown commit); refuses when gh
# fails otherwise (not logged in, no network).
gh_get() {
  if answer=$(gh api "$1" 2>"$scratch/gh.err"); then
    return 0
  fi
  answer=''
  grep -qE '\(HTTP (404|422)\)' "$scratch/gh.err" && return 1
  refuse "gh api $1 failed: $(head -c 300 "$scratch/gh.err" | tr '\n' ' ')(gh auth status shows gh's login); or pass --no-github"
}
# gh_manifest <tag>: the updates.json of the published release <tag> in
# $answer; returns 1 when it has none (or not a manifest).
gh_manifest() {
  answer=$(gh release download "$1" --repo "$github_repo" --pattern updates.json --output - 2>"$scratch/gh.err") &&
    jq -e '.formatVersion == 1 and (.apps | type) == "object"' >/dev/null 2>&1 <<<"$answer" && return 0
  answer=''
  return 1
}

if [[ -z "$github_skipped" ]]; then
  [[ "$github_repo" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] ||
    refuse "LIFE_OS_ANDROID_GITHUB_REPO must be a GitHub repository, owner/name such as $default_github_repo, or off"
  command -v gh >/dev/null 2>&1 ||
    refuse "the GitHub release needs gh (the GitHub CLI), logged in (gh auth login); or pass --no-github to publish only here"
  # One build of both apps, from a commit that is on GitHub.
  jq -e 'has("phone") and has("wear")' >/dev/null <<<"$release" ||
    refuse "a GitHub release carries both apps, and $release_file has only $(jq -r 'keys | join(" and ")' <<<"$release"): pass --no-github to publish it only here"
  jq -e '.phone.versionName == .wear.versionName and .phone.versionCode == .wear.versionCode and .phone.commit == .wear.commit' >/dev/null <<<"$release" ||
    refuse "a GitHub release is one build of both apps, and the phone and the watch differ in versionName, versionCode, or commit: pass --no-github to publish them only here"
  IFS=$'\t' read -r github_name github_code github_commit < <(jq -r '.phone | [.versionName, .versionCode, .commit] | @tsv' <<<"$release")
  [[ "$github_commit" != *-dirty ]] ||
    refuse "a build from uncommitted changes never goes to GitHub, not even with --force: commit and rebuild, or pass --no-github"
  [[ "$github_commit" =~ ^[0-9a-f]{40}$ ]] ||
    refuse "the GitHub release is tagged at the build's commit, which must be a full SHA (40 hexadecimal digits), not $github_commit: pass --no-github to publish it only here"
  tag="v$github_name-$github_code"
  [[ "$tag" != *..* ]] || refuse "$tag is not a valid Git tag (it has ..): pass --no-github to publish it only here"

  gh_get "repos/$github_repo" ||
    refuse "gh does not see the repository $github_repo: check LIFE_OS_ANDROID_GITHUB_REPO and gh auth status, or pass --no-github"
  IFS=$'\t' read -r github_repo can_push < <(jq -r '[.full_name, (.permissions.push // false)] | @tsv' <<<"$answer")
  [[ "$can_push" == true ]] ||
    refuse "gh's account may not publish releases on $github_repo (no push access): check gh auth status, or pass --no-github"
  gh_get "repos/$github_repo/commits/$github_commit" ||
    refuse "the build's commit $github_commit is not on GitHub ($github_repo): push it first, or pass --no-github"

  # Its manifest: release.json's apps, each at its asset of this release.
  # The notes are --notes, else those the server has for this version.
  github_notes=$notes
  [[ -n "$github_notes" ]] || github_notes=$(jq -r --argjson code "$github_code" '.apps.phone | select(.versionCode == $code) | .notes // ""' <<<"$updated")
  github_manifest=$(jq -n --argjson release "$release" --arg now "$now" --arg notes "$github_notes" \
    --arg base "https://github.com/$github_repo/releases/download/$tag/" '
    {formatVersion: 1, updatedAt: $now,
     apps: ($release | to_entries | map(.key as $app | .value | {key: $app, value: {versionCode, versionName, minSdk, sha256, size,
       url: ($base + "lifeos-\($app)-\(.versionName)-\(.versionCode).apk"), publishedAt: $now, builtAt, commit, notes: $notes, previous: []}})
       | from_entries)}')

  if gh_get "repos/$github_repo/releases/tags/$tag"; then
    # Published already: with these APKs (a publish run again), or others.
    gh_manifest "$tag" ||
      refuse "the GitHub release $tag exists without an updates.json; it was not made by this script: remove it on GitHub, or pass --no-github"
    same=$(jq -n --argjson a "$answer" --argjson b "$github_manifest" '[$a, $b] | map(.apps | {phone, wear} | map_values({versionCode, sha256})) | .[0] == .[1]')
    [[ "$same" == true ]] ||
      refuse "the GitHub release $tag already exists with other APKs; build with a higher versionCode (or pass --no-github)"
    github_action=unchanged
  else
    # Drafts with this tag, which an interrupted publish left: replaced.
    gh_get "repos/$github_repo/releases?per_page=100" ||
      refuse "gh does not list the releases of $github_repo; or pass --no-github"
    mapfile -t github_drafts < <(jq -r --arg tag "$tag" '.[] | select(.draft and .tag_name == $tag) | .id' <<<"$answer")
    if gh_get "repos/$github_repo/releases/latest"; then
      latest_tag=$(jq -r .tag_name <<<"$answer")
      gh_manifest "$latest_tag" ||
        refuse "the latest GitHub release, $latest_tag, has no updates.json, so its versions are unknown: give it one or delete it, or pass --no-github"
      IFS=$'\t' read -r latest_phone latest_wear < <(jq -r '[.apps.phone.versionCode // 0, .apps.wear.versionCode // 0] | @tsv' <<<"$answer")
      if ((github_code <= latest_phone || github_code <= latest_wear)) && [[ "$force" != true ]]; then
        refuse "versionCode $github_code is not above the latest GitHub release, $latest_tag (phone $latest_phone, wear $latest_wear); refusing a downgrade (--force publishes it anyway, or pass --no-github)"
      fi
    fi
    github_action=create
  fi
fi

if [[ "$dry_run" == true ]]; then
  for app in "${publish[@]}"; do
    jq -r --arg app "$app" '.apps[$app] | "dry run: would publish \($app) \(.versionName) (\(.versionCode)): \(.url), \(.size) bytes, sha256 \(.sha256)"' <<<"$updated"
  done
  for app in "${unchanged[@]}"; do
    jq -r --arg app "$app" '.apps[$app] | "dry run: unchanged \($app) \(.versionName) (\(.versionCode)): already published \(.publishedAt)"' <<<"$updated"
  done
  case "$github_action" in
    create)
      printf 'dry run: github: would create the release %s on %s at %s, a draft with %s, %s and updates.json, then publish it as the latest' \
        "$tag" "$github_repo" "$github_commit" "${file[phone]}" "${file[wear]}"
      ((${#github_drafts[@]} == 0)) || printf ' (replacing %d draft(s) an interrupted publish left)' "${#github_drafts[@]}"
      printf '\n'
      ;;
    unchanged) printf 'dry run: github: unchanged, the release %s on %s has these APKs\n' "$tag" "$github_repo" ;;
    *) printf 'dry run: github: skipped (%s)\n' "$github_skipped" ;;
  esac
  printf 'dry run: nothing was changed\n'
  exit 0
fi

# Now the writes, each to a temporary file in the releases directory ($tmp)
# that place renames into place once it is complete. Both run in this
# shell, never in a pipeline.
new_temp() {
  tmp=$(mktemp -- "$dir/.publish-XXXXXXXX")
  temps+=("$tmp")
}
place() { # <temporary file> <name>
  chmod 644 -- "$1"
  sync -- "$1"
  mv -f -T -- "$1" "$dir/$2"
}
# The APKs first: until the manifest is renamed, nothing points at them.
for app in "${publish[@]}"; do
  new_temp
  cp -- "$release_dir/${file[$app]}" "$tmp"
  [[ "$(sha256sum <"$tmp" | cut -d ' ' -f 1)" == "${sha[$app]}" ]] ||
    fail "$app: the copy of ${file[$app]} does not match its SHA-256 (is the disk full?); nothing was published"
  place "$tmp" "${file[$app]}"
done

if ((${#publish[@]})); then
  new_temp
  printf '%s\n' "$updated" >"$tmp"
  place "$tmp" updates.json
fi

new_temp
printf '%s\n' "$page" >"$tmp"
place "$tmp" index.html

# Older APKs: everything the manifest no longer lists.
declare -A listed
while IFS= read -r name; do listed[$name]=1; done < <(jq -r --arg prefix "$url_prefix" '.apps[] | .url, .previous[]?.url | ltrimstr($prefix)' <<<"$updated")
deleted=()
for path in "$dir"/lifeos-phone-*.apk "$dir"/lifeos-wear-*.apk; do
  [[ -f "$path" ]] || continue
  name=${path##*/}
  [[ -n "${listed[$name]:-}" ]] && continue
  rm -f -- "$path"
  deleted+=("$name")
done

for app in "${publish[@]}"; do
  jq -r --arg app "$app" '.apps[$app] | "published \($app) \(.versionName) (\(.versionCode)): \(.url), \(.size) bytes, sha256 \(.sha256)"' <<<"$updated"
done
for app in "${unchanged[@]}"; do
  jq -r --arg app "$app" '.apps[$app] | "unchanged \($app) \(.versionName) (\(.versionCode)): already published \(.publishedAt)"' <<<"$updated"
done
for name in "${deleted[@]}"; do printf 'deleted %s (keeping the newest %d of each app)\n' "$name" "$keep"; done
((${#publish[@]})) || printf 'nothing new to publish; the page is rewritten\n'
printf 'manifest: %s (served at %supdates), page: %s (served at %s)\n' "$manifest" "$url_prefix" "$dir/index.html" "$url_prefix"

# The GitHub Release: replace drafts an interrupted publish left, create a
# draft with the APKs and updates.json, check what GitHub stored, then
# publish it as the latest. Until that last step nobody sees it, so apps
# never find a release without its files.
github_publish() {
  local id assets want url
  for id in "${github_drafts[@]}"; do
    gh api -X DELETE "repos/$github_repo/releases/$id" >/dev/null || return 1
  done
  mkdir -p "$scratch/assets" || return 1
  printf '%s\n' "$github_manifest" >"$scratch/assets/updates.json" || return 1
  jq -r --arg repo "$github_repo" --arg commit "$github_commit" --arg notes "$github_notes" "$jq_android"'
    (if $notes != "" then $notes + "\n\n" else "" end)
    + "Life OS for Android \(.apps.phone.versionName) (versionCode \(.apps.phone.versionCode)), built from \($commit).\n\n"
    + "- Phone (\(.apps.phone.minSdk | android)): `\(.apps.phone.url | split("/") | last)`\n"
    + "- Watch (Wear OS, \(.apps.wear.minSdk | android)): `\(.apps.wear.url | split("/") | last)`, installed from the phone app: Settings › Watch\n\n"
    + "SHA-256:\n\n```\n"
    + ([.apps.phone, .apps.wear] | map("\(.sha256)  \(.url | split("/") | last)") | join("\n"))
    + "\n```\n\n"
    + "Open the phone APK on the phone to install it. An app that is not connected to the official Life OS server updates itself, and the watch app, from the latest release here: it checks each APK against `updates.json` and installs only one signed with the same key as the installed app ([Signing](https://github.com/\($repo)#signing)).\n"
  ' "$scratch/assets/updates.json" >"$scratch/notes.md" || return 1
  gh release create "$tag" --repo "$github_repo" --draft --target "$github_commit" \
    --title "Life OS for Android $github_name ($github_code)" --notes-file "$scratch/notes.md" \
    "$release_dir/${file[phone]}" "$release_dir/${file[wear]}" "$scratch/assets/updates.json" >/dev/null || return 1
  answer=$(gh api "repos/$github_repo/releases?per_page=100") || return 1
  id=$(jq -r --arg tag "$tag" 'first(.[] | select(.draft and .tag_name == $tag) | .id) // empty' <<<"$answer") || return 1
  [[ -n "$id" ]] || { printf 'publish-android-release: GitHub lists no draft %s after creating it\n' "$tag" >&2; return 1; }
  # What GitHub stored: these three files, at their sizes and SHA-256s.
  assets=$(jq -c --argjson id "$id" 'first(.[] | select(.id == $id)) | .assets | map({name, size, digest}) | sort_by(.name)' <<<"$answer") || return 1
  want=$(jq -c -n --argjson m "$github_manifest" --arg sha "$(sha256sum <"$scratch/assets/updates.json" | cut -d ' ' -f 1)" \
    --argjson size "$(stat -c %s -- "$scratch/assets/updates.json")" '
    [$m.apps[] | {name: (.url | split("/") | last), size, sha256}] + [{name: "updates.json", size: $size, sha256: $sha}] | sort_by(.name)') || return 1
  jq -e -n --argjson got "$assets" --argjson want "$want" '
    ($got | length) == ($want | length)
    and ([$got, $want] | transpose | all(.[0].name == .[1].name and .[0].size == .[1].size
      and (.[0].digest == null or .[0].digest == "sha256:" + .[1].sha256)))' >/dev/null || {
    printf 'publish-android-release: the draft %s on GitHub does not hold the files as uploaded: %s\n' "$tag" "$assets" >&2
    return 1
  }
  url=$(gh api -X PATCH "repos/$github_repo/releases/$id" -F draft=false -f make_latest=true | jq -r .html_url) || return 1
  printf 'github: published %s on %s as the latest release: %s (%s, %s, updates.json)\n' "$tag" "$github_repo" "$url" "${file[phone]}" "${file[wear]}"
}

case "$github_action" in
  create)
    github_publish ||
      fail "the GitHub release $tag is not published (see above); everything here is. Run the same command again to finish it: it publishes nothing here a second time"
    ;;
  unchanged) printf 'github: unchanged, the release %s on %s has these APKs\n' "$tag" "$github_repo" ;;
  *) printf 'github: skipped (%s)\n' "$github_skipped" ;;
esac
