#!/usr/bin/env bash
set -euo pipefail

# Checks the client address and scheme the gateway passes on
# (infra/nginx/life-os.conf.template, trusted-proxies.envsh;
# docs/install/access.md#your-own-reverse-proxy) in throwaway containers,
# never the deployed gateway or the verification stack: the gateway's nginx
# with its configuration rendered as compose.yaml has it rendered, on three
# networks of its own as in compose.yaml (backend, edge for Cloudflare's
# connector, proxy for your own reverse proxy; the edge's address is this
# test's), a stand-in Dashboard that echoes the X-Real-IP, X-Forwarded-For,
# and X-Forwarded-Proto it gets (its auth check answers lifeos=good with an
# identity token naming X-Real-IP), stand-in services, and a client on each
# network. It checks:
#  - LIFE_OS_TRUSTED_PROXIES empty, the default: nobody's X-Forwarded-For or
#    X-Forwarded-Proto is believed, from the proxy network either;
#  - Cloudflare's path is as before, whatever the setting: CF-Connecting-IP
#    and https from the edge network alone, never X-Forwarded-For;
#  - with a proxy network trusted: its X-Forwarded-For is the client's
#    address for the Dashboard, the auth check (the identity token's address)
#    and the services, and an entry the client wrote itself, left of the one
#    its proxy added, never counts; its X-Forwarded-Proto passes, https or
#    http only; from any other address (another network, the host) both are
#    ignored, and the sign-in limit (lifeos_auth) counts each client apart;
#  - entries that are not an address or network, or would trust everyone
#    (0.0.0.0/0), are left out with a warning, and the gateway still starts;
#  - host: a proxy on the server itself, outside Docker, through the
#    published port, is believed, and the proxy network then is not.
#
#   tools/test-gateway-proxies

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
command -v docker >/dev/null 2>&1 || { echo 'test-gateway-proxies: docker is required' >&2; exit 2; }
image=$(sed -n 's/^FROM //p' infra/nginx/Dockerfile | head -n 1)
[[ -n "$image" ]] || { echo "test-gateway-proxies: no base image in infra/nginx/Dockerfile" >&2; exit 2; }
# The clients: curl, nothing else.
curl_image=curlimages/curl:8.17.0@sha256:935d9100e9ba842cdb060de42472c7ca90cfe9a7c96e4dacb55e79e560b3ff40
name=lifeos-verify-gwproxy-$$
work=$(mktemp -d)
cleanup() {
  docker rm -f "$name-gateway" "$name-dashboard" "$name-services" \
    "$name-on-proxy" "$name-on-edge" "$name-on-backend" >/dev/null 2>&1 || true
  docker network rm "$name-backend" "$name-edge" "$name-proxy" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT
fail() {
  printf 'test-gateway-proxies: %s\n' "$*" >&2
  exit 1
}

nginx_dir=$repo_root/infra/nginx
template=$nginx_dir/life-os.conf.template
# shellcheck disable=SC2016 # nginx variables, not the shell's
mapfile -t services < <(sed -n 's/^ *set \$upstream \([a-z-]*\):8080;$/\1/p' "$template" | sort -u)

# The networks. Docker picks their subnets; the edge network's stands in
# for 10.255.249.0/29 in a copy of the template. The names keep compose.yaml's
# order (backend first), which is the network the published port goes
# through.
docker network create "$name-backend" >/dev/null
docker network create "$name-edge" >/dev/null
docker network create --internal "$name-proxy" >/dev/null
subnet() { docker network inspect "$1" --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'; }
edge_subnet=$(subnet "$name-edge")
proxy_subnet=$(subnet "$name-proxy")
[[ "$edge_subnet" == */* && "$proxy_subnet" == */* ]] || fail "no subnets for the test's networks"
grep -q 'set_real_ip_from 10\.255\.249\.0/29;' "$template" || fail "the template no longer trusts the edge network 10.255.249.0/29"
sed "s#10\.255\.249\.0/29#$edge_subnet#g" "$template" >"$work/gateway.conf.template"

# The stand-in Dashboard: the auth check, and everything else echoed.
cat >"$work/dashboard.conf" <<'EOF'
server {
  listen 3000;
  default_type text/plain;
  location = /internal/auth/check {
    if ($http_cookie ~ "lifeos=good") {
      add_header X-Life-OS-Identity "ok:address=$http_x_real_ip" always;
      return 204;
    }
    return 401;
  }
  location / {
    return 200 "dashboard ip=[$http_x_real_ip] xff=[$http_x_forwarded_for] proto=[$http_x_forwarded_proto] host=[$http_host]\n";
  }
}
EOF
cat >"$work/services.conf" <<'EOF'
server {
  listen 8080;
  default_type text/plain;
  location / {
    return 200 "service identity=[$http_x_life_os_identity] ip=[$http_x_real_ip] xff=[$http_x_forwarded_for] proto=[$http_x_forwarded_proto]\n";
  }
}
EOF
chmod 644 "$work"/*.conf "$work/gateway.conf.template"

docker run -d --rm --name "$name-dashboard" --network "$name-backend" --network-alias dashboard \
  -v "$work/dashboard.conf:/etc/nginx/conf.d/default.conf:ro" "$image" >/dev/null
aliases=()
for service in "${services[@]}"; do aliases+=(--network-alias "$service"); done
docker run -d --rm --name "$name-services" --network "$name-backend" "${aliases[@]}" \
  -v "$work/services.conf:/etc/nginx/conf.d/default.conf:ro" "$image" >/dev/null
# One client on each network, kept running for docker exec.
for net in proxy edge backend; do
  docker run -d --rm --name "$name-on-$net" --network "$name-$net" --entrypoint sleep "$curl_image" 900 >/dev/null
done
address_of() { # <container> <network>
  docker inspect "$1" --format "{{(index .NetworkSettings.Networks \"$2\").IPAddress}}"
}
proxy_client=$(address_of "$name-on-proxy" "$name-proxy")
edge_client=$(address_of "$name-on-edge" "$name-edge")
backend_client=$(address_of "$name-on-backend" "$name-backend")

start() { # <LIFE_OS_TRUSTED_PROXIES>: the gateway's address on each network, and $base from the host
  docker rm -f "$name-gateway" >/dev/null 2>&1 || true
  local args=(-e NGINX_ENTRYPOINT_QUIET_LOGS=1 -e NGINX_ENVSUBST_FILTER=^LIFE_OS_
    -e LIFE_OS_PUBLIC_HOSTNAME=lifeos.example.com -e LIFE_OS_GATEWAY_BIND_ADDRESS=127.0.0.1
    -e LIFE_OS_REQUIRE_CLOUDFLARE_ACCESS= -e "LIFE_OS_TRUSTED_PROXIES=$1"
    -e "LIFE_OS_MODULES=$(cut -d ' ' -f 1 "$nginx_dir/module-routes" | grep -v '^#' | sort -u | paste -sd, -)"
    -v "$work/gateway.conf.template:/etc/nginx/templates/default.conf.template:ro"
    -v "$nginx_dir/server-names.envsh:/docker-entrypoint.d/16-lifeos-server-names.envsh:ro"
    -v "$nginx_dir/modules.envsh:/docker-entrypoint.d/17-lifeos-modules.envsh:ro"
    -v "$nginx_dir/trusted-proxies.envsh:/docker-entrypoint.d/18-lifeos-trusted-proxies.envsh:ro"
    -v "$nginx_dir/module-routes:/etc/nginx/lifeos/module-routes:ro")
  # Every network at creation, as Compose does.
  docker run -d --rm --name "$name-gateway" --network "$name-backend" --network "$name-edge" \
    --network "$name-proxy" -p 127.0.0.1::80 "${args[@]}" "$image" >/dev/null
  base="http://127.0.0.1:$(docker port "$name-gateway" 80/tcp | head -n 1 | sed 's/.*://')"
  on_proxy=http://$(address_of "$name-gateway" "$name-proxy")
  on_edge=http://$(address_of "$name-gateway" "$name-edge")
  on_backend=http://$(address_of "$name-gateway" "$name-backend")
  for _ in $(seq 1 40); do
    curl --silent --output /dev/null "$base/login" && return
    sleep 0.25
  done
  docker logs "$name-gateway" >&2
  fail "the gateway did not start with LIFE_OS_TRUSTED_PROXIES=$1"
}
# A request from the host (through the published port), or from a client
# container: the body in $body.
from_host() { # <path> [curl options…]
  local path=$1
  shift
  body=$(curl --silent --show-error --max-time 15 -H 'Host: lifeos.example.com' "$@" "$base$path")
}
from() { # <network> <url-on-that-network>/<path> [curl options…]
  local net=$1 url=$2
  shift 2
  body=$(docker exec "$name-on-$net" curl --silent --show-error --max-time 15 -H 'Host: lifeos.example.com' "$@" "$url")
}
expect_body() { # <text>
  grep -qF -- "$1" <<<"$body" || { printf '%s\n' "$body" >&2; fail "the answer lacks: $1"; }
}
refuse_body() { # <text>
  ! grep -qF -- "$1" <<<"$body" || { printf '%s\n' "$body" >&2; fail "the answer has: $1"; }
}
cloudflare=(-H 'CF-Connecting-IP: 192.0.2.7' -H 'Cf-Access-Jwt-Assertion: token' -H 'X-Forwarded-For: 203.0.113.99' -H 'X-Forwarded-Proto: http')

printf '==> LIFE_OS_TRUSTED_PROXIES empty: no forwarded address is believed\n'
start ''
from proxy "$on_proxy/" -H 'X-Forwarded-For: 203.0.113.10' -H 'X-Forwarded-Proto: https'
expect_body "ip=[$proxy_client] xff=[$proxy_client] proto=[http]"
from backend "$on_backend/" -H 'X-Forwarded-For: 203.0.113.10' -H 'X-Real-IP: 203.0.113.10'
expect_body "ip=[$backend_client] xff=[$backend_client] proto=[http]"
from_host / -H 'X-Forwarded-For: 203.0.113.10' -H 'X-Forwarded-Proto: https'
refuse_body 203.0.113.10
expect_body 'proto=[http]'
printf '==> Cloudflare: its header and https, from the edge network alone, as before\n'
from edge "$on_edge/" "${cloudflare[@]}"
expect_body 'ip=[192.0.2.7] xff=[192.0.2.7] proto=[https]'
from proxy "$on_proxy/" -H 'CF-Connecting-IP: 192.0.2.7'
expect_body "ip=[$proxy_client]"

printf '==> A trusted proxy network: its X-Forwarded-For and X-Forwarded-Proto count\n'
# With entries that must be left out: no address, everyone, a glob.
start "$proxy_subnet, 300.1.2.3,0.0.0.0/0 ::/0 * not-an-address"
logs=$(docker logs "$name-gateway" 2>&1)
for entry in 300.1.2.3 0.0.0.0/0 ::/0 '*' not-an-address; do
  grep -qF "\"$entry\"" <<<"$logs" || { printf '%s\n' "$logs" >&2; fail "no warning that $entry is left out"; }
done
for path in / /login /api/auth/get-session /share /calendar/google/callback; do
  from proxy "$on_proxy$path" -H 'X-Forwarded-For: 203.0.113.10' -H 'X-Forwarded-Proto: https'
  expect_body 'ip=[203.0.113.10] xff=[203.0.113.10] proto=[https] host=[lifeos.example.com]'
done
# The auth check sees the client too, so the identity token's address is
# the client's, and so does every service.
from proxy "$on_proxy/api/tasks/v1/tasks" --cookie lifeos=good -H 'X-Forwarded-For: 203.0.113.10' -H 'X-Forwarded-Proto: https'
expect_body 'service identity=[ok:address=203.0.113.10] ip=[203.0.113.10] xff=[203.0.113.10] proto=[https]'
# An entry the client wrote itself, left of the one its proxy added.
from proxy "$on_proxy/" -H 'X-Forwarded-For: 198.51.100.66, 203.0.113.10'
expect_body 'ip=[203.0.113.10] xff=[203.0.113.10]'
refuse_body 198.51.100.66
from proxy "$on_proxy/" -H 'X-Forwarded-For: 198.51.100.66' -H 'X-Forwarded-For: 203.0.113.10'
expect_body 'ip=[203.0.113.10]'
# Without the header, the proxy's own address; a scheme other than http or
# https is not believed.
from proxy "$on_proxy/" -H 'X-Forwarded-Proto: javascript'
expect_body "ip=[$proxy_client] xff=[$proxy_client] proto=[http]"
printf '==> Anyone else: forwarded headers ignored\n'
from backend "$on_backend/" -H 'X-Forwarded-For: 203.0.113.12' -H 'X-Forwarded-Proto: https'
expect_body "ip=[$backend_client] xff=[$backend_client] proto=[http]"
from_host / -H 'X-Forwarded-For: 203.0.113.12' -H 'X-Forwarded-Proto: https'
refuse_body 203.0.113.12
expect_body 'proto=[http]'
from edge "$on_edge/" -H 'Cf-Access-Jwt-Assertion: token' -H 'X-Forwarded-For: 203.0.113.12'
expect_body "ip=[$edge_client]"
printf '==> Cloudflare: unchanged\n'
from edge "$on_edge/" "${cloudflare[@]}"
expect_body 'ip=[192.0.2.7] xff=[192.0.2.7] proto=[https]'
printf '==> The sign-in limit counts each client behind the proxy apart\n'
# lifeos_auth: 2 a second, bursts of 20. One client's 30 quick requests run
# into it; another client, through the same proxy, does not.
urls=()
for _ in $(seq 1 30); do urls+=("$on_proxy/api/auth/sign-in/username"); done
codes=$(docker exec "$name-on-proxy" curl --silent --output /dev/null --write-out '%{http_code}\n' \
  -H 'Host: lifeos.example.com' -H 'X-Forwarded-For: 203.0.113.20' "${urls[@]}")
grep -qx 429 <<<"$codes" || fail "30 sign-in requests from one client got no 429: $(sort <<<"$codes" | uniq -c | tr '\n' ' ')"
from proxy "$on_proxy/api/auth/sign-in/username" -H 'X-Forwarded-For: 203.0.113.21'
expect_body 'ip=[203.0.113.21]'

printf '==> host: a proxy on the server itself, through the published port\n'
start 'host'
from_host / -H 'X-Forwarded-For: 198.51.100.66, 100.101.102.103' -H 'X-Forwarded-Proto: https'
expect_body 'ip=[100.101.102.103] xff=[100.101.102.103] proto=[https]'
from proxy "$on_proxy/" -H 'X-Forwarded-For: 203.0.113.10' -H 'X-Forwarded-Proto: https'
expect_body "ip=[$proxy_client] xff=[$proxy_client] proto=[http]"
from edge "$on_edge/" "${cloudflare[@]}"
expect_body 'ip=[192.0.2.7] xff=[192.0.2.7] proto=[https]'

printf '\ngateway proxies: all checks passed\n'
