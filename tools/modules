#!/usr/bin/env python3
"""Life OS's modules (docs/architecture/modules.md).

  tools/modules            check the manifests, then write what reads them
  tools/modules --check    check the manifests, and fail when a written file is stale
  tools/modules --list     the modules, one "<id> <install> <name>" a line

Each module is described once, in modules/<id>.yaml: its Compose services
and volumes, its databases, its gateway routes, its Dashboard navigation,
services, Status checks, and features, its MCP tools, and its .env settings.
The core (install: core) always runs; every other module (install: optional)
is a Compose profile of its own name, and runs when COMPOSE_PROFILES in .env
lists it.

The check holds the manifests against what they describe:

  - compose.yaml: every service and named volume belongs to exactly one
    module; the core's services have no profiles, an optional module's have
    exactly its own; a service depends only on its own module's, the
    core's, or those of the modules its module requires (or with
    required: false);
  - infra/postgres/service-databases.conf: every database belongs to one module;
  - infra/nginx/life-os.conf.template: every location that proxies to a
    service is a route of that service's module, and every route is such a
    location;
  - the Dashboard: every service key (src/config/services.ts, and processor
    and monitor) belongs to one module, every navigation entry
    (src/components/app-shell.tsx) to one, and every Status check is one
    that src/lib/runtime-status.ts builds;
  - MCP: every tool services/mcp/cmd/server names is one module's;
  - every LIFE_OS_* setting of .env.example and compose.yaml belongs to one
    module (a database's password to the database's module).

It writes, from the manifests, what reads them where the manifests are not:

  - infra/nginx/module-routes: the optional modules' routes, which the
    gateway answers with 404 module_off while their module is off
    (infra/nginx/modules.envsh);
  - apps/dashboard/src/config/modules.generated.ts: the Dashboard's part;
  - setup.sh and tools/lib/modules.bash: the optional modules for setup.sh
    and the tools (bash arrays between the generated markers).

Needs Python 3 with PyYAML (python3-yaml).
"""

import argparse
import fnmatch
import glob
import json
import os
import re
import sys

try:
    import yaml
except ImportError:
    sys.exit("modules: PyYAML is required (apt install python3-yaml, or pip install pyyaml)")

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MODULES_DIR = "modules"
COMPOSE = "compose.yaml"
DATABASES = "infra/postgres/service-databases.conf"
GATEWAY_TEMPLATE = "infra/nginx/life-os.conf.template"
ENV_EXAMPLE = ".env.example"
DASHBOARD_SERVICES = "apps/dashboard/src/config/services.ts"
DASHBOARD_SHELL = "apps/dashboard/src/components/app-shell.tsx"
DASHBOARD_STATUS = "apps/dashboard/src/lib/runtime-status.ts"
MCP_SERVER = "services/mcp/cmd/server"
SETUP = "setup.sh"

GATEWAY_ROUTES = "infra/nginx/module-routes"
DASHBOARD_MODULES = "apps/dashboard/src/config/modules.generated.ts"
TOOLS_MODULES = "tools/lib/modules.bash"
BASH_BEGIN = "# BEGIN generated by tools/modules from modules/*.yaml: do not edit here"
BASH_END = "# END generated by tools/modules"
# Dashboard service keys that are not in services.ts: the processor's status
# (runtime-status.ts) and the monitor, which has no API of its own.
EXTRA_DASHBOARD_SERVICES = {"processor", "monitor"}

ID = re.compile(r"^[a-z][a-z0-9-]*$")
FEATURE = re.compile(r"^[a-z][a-z0-9-]*(\.[a-z][a-z0-9-]*)+$")
SETTING = re.compile(r"^LIFE_OS_[A-Z0-9_]+\*?$")
TOOL = re.compile(r"^[a-z][a-z0-9_]*\*?$")

KEYS = {
    "id": str,
    "name": str,
    "summary": str,
    "caution": str,
    "install": str,
    "order": int,
    "requires": list,
    "setup": str,
    "compose": dict,
    "databases": list,
    "gateway": dict,
    "dashboard": dict,
    "mcp-tools": list,
    "settings": list,
}
REQUIRED = ("id", "name", "summary", "install", "order")
SECTION_KEYS = {
    "compose": {"services", "volumes"},
    "gateway": {"routes"},
    "dashboard": {"nav", "services", "checks", "features"},
}


class ModuleError(Exception):
    pass


def read(path):
    with open(os.path.join(REPO_ROOT, path), encoding="utf-8") as file:
        return file.read()


def strings(value, where):
    if not isinstance(value, list) or not all(isinstance(item, str) and item for item in value):
        raise ModuleError(f"{where} must be a list of strings")
    if len(set(value)) != len(value):
        raise ModuleError(f"{where} lists something twice")
    return value


def load_manifests():
    manifests = []
    paths = sorted(glob.glob(os.path.join(REPO_ROOT, MODULES_DIR, "*.yaml")))
    if not paths:
        raise ModuleError(f"no module manifests in {MODULES_DIR}/")
    for path in paths:
        where = os.path.relpath(path, REPO_ROOT)
        with open(path, encoding="utf-8") as file:
            manifest = yaml.safe_load(file)
        if not isinstance(manifest, dict):
            raise ModuleError(f"{where} is not a mapping")
        unknown = set(manifest) - set(KEYS)
        if unknown:
            raise ModuleError(f"{where} has unknown keys: {', '.join(sorted(unknown))}")
        for key in REQUIRED:
            if key not in manifest:
                raise ModuleError(f"{where} has no {key}")
        for key, kind in KEYS.items():
            if key in manifest and not isinstance(manifest[key], kind):
                raise ModuleError(f"{where}: {key} must be a {kind.__name__}")
        module_id = manifest["id"]
        if not ID.match(module_id) or os.path.basename(path) != f"{module_id}.yaml":
            raise ModuleError(f"{where}: id {module_id!r} must be lowercase letters, digits, and dashes, and the file's name")
        if manifest["install"] not in ("core", "optional"):
            raise ModuleError(f"{where}: install is core or optional, not {manifest['install']!r}")
        for key in ("name", "summary", "caution"):
            if "\n" in manifest.get(key, ""):
                raise ModuleError(f"{where}: {key} is one line")
        for section, allowed in SECTION_KEYS.items():
            body = manifest.setdefault(section, {})
            unknown = set(body) - allowed
            if unknown:
                raise ModuleError(f"{where}: {section} has unknown keys: {', '.join(sorted(unknown))}")
            for key in allowed:
                body[key] = strings(body.get(key, []), f"{where}: {section}.{key}")
        for key in ("requires", "databases", "mcp-tools", "settings"):
            manifest[key] = strings(manifest.get(key, []), f"{where}: {key}")
        for feature in manifest["dashboard"]["features"]:
            if not FEATURE.match(feature):
                raise ModuleError(f"{where}: feature {feature!r} must look like area.name, such as capture.voice")
        for setting in manifest["settings"]:
            if not SETTING.match(setting):
                raise ModuleError(f"{where}: setting {setting!r} must be LIFE_OS_NAME, or a prefix ending in *")
        for tool in manifest["mcp-tools"]:
            if not TOOL.match(tool):
                raise ModuleError(f"{where}: MCP tool {tool!r} must be a tool's name, or a prefix ending in *")
        manifest["path"] = where
        manifests.append(manifest)
    manifests.sort(key=lambda m: (m["order"], m["id"]))
    cores = [m["id"] for m in manifests if m["install"] == "core"]
    if cores != ["core"]:
        raise ModuleError(f"exactly one module, core, is install: core (found {', '.join(cores) or 'none'})")
    orders = [m["order"] for m in manifests]
    if len(set(orders)) != len(orders):
        raise ModuleError("two modules have the same order")
    return manifests


def claim(owners, key, module_id, what):
    if key in owners and owners[key] != module_id:
        raise ModuleError(f"{what} {key} is claimed by both {owners[key]} and {module_id}")
    owners[key] = module_id


def check_requires(manifests):
    by_id = {m["id"]: m for m in manifests}
    for manifest in manifests:
        for required in manifest["requires"]:
            if required not in by_id:
                raise ModuleError(f"{manifest['path']}: requires {required}, which is no module")
            if by_id[required]["install"] != "optional" or required == manifest["id"]:
                raise ModuleError(f"{manifest['path']}: requires {required}: only another optional module can be required (the core always runs)")
        if manifest["install"] == "core" and manifest["requires"]:
            raise ModuleError(f"{manifest['path']}: the core requires nothing")
    # No cycles: each module's requirements, transitively, never include it.
    for manifest in manifests:
        seen, todo = set(), list(manifest["requires"])
        while todo:
            current = todo.pop()
            if current == manifest["id"]:
                raise ModuleError(f"{manifest['path']}: its requirements require it again")
            if current not in seen:
                seen.add(current)
                todo.extend(by_id[current]["requires"])
    return by_id


def requirements(by_id, module_id):
    seen, todo = set(), list(by_id[module_id]["requires"])
    while todo:
        current = todo.pop()
        if current not in seen:
            seen.add(current)
            todo.extend(by_id[current]["requires"])
    return seen


def setup_commands():
    return set(re.findall(r"(?m)^setup_([a-z]+)\(\) \{", read(SETUP)))


def check_compose(manifests, by_id):
    compose = yaml.safe_load(read(COMPOSE))
    services = compose.get("services") or {}
    owners = {}
    for manifest in manifests:
        for service in manifest["compose"]["services"]:
            if service not in services:
                raise ModuleError(f"{manifest['path']}: {COMPOSE} has no service {service}")
            claim(owners, service, manifest["id"], "service")
    unclaimed = sorted(set(services) - set(owners))
    if unclaimed:
        raise ModuleError(f"no module claims the services {', '.join(unclaimed)}: add them to a manifest in {MODULES_DIR}/")
    for service, spec in services.items():
        module = by_id[owners[service]]
        profiles = spec.get("profiles") or []
        if module["install"] == "core" and profiles:
            raise ModuleError(f"{COMPOSE}: {service} is the core's, which always runs: it has no profiles (has {profiles})")
        if module["install"] == "optional" and profiles != [module["id"]]:
            raise ModuleError(f"{COMPOSE}: {service} is module {module['id']}'s: its profiles are exactly [{module['id']}] (has {profiles})")
        allowed = {module["id"], "core"} | requirements(by_id, module["id"])
        depends = spec.get("depends_on") or {}
        if isinstance(depends, list):
            depends = {name: {} for name in depends}
        for dependency, condition in depends.items():
            if dependency not in owners:
                raise ModuleError(f"{COMPOSE}: {service} depends on {dependency}, which is no service")
            if (condition or {}).get("required") is False:
                continue
            if owners[dependency] not in allowed:
                raise ModuleError(
                    f"{COMPOSE}: {service} ({module['id']}) depends on {dependency} of module {owners[dependency]}, "
                    f"which can be off: depend only on the core, its own module, or a module it requires "
                    f"(or mark the dependency required: false)"
                )
        for volume in spec.get("volumes") or []:
            source = volume.get("source") if isinstance(volume, dict) else volume.split(":", 1)[0]
            kind = volume.get("type", "volume") if isinstance(volume, dict) else ("volume" if source and not source.startswith(("/", ".", "$", "~")) else "bind")
            if kind != "volume" or not source:
                continue
            volume_owners = [m["id"] for m in manifests if source in m["compose"]["volumes"]]
            if volume_owners and volume_owners[0] not in allowed:
                raise ModuleError(f"{COMPOSE}: {service} ({module['id']}) mounts {source}, module {volume_owners[0]}'s, which can be off")
    volume_owners = {}
    volumes = compose.get("volumes") or {}
    for manifest in manifests:
        for volume in manifest["compose"]["volumes"]:
            if volume not in volumes:
                raise ModuleError(f"{manifest['path']}: {COMPOSE} has no volume {volume}")
            claim(volume_owners, volume, manifest["id"], "volume")
    unclaimed = sorted(set(volumes) - set(volume_owners))
    if unclaimed:
        raise ModuleError(f"no module claims the volumes {', '.join(unclaimed)}")
    return compose, owners


def database_registry():
    registry = {}
    for line in read(DATABASES).splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        name, _database, _role, password = line.split("|")
        registry[name] = password
    return registry


def check_databases(manifests):
    registry = database_registry()
    owners = {}
    for manifest in manifests:
        for database in manifest["databases"]:
            if database not in registry:
                raise ModuleError(f"{manifest['path']}: {DATABASES} has no database {database}")
            claim(owners, database, manifest["id"], "database")
    unclaimed = sorted(set(registry) - set(owners))
    if unclaimed:
        raise ModuleError(f"no module claims the databases {', '.join(unclaimed)}")
    return registry


LOCATION = re.compile(r"^\s*location\s+(?:(=|\^~)\s+)?(\S+)\s*\{")
UPSTREAM = re.compile(r"^\s*set\s+\$upstream\s+([a-z0-9-]+):\d+;")


def gateway_locations():
    """{path: upstream service} for every location that proxies to a service."""
    locations = {}
    current = None
    for line in read(GATEWAY_TEMPLATE).splitlines():
        line = line.split("#", 1)[0]
        match = LOCATION.match(line)
        if match:
            current = match.group(2)
            continue
        match = UPSTREAM.match(line)
        if match and current is not None:
            if current in locations:
                raise ModuleError(f"{GATEWAY_TEMPLATE}: location {current} sets its upstream twice")
            locations[current] = match.group(1)
    return locations


def check_gateway(manifests, service_owners):
    locations = gateway_locations()
    owners = {}
    for manifest in manifests:
        for route in manifest["gateway"]["routes"]:
            if route not in locations:
                raise ModuleError(f"{manifest['path']}: {GATEWAY_TEMPLATE} has no location {route} that proxies to a service")
            claim(owners, route, manifest["id"], "gateway route")
    for path, upstream in locations.items():
        if upstream not in service_owners:
            raise ModuleError(f"{GATEWAY_TEMPLATE}: location {path} proxies to {upstream}, which is no service of {COMPOSE}")
        if owners.get(path) != service_owners[upstream]:
            raise ModuleError(
                f"{GATEWAY_TEMPLATE}: location {path} proxies to {upstream}, module {service_owners[upstream]}'s: "
                f"list {path} in that module's gateway.routes"
            )
    for manifest in manifests:
        if manifest["install"] == "optional":
            for route in manifest["gateway"]["routes"]:
                if not route.startswith("/api/") or not route.endswith("/"):
                    raise ModuleError(f"{manifest['path']}: an optional module's route is an /api/.../ prefix, not {route}")


def check_dashboard(manifests):
    known_services = set(re.findall(r"(?m)^  ([a-zA-Z]+): configuredServiceUrl\(", read(DASHBOARD_SERVICES)))
    if not known_services:
        raise ModuleError(f"found no service in {DASHBOARD_SERVICES}")
    known_services |= EXTRA_DASHBOARD_SERVICES
    nav = set(re.findall(r'\{ href: "([^"]+)", label:', read(DASHBOARD_SHELL)))
    checks = set(re.findall(r'id: "([a-z-]+)"', read(DASHBOARD_STATUS)))
    service_owners, nav_owners, check_owners, feature_owners = {}, {}, {}, {}
    for manifest in manifests:
        dashboard = manifest["dashboard"]
        for service in dashboard["services"]:
            if service not in known_services:
                raise ModuleError(f"{manifest['path']}: the Dashboard has no service {service} ({DASHBOARD_SERVICES})")
            claim(service_owners, service, manifest["id"], "Dashboard service")
        for href in dashboard["nav"]:
            if href not in nav:
                raise ModuleError(f"{manifest['path']}: the Dashboard's navigation has no {href} ({DASHBOARD_SHELL})")
            claim(nav_owners, href, manifest["id"], "navigation entry")
        for check in dashboard["checks"]:
            if check not in checks:
                raise ModuleError(f"{manifest['path']}: the Status page builds no check {check} ({DASHBOARD_STATUS})")
            claim(check_owners, check, manifest["id"], "Status check")
        for feature in dashboard["features"]:
            claim(feature_owners, feature, manifest["id"], "Dashboard feature")
    unclaimed = sorted(known_services - set(service_owners))
    if unclaimed:
        raise ModuleError(f"no module claims the Dashboard services {', '.join(unclaimed)}")
    unclaimed = sorted(nav - set(nav_owners))
    if unclaimed:
        raise ModuleError(f"no module claims the navigation entries {', '.join(unclaimed)}")


def check_mcp(manifests):
    names = set()
    for path in glob.glob(os.path.join(REPO_ROOT, MCP_SERVER, "*.go")):
        if path.endswith("_test.go"):
            continue
        with open(path, encoding="utf-8") as file:
            names |= set(re.findall(r'AddTool\([a-z]+, &mcp\.Tool\{Name: "([a-z0-9_]+)"', file.read()))
    if not names:
        raise ModuleError(f"found no MCP tool in {MCP_SERVER}")
    patterns = [(tool, m["id"]) for m in manifests for tool in m["mcp-tools"]]
    for name in sorted(names):
        matches = {module for tool, module in patterns if fnmatch.fnmatchcase(name, tool)}
        if len(matches) != 1:
            raise ModuleError(f"MCP tool {name} must be claimed by exactly one module's mcp-tools (claimed by {', '.join(sorted(matches)) or 'none'})")
    for tool, module in patterns:
        if not any(fnmatch.fnmatchcase(name, tool) for name in names):
            raise ModuleError(f"module {module}'s mcp-tools {tool} names no tool of {MCP_SERVER}")


def check_settings(manifests, registry):
    keys = set(re.findall(r"(?m)^(?:# ?)?(LIFE_OS_[A-Z0-9_]+)=", read(ENV_EXAMPLE)))
    keys |= set(re.findall(r"\$\{(LIFE_OS_[A-Z0-9_]+)", read(COMPOSE)))
    passwords = {}
    for manifest in manifests:
        for database in manifest["databases"]:
            passwords[registry[database]] = manifest["id"]
    patterns = [(setting, m["id"]) for m in manifests for setting in m["settings"]]
    for key in sorted(keys):
        if key in passwords:
            continue
        matches = {module for setting, module in patterns if fnmatch.fnmatchcase(key, setting)}
        if len(matches) != 1:
            raise ModuleError(f"setting {key} must be claimed by exactly one module's settings (claimed by {', '.join(sorted(matches)) or 'none'})")
    for setting, module in patterns:
        if not any(fnmatch.fnmatchcase(key, setting) for key in keys - set(passwords)):
            raise ModuleError(f"module {module}'s setting {setting} names nothing in {ENV_EXAMPLE} or {COMPOSE}")


def check(manifests):
    by_id = check_requires(manifests)
    commands = setup_commands()
    for manifest in manifests:
        if "setup" in manifest and manifest["setup"] not in commands:
            raise ModuleError(f"{manifest['path']}: setup.sh has no command {manifest['setup']} (setup_{manifest['setup']})")
    _compose, service_owners = check_compose(manifests, by_id)
    registry = check_databases(manifests)
    check_gateway(manifests, service_owners)
    check_dashboard(manifests)
    check_mcp(manifests)
    check_settings(manifests, registry)


# ---- Generated files --------------------------------------------------------


def gateway_routes(manifests):
    lines = [
        "# GENERATED by tools/modules from modules/*.yaml: do not edit. The",
        "# optional modules' gateway routes, \"<module> <path prefix>\" a line:",
        "# while LIFE_OS_MODULES leaves a module out, its routes answer 404",
        "# (modules.envsh).",
    ]
    for manifest in manifests:
        if manifest["install"] == "optional":
            lines.extend(f"{manifest['id']} {route}" for route in manifest["gateway"]["routes"])
    return "\n".join(lines) + "\n"


def dashboard_modules(manifests):
    modules = [
        {
            "id": m["id"],
            "name": m["name"],
            "install": m["install"],
            "requires": m["requires"],
            "dashboard": {key: m["dashboard"][key] for key in ("nav", "services", "checks", "features")},
        }
        for m in manifests
    ]
    body = json.dumps(modules, indent=2, ensure_ascii=False)
    return (
        "// GENERATED by tools/modules from modules/*.yaml: do not edit. The\n"
        "// module manifests' Dashboard part (docs/architecture/modules.md); read\n"
        "// through src/lib/modules.ts.\n\n"
        f"export const MODULES = {body} as const;\n"
    )


def bash_quote(value):
    return "'" + value.replace("'", "'\\''") + "'"


def bash_block(manifests):
    optional = [m for m in manifests if m["install"] == "optional"]

    def table(name, value):
        rows = [f"  [{m['id']}]={bash_quote(value(m))}" for m in optional if value(m)]
        return [f"declare -A {name}=(", *rows, ")"]

    lines = [
        BASH_BEGIN,
        "# The optional modules (modules/*.yaml), in the order setup.sh offers them:",
        "# each is the Compose profile of its id, and runs when COMPOSE_PROFILES",
        "# lists it. The core always runs.",
        "# shellcheck disable=SC2034 # read where this is used",
        "module_ids=(" + " ".join(m["id"] for m in optional) + ")",
        *table("module_name", lambda m: m["name"]),
        *table("module_summary", lambda m: m["summary"]),
        *table("module_caution", lambda m: m.get("caution", "")),
        *table("module_requires", lambda m: " ".join(m["requires"])),
        *table("module_setup", lambda m: m.get("setup", "")),
        *table("module_services", lambda m: " ".join(m["compose"]["services"])),
        BASH_END,
    ]
    return "\n".join(lines) + "\n"


def tools_modules(manifests):
    return (
        "# shellcheck shell=bash\n"
        "# The optional modules for the tools, such as tools/verify-compose:\n"
        "#\n"
        "#   . tools/lib/modules.bash\n"
        "#   for id in \"${module_ids[@]}\"; do ...; done\n"
        "\n" + bash_block(manifests)
    )


def with_bash_block(text, manifests, where):
    pattern = re.compile(re.escape(BASH_BEGIN) + r"\n.*?" + re.escape(BASH_END) + r"\n", re.S)
    if len(pattern.findall(text)) != 1:
        raise ModuleError(f"{where} must have the generated block once: a line '{BASH_BEGIN}' and a line '{BASH_END}'")
    return pattern.sub(lambda _: bash_block(manifests), text)


def outputs(manifests):
    return {
        GATEWAY_ROUTES: gateway_routes(manifests),
        DASHBOARD_MODULES: dashboard_modules(manifests),
        TOOLS_MODULES: tools_modules(manifests),
        SETUP: with_bash_block(read(SETUP), manifests, SETUP),
    }


def main():
    parser = argparse.ArgumentParser(prog="tools/modules", description="Checks the module manifests and writes what reads them.")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="fail when a written file is stale")
    mode.add_argument("--list", action="store_true", help="list the modules")
    args = parser.parse_args()
    try:
        manifests = load_manifests()
        if args.list:
            for manifest in manifests:
                print(manifest["id"], manifest["install"], manifest["name"])
            return 0
        check(manifests)
        stale = []
        for path, content in outputs(manifests).items():
            target = os.path.join(REPO_ROOT, path)
            try:
                current = read(path)
            except FileNotFoundError:
                current = None
            if current == content:
                continue
            if args.check:
                stale.append(path)
            else:
                with open(target, "w", encoding="utf-8") as out:
                    out.write(content)
                print(f"modules: wrote {path}")
        if stale:
            print(f"modules: stale: {', '.join(stale)}; run tools/modules and commit the result", file=sys.stderr)
            return 1
        return 0
    except ModuleError as error:
        print(f"modules: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
