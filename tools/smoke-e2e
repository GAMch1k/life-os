#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# shellcheck source=tools/lib/settings.bash
. tools/lib/settings.bash

# Writes are attributed to this script as a development tool, never to the
# owner (CONTRIBUTING.md, "Development tools and live data").
actor=(-H 'X-Life-OS-Actor: dev:smoke-e2e')

compose=(./tools/verify-compose)
cleanup() { "${compose[@]}" down --volumes --remove-orphans >/dev/null; }
trap cleanup EXIT

# This is a core-service smoke, not an AI workflow test. Keep its manually
# resolved Inbox fixture away from the automatic processor; the dedicated
# smoke-processor-runtime script verifies that real trigger-to-outcome chain.
"${compose[@]}" up --detach --no-build --scale processor=0

wait_ready() {
  local url=$1
  for _ in $(seq 1 30); do curl --fail --silent "$url/ready" >/dev/null && return; sleep 1; done
  echo "e2e: not ready: $url" >&2; return 1
}

gateway=http://127.0.0.1:13001
finance="$gateway/api/finance"; tasks="$gateway/api/tasks"; inbox="$gateway/api/inbox"; calendar="$gateway/api/calendar"
feeds="$gateway/api/integrations/calendar-feeds"
for service in "$finance" "$tasks" "$inbox" "$calendar" "$feeds"; do wait_ready "$service"; done
# The calendar-feeds integration is routed under /api/integrations/ and,
# without the owner's ZAW feed on this stack, starts with no feeds.
curl --fail --silent "$feeds/v1/feeds" | jq -e '.items == []' >/dev/null

# The gateway answers only its listed hosts (infra/nginx/life-os.conf.template,
# with the hosts from .env): the public hostname, the bind address, and
# loopback. Any other Host, such as the ntfy hostname, gets no response (444).
# ntfy is never served by the gateway.
bind_address=$(setting LIFE_OS_GATEWAY_BIND_ADDRESS)
for host in $(setting LIFE_OS_PUBLIC_HOSTNAME) "${bind_address:-127.0.0.1}" 127.0.0.1 localhost; do
  code=$(curl --silent --output /dev/null --write-out '%{http_code}' -H "Host: $host" "$tasks/ready" || true)
  [ "$code" = 200 ] || { echo "e2e: the gateway must answer Host $host (got $code)" >&2; exit 1; }
done
unlisted=(unknown.example)
ntfy_url=$(setting LIFE_OS_NTFY_PUBLIC_URL)
[ -z "$ntfy_url" ] || unlisted+=("$(url_host "$ntfy_url")")
for host in "${unlisted[@]}"; do
  code=$(curl --silent --output /dev/null --write-out '%{http_code}' -H "Host: $host" "$tasks/ready" || true)
  [ "$code" = 000 ] || { echo "e2e: the gateway must not answer Host $host (got $code)" >&2; exit 1; }
done

account_id=$("${compose[@]}" exec -T postgres sh -c 'psql -U "$POSTGRES_USER" -d finance_db -Atqc "INSERT INTO accounts (name,currency,opening_balance_minor) VALUES ('"'"'Smoke account'"'"','"'"'USD'"'"',0) RETURNING id"')
external_id="e2e-$(date +%s)"
csv="account_id,occurred_on,amount_minor,currency,external_id,note\n${account_id},2026-10-07,-1250,USD,${external_id},Coffee\n"
printf '%b' "$csv" | curl "${actor[@]}" --fail --silent -H 'content-type: text/csv' --data-binary @- "$finance/v1/imports/csv" | jq -e '.imported == 1' >/dev/null
printf '%b' "$csv" | curl "${actor[@]}" --fail --silent -H 'content-type: text/csv' --data-binary @- "$finance/v1/imports/csv" | jq -e '.duplicates == 1' >/dev/null

task=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' -d '{"title":"E2E task"}' "$tasks/v1/tasks"); task_id=$(jq -r .id <<<"$task")
curl "${actor[@]}" --fail --silent -X POST "$tasks/v1/tasks/$task_id/complete" | jq -e '.completed' >/dev/null
item=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' -d '{"content":"E2E inbox","source":"manual"}' "$inbox/v1/inbox-items"); item_id=$(jq -r .id <<<"$item")
curl "${actor[@]}" --fail --silent -X POST "$inbox/v1/inbox-items/$item_id/resolve" | jq -e '.state == "resolved"' >/dev/null
event=$(curl "${actor[@]}" --fail --silent -H 'content-type: application/json' -d '{"title":"E2E event","allDay":true,"startDate":"2026-10-07","endDate":"2026-10-07"}' "$calendar/v1/events"); event_id=$(jq -r .id <<<"$event")
curl "${actor[@]}" --fail --silent -X DELETE "$calendar/v1/events/$event_id" >/dev/null
echo 'end-to-end core smoke checks passed'
