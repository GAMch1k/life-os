#!/usr/bin/env python3
"""The release bundle (docs/operations/releases.md).

  tools/build-install-bundle                 write deploy/compose.yaml
  tools/build-install-bundle --check         fail when deploy/compose.yaml is stale
  tools/build-install-bundle --images        the images a release publishes, one
                                             "<local image> <published name>" a line
  tools/build-install-bundle --assets DIR --version vX.Y.Z [--allow-missing-setup]
                                             the release's assets in DIR
  tools/build-install-bundle --setup-script [--version vX.Y.Z]
                                             the release's setup.sh, on stdout

deploy/compose.yaml is the repository's compose.yaml for a server without a
checkout: every service that compose.yaml builds runs the released image
instead, ${LIFE_OS_IMAGE_REGISTRY:-ghcr.io/gamch1k}/life-os-<name>:${LIFE_OS_VERSION}.
<name> is the service's own, or, for services that share one image (compose.yaml
names it lifeos-<name> in their image:), that image's. Otherwise it changes
only what a service's x-install-bundle says, next to what it changes:

  x-install-bundle:
    image-variable: LIFE_OS_PROCESSOR_IMAGE       the image is ${NAME:-<released image>}
                                                  (a built service only)
    omit-volumes: [/srv/android]                  the mounts at these targets go
    writable-volumes: [/run/lifeos-codex-source]  these mounts lose read_only
    volume-sources: {/run/lifeos-codex-source: "$${NAME:?...}"}
                                                  these mounts' sources are replaced
                                                  ($$ for $, as Compose interpolates
                                                  x- keys of compose.yaml too)
    environment: {NAME: value}                    added to the environment

So compose.yaml may not bind-mount a repository file (a relative path such as
./infra/..., also as a variable's default, ${NAME:-./infra/...}) where the
bundle runs: such configuration belongs in an image (P20-02), or the bundle
gives the mount another source (volume-sources).

The assets are that compose.yaml, .env.example with LIFE_OS_VERSION set to the
release's version, setup.sh with its version placeholder set to it too, and
SHA256SUMS over them. A dry run may go without
setup.sh (--allow-missing-setup); a release may not.

setup.sh also carries the build of the local Claude Code image (./setup.sh
claude; the published images never contain Claude Code): the files of
services/mcp/claude-code, written into its claude_build_files in place of the
placeholder line, so the release adds no asset for them. Their Node.js image
must be the processor's own (services/mcp/Dockerfile); --check checks it too.

Needs Python 3, with PyYAML (python3-yaml) for everything but --setup-script.
"""

import argparse
import difflib
import hashlib
import os
import re
import sys

yaml = None


def require_yaml():
    global yaml
    if yaml is None:
        try:
            import yaml as module
        except ImportError:
            sys.exit("build-install-bundle: PyYAML is required (apt install python3-yaml, or pip install pyyaml)")
        yaml = module
    return yaml

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SOURCE = "compose.yaml"
TARGET = "deploy/compose.yaml"
# setup.sh writes .env from .env.example (P20-03); the bundle ships both.
SETUP_SCRIPT = "setup.sh"
ENV_EXAMPLE = ".env.example"
# The local Claude Code build that setup.sh carries (./setup.sh claude).
CLAUDE_CODE_DIR = "services/mcp/claude-code"
CLAUDE_CODE_FILES = ("Dockerfile", "install.sh", "package.json", "package-lock.json")
CLAUDE_CODE_PLACEHOLDER = "  : __LIFE_OS_CLAUDE_CODE_FILES__\n  return 1\n"
CLAUDE_CODE_DELIMITER = "LIFE_OS_CLAUDE_CODE_FILE"
PROCESSOR_DOCKERFILE = "services/mcp/Dockerfile"

REGISTRY = "${LIFE_OS_IMAGE_REGISTRY:-ghcr.io/gamch1k}"
VERSION = "${LIFE_OS_VERSION:?Set LIFE_OS_VERSION in .env to the Life OS release to run, such as v0.1.0-preview.1}"
# Releases are v<semver>: v0.1.0, or a pre-release such as v0.1.0-preview.1.
VERSION_PATTERN = re.compile(r"^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$")

HEADER = """\
# Life OS: the release bundle's compose.yaml.
#
# GENERATED by tools/build-install-bundle from the repository's compose.yaml;
# do not edit it here. It runs the released images of the version in .env
# (LIFE_OS_VERSION) from ghcr.io/gamch1k (LIFE_OS_IMAGE_REGISTRY) instead of
# building them, so this file and .env are all a server needs: no checkout.
# Settings and their defaults are .env.example's; installing, updating, and
# verifying the images are in the release notes and docs/operations/releases.md.
# The core always runs; each optional module is a profile of its name, which
# runs when COMPOSE_PROFILES in .env lists it (./setup.sh modules).
#
# Early preview: Life OS has no login of its own yet. Keep the gateway on
# 127.0.0.1 (LIFE_OS_GATEWAY_BIND_ADDRESS) and reach it through a VPN or an
# access proxy such as Cloudflare Access. Never expose it to the internet.

"""


class BundleError(Exception):
    pass


BUNDLE_KEY = "x-install-bundle"


def volume_target(volume):
    if isinstance(volume, dict):
        return volume.get("target")
    parts = volume.split(":")
    return parts[1] if len(parts) > 1 else parts[0]


def apply_bundle_overrides(service, spec):
    """The service as the release bundle runs it: its x-install-bundle applied, and dropped."""
    overrides = spec.pop(BUNDLE_KEY, None) or {}
    unknown = set(overrides) - {"image-variable", "omit-volumes", "writable-volumes", "volume-sources", "environment"}
    if unknown:
        raise BundleError(f"service {service}: {BUNDLE_KEY} has unknown keys: {', '.join(sorted(unknown))}")
    volumes = [dict(v) if isinstance(v, dict) else v for v in spec.get("volumes") or []]
    for target in overrides.get("omit-volumes") or []:
        kept = [v for v in volumes if volume_target(v) != target]
        if len(kept) == len(volumes):
            raise BundleError(f"service {service}: {BUNDLE_KEY} omits a mount at {target}, which it has not got")
        volumes = kept
    for target in overrides.get("writable-volumes") or []:
        matches = [v for v in volumes if isinstance(v, dict) and v.get("target") == target]
        if len(matches) != 1:
            raise BundleError(f"service {service}: {BUNDLE_KEY} makes writable a mount at {target}, which it has not got (long syntax)")
        matches[0].pop("read_only", None)
    for target, source in (overrides.get("volume-sources") or {}).items():
        matches = [v for v in volumes if isinstance(v, dict) and v.get("target") == target]
        if len(matches) != 1:
            raise BundleError(f"service {service}: {BUNDLE_KEY} replaces the source of a mount at {target}, which it has not got (long syntax)")
        matches[0]["source"] = str(source).replace("$$", "$")
    if "volumes" in spec:
        if volumes:
            spec["volumes"] = volumes
        else:
            del spec["volumes"]
    environment = overrides.get("environment") or {}
    if environment:
        if not isinstance(spec.get("environment", {}), dict):
            raise BundleError(f"service {service}: {BUNDLE_KEY} adds environment, which needs the mapping form")
        spec["environment"] = {**spec.get("environment", {}), **{k: str(v) for k, v in environment.items()}}
    return spec


def load_compose():
    with open(os.path.join(REPO_ROOT, SOURCE), encoding="utf-8") as source:
        return require_yaml().safe_load(source)


def image_names(compose):
    """{service: (local image, published name)} for every service compose.yaml builds.

    The local image is what `docker compose build` tags in the project
    compose.yaml names (lifeos): the service's image:, else <project>-<service>.
    """
    project = compose.get("name")
    if not project:
        raise BundleError(f"{SOURCE} has no project name (name:)")
    names = {}
    for service, spec in compose["services"].items():
        if "build" not in spec:
            continue
        local = spec.get("image") or f"{project}-{service}"
        if ":" in local.rsplit("/", 1)[-1]:
            local = local.rsplit(":", 1)[0]
        if not local.startswith(f"{project}-") or "/" in local or "$" in local:
            raise BundleError(
                f"{SOURCE}: service {service} builds image {local!r}; a built image is named "
                f"{project}-<name>, so that the release can publish it as life-os-<name>"
            )
        names[service] = (local, "life-os-" + local[len(project) + 1 :])
    return names


# ${NAME:-default} or ${NAME-default}: the default is the source when NAME is unset.
VARIABLE_DEFAULT = re.compile(r"^\$\{[A-Za-z_][A-Za-z0-9_]*:?-(.*)\}$")


def repository_binds(spec):
    """The service's bind mounts of repository files: sources that are relative paths,
    also as a variable's default."""
    for volume in spec.get("volumes") or []:
        if isinstance(volume, str):
            source = volume.split(":", 1)[0] if ":" in volume else ""
        else:
            source = str(volume.get("source", "")) if volume.get("type", "volume") == "bind" else ""
        default = VARIABLE_DEFAULT.match(source)
        if source.startswith(".") or (default and default.group(1).startswith(".")):
            yield source


def install_compose(compose):
    names = image_names(compose)
    problems = []
    services = {}
    image_variables = {}
    for service, spec in compose["services"].items():
        variable = (spec.get(BUNDLE_KEY) or {}).get("image-variable")
        if variable is not None:
            if service not in names or not re.match(r"^[A-Z][A-Z0-9_]*$", str(variable)):
                raise BundleError(f"service {service}: {BUNDLE_KEY} image-variable needs a built service and a variable name, not {variable!r}")
            image_variables[service] = variable
        spec = apply_bundle_overrides(service, dict(spec))
        services[service] = spec
        for source in repository_binds(spec):
            problems.append(f"service {service} bind-mounts the repository's {source}")
        for key in ("env_file", "configs", "secrets"):
            if key in spec:
                problems.append(f"service {service} uses {key}, which would read files of the repository")
    for key in ("configs", "secrets"):
        if key in compose:
            problems.append(f"{SOURCE} declares {key}, which would read files of the repository")
    if problems:
        raise BundleError(
            f"{SOURCE} needs the repository at run time, which the release bundle has not got:\n  "
            + "\n  ".join(problems)
            + "\nBuild that configuration into the service's image instead (docs/operations/releases.md)."
        )

    for service, spec in services.items():
        if service in names:
            del spec["build"]
            published = f"{REGISTRY}/{names[service][1]}:{VERSION}"
            if service in image_variables:
                published = f"${{{image_variables[service]}:-{published}}}"
            # image: first, where build: was, so the file reads the same way.
            spec = {"image": published, **{key: value for key, value in spec.items() if key != "image"}}
        services[service] = spec
    bundle = dict(compose)
    bundle["services"] = services
    return bundle


def render(bundle):
    yaml = require_yaml()

    class Dumper(yaml.SafeDumper):
        # Block sequences indented under their key, as compose.yaml writes them.
        def increase_indent(self, flow=False, indentless=False):
            return super().increase_indent(flow, False)

    body = yaml.dump(
        bundle,
        Dumper=Dumper,
        sort_keys=False,
        default_flow_style=False,
        allow_unicode=True,
        width=1 << 16,
    )
    # A blank line before each service and each top-level key, for reading.
    body = re.sub(r"(?m)^(?=(?:  )?[A-Za-z][A-Za-z0-9_.-]*:(?: |$))", "\n", body).lstrip("\n")
    body = re.sub(r"(?m)^([A-Za-z][A-Za-z0-9_.-]*:)\n\n", "\\1\n", body)
    if yaml.safe_load(body) != bundle:
        raise BundleError("the rendered compose.yaml does not read back as generated")
    return HEADER + body


def published_images(compose):
    seen = {}
    for local, published in image_names(compose).values():
        if seen.setdefault(local, published) != published:
            raise BundleError(f"image {local} would be published under two names")
    return sorted(seen.items())


def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as file:
        for chunk in iter(lambda: file.read(1 << 16), b""):
            digest.update(chunk)
    return digest.hexdigest()


NODE_IMAGE = re.compile(r"(?m)^FROM (node:\S+@sha256:[0-9a-f]{64})")


def claude_code_files():
    """{name: content} of the local Claude Code build that setup.sh carries."""
    files = {}
    for name in CLAUDE_CODE_FILES:
        with open(os.path.join(REPO_ROOT, CLAUDE_CODE_DIR, name), encoding="utf-8") as source:
            content = source.read()
        if not content.endswith("\n") or f"\n{CLAUDE_CODE_DELIMITER}\n" in "\n" + content:
            raise BundleError(f"{CLAUDE_CODE_DIR}/{name} must end in a newline and not have the line {CLAUDE_CODE_DELIMITER}")
        files[name] = content
    with open(os.path.join(REPO_ROOT, PROCESSOR_DOCKERFILE), encoding="utf-8") as source:
        processor = set(NODE_IMAGE.findall(source.read()))
    local = set(NODE_IMAGE.findall(files["Dockerfile"]))
    if len(processor) != 1 or local != processor:
        raise BundleError(
            f"{CLAUDE_CODE_DIR}/Dockerfile must build Claude Code on the processor's own Node.js image "
            f"({', '.join(sorted(processor)) or 'none found'} in {PROCESSOR_DOCKERFILE}), not {', '.join(sorted(local)) or 'none'}"
        )
    return files


def setup_script(version=None):
    """setup.sh as a release ships it: the local Claude Code build written into
    it, and, with a version, its version placeholder set to it."""
    with open(os.path.join(REPO_ROOT, SETUP_SCRIPT), encoding="utf-8") as source:
        script = source.read()
    if script.count(CLAUDE_CODE_PLACEHOLDER) != 1:
        raise BundleError(f"{SETUP_SCRIPT} must have its claude_build_files placeholder once")
    files = "".join(
        f"  cat >\"$1/{name}\" <<'{CLAUDE_CODE_DELIMITER}'\n{content}{CLAUDE_CODE_DELIMITER}\n"
        for name, content in claude_code_files().items()
    )
    script = script.replace(CLAUDE_CODE_PLACEHOLDER, files + "  return 0\n")
    if version is not None:
        # setup.sh's own record of its release (else it reads .env.example's).
        script, count = re.subn(r"(?m)^release_version='__LIFE_OS_VERSION__'$", f"release_version='{version}'", script)
        if count != 1:
            raise BundleError(f"{SETUP_SCRIPT} must have the line release_version='__LIFE_OS_VERSION__' once (found {count})")
    return script


def write_assets(directory, version, rendered, allow_missing_setup):
    if not VERSION_PATTERN.match(version):
        raise BundleError(f"version {version!r} is not a release version such as v0.1.0 or v0.1.0-preview.1")
    setup = os.path.join(REPO_ROOT, SETUP_SCRIPT)
    has_setup = os.path.isfile(setup)
    if not has_setup and not allow_missing_setup:
        raise BundleError(f"{SETUP_SCRIPT} is missing: the bundle ships it (P20-03)")
    os.makedirs(directory, exist_ok=True)

    with open(os.path.join(directory, "compose.yaml"), "w", encoding="utf-8") as out:
        out.write(rendered)
    with open(os.path.join(REPO_ROOT, ENV_EXAMPLE), encoding="utf-8") as source:
        example = source.read()
    stamped, count = re.subn(r"(?m)^LIFE_OS_VERSION=.*$", f"LIFE_OS_VERSION={version}", example)
    if count != 1:
        raise BundleError(f"{ENV_EXAMPLE} must have exactly one LIFE_OS_VERSION= line (found {count})")
    with open(os.path.join(directory, ".env.example"), "w", encoding="utf-8") as out:
        out.write(stamped)
    files = ["compose.yaml", ".env.example"]
    if has_setup:
        script = setup_script(version)
        with open(os.path.join(directory, "setup.sh"), "w", encoding="utf-8") as out:
            out.write(script)
        os.chmod(os.path.join(directory, "setup.sh"), 0o755)
        files.append("setup.sh")
    else:
        print(f"build-install-bundle: {SETUP_SCRIPT} is missing; the assets go without it (dry run)", file=sys.stderr)
    with open(os.path.join(directory, "SHA256SUMS"), "w", encoding="utf-8") as out:
        for name in files:
            out.write(f"{sha256(os.path.join(directory, name))}  {name}\n")


def main():
    parser = argparse.ArgumentParser(
        prog="tools/build-install-bundle",
        description="Generates the release bundle's compose.yaml (deploy/compose.yaml) from compose.yaml.",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="fail when deploy/compose.yaml is stale")
    mode.add_argument("--images", action="store_true", help="list the images a release publishes")
    mode.add_argument("--assets", metavar="DIR", help="write the release's assets into DIR")
    mode.add_argument("--setup-script", action="store_true", help="print the release's setup.sh (with --version: stamped with it)")
    parser.add_argument("--version", help="the release's version, such as v0.1.0-preview.1 (with --assets)")
    parser.add_argument("--allow-missing-setup", action="store_true", help="assets without setup.sh (a dry run)")
    args = parser.parse_args()
    if args.setup_script:
        if args.version is not None and not VERSION_PATTERN.match(args.version):
            parser.error(f"version {args.version!r} is not a release version such as v0.1.0 or v0.1.0-preview.1")
        try:
            sys.stdout.write(setup_script(args.version))
        except BundleError as error:
            print(f"build-install-bundle: {error}", file=sys.stderr)
            return 1
        return 0
    if bool(args.assets) != bool(args.version):
        parser.error("--assets and --version go together")

    try:
        compose = load_compose()
        if args.images:
            for local, published in published_images(compose):
                print(local, published)
            return 0
        rendered = render(install_compose(compose))
        target = os.path.join(REPO_ROOT, TARGET)
        if args.check:
            # The release's setup.sh, with the Claude Code build written in.
            setup_script()
            try:
                with open(target, encoding="utf-8") as current_file:
                    current = current_file.read()
            except FileNotFoundError:
                current = ""
            if current != rendered:
                sys.stdout.writelines(
                    difflib.unified_diff(
                        current.splitlines(keepends=True),
                        rendered.splitlines(keepends=True),
                        fromfile=f"{TARGET} (committed)",
                        tofile=f"{TARGET} (from {SOURCE})",
                    )
                )
                print(
                    f"build-install-bundle: {TARGET} is stale; run tools/build-install-bundle and commit the result",
                    file=sys.stderr,
                )
                return 1
            return 0
        if args.assets:
            write_assets(args.assets, args.version, rendered, args.allow_missing_setup)
            return 0
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "w", encoding="utf-8") as out:
            out.write(rendered)
        return 0
    except BundleError as error:
        print(f"build-install-bundle: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
