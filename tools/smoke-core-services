#!/usr/bin/env bash
set -euo pipefail

# Writes are attributed to this script as a development tool, never to the
# owner (CONTRIBUTING.md, "Development tools and live data").
actor=(-H 'X-Life-OS-Actor: dev:smoke-core-services')

wait_ready() {
  local url=$1
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error "$url/ready" >/dev/null; then return 0; fi
    sleep 1
  done
  printf 'smoke: service did not become ready: %s\n' "$url" >&2
  return 1
}

gateway_port=$(docker compose port gateway 80)
gateway="http://${gateway_port}"
finance="${gateway}/api/finance"
tasks="${gateway}/api/tasks"
inbox="${gateway}/api/inbox"
calendar="${gateway}/api/calendar"
feeds="${gateway}/api/integrations/calendar-feeds"
for service in "$finance" "$tasks" "$inbox" "$calendar" "$feeds"; do wait_ready "$service"; done

curl --fail --silent --show-error "$finance/v1/accounts" >/dev/null
curl --fail --silent --show-error "$feeds/v1/feeds" >/dev/null
curl "${actor[@]}" --fail --silent --show-error -H 'content-type: application/json' -d '{"title":"Smoke task"}' "$tasks/v1/tasks" >/dev/null
curl "${actor[@]}" --fail --silent --show-error -H 'content-type: application/json' -d '{"content":"Smoke capture","source":"manual"}' "$inbox/v1/inbox-items" >/dev/null
curl "${actor[@]}" --fail --silent --show-error -H 'content-type: application/json' -d '{"title":"Smoke event","allDay":true,"startDate":"2026-01-01","endDate":"2026-01-01"}' "$calendar/v1/events" >/dev/null
printf 'core service smoke checks passed\n'
