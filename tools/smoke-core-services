#!/usr/bin/env bash
set -euo pipefail

wait_ready() {
  local url=$1
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error "$url/ready" >/dev/null; then return 0; fi
    sleep 1
  done
  printf 'smoke: service did not become ready: %s\n' "$url" >&2
  return 1
}

finance=http://127.0.0.1:8081
tasks=http://127.0.0.1:8082
inbox=http://127.0.0.1:8083
calendar=http://127.0.0.1:8084
for service in "$finance" "$tasks" "$inbox" "$calendar"; do wait_ready "$service"; done

curl --fail --silent --show-error "$finance/v1/accounts" >/dev/null
curl --fail --silent --show-error -H 'content-type: application/json' -d '{"title":"Smoke task"}' "$tasks/v1/tasks" >/dev/null
curl --fail --silent --show-error -H 'content-type: application/json' -d '{"content":"Smoke capture","source":"manual"}' "$inbox/v1/inbox-items" >/dev/null
curl --fail --silent --show-error -H 'content-type: application/json' -d '{"title":"Smoke event","allDay":true,"startDate":"2026-01-01","endDate":"2026-01-01"}' "$calendar/v1/events" >/dev/null
printf 'core service smoke checks passed\n'
