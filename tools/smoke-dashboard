#!/usr/bin/env bash
set -euo pipefail

# Writes are attributed to this script as a development tool, never to the
# owner (CONTRIBUTING.md, "Development tools and live data").
actor=(-H 'X-Life-OS-Actor: dev:smoke-dashboard')

# The gateway to check, which these records are written to. make life-smoke
# (tools/smoke-life) sets the verification stack's; set it yourself only for
# a gateway you mean to write test records to, such as the deployed one:
#   LIFE_OS_SMOKE_GATEWAY=http://127.0.0.1:3000 tools/smoke-dashboard
gateway=${LIFE_OS_SMOKE_GATEWAY:-}
if [[ -z "$gateway" ]]; then
  printf '%s\n' "smoke-dashboard: set LIFE_OS_SMOKE_GATEWAY to the gateway to write test records to." \
    "make life-smoke runs it on the disposable verification stack (tools/smoke-life)." >&2
  exit 2
fi
dashboard=$gateway
tasks="${dashboard}/api/tasks"
inbox="${dashboard}/api/inbox"
calendar="${dashboard}/api/calendar"

wait_dashboard() {
  for _ in $(seq 1 45); do
    if curl --fail --silent --show-error "$dashboard" >/dev/null; then return 0; fi
    sleep 1
  done
  printf 'smoke: dashboard did not become available: %s\n' "$dashboard" >&2
  return 1
}

today=$(date -u +%F)
due_at="${today}T12:00:00Z"
curl "${actor[@]}" --fail --silent --show-error -H 'content-type: application/json' \
  -d "{\"title\":\"Dashboard smoke task\",\"dueAt\":\"${due_at}\"}" \
  "$tasks/v1/tasks" >/dev/null
curl "${actor[@]}" --fail --silent --show-error -H 'content-type: application/json' \
  -d '{"content":"Dashboard smoke capture","source":"manual"}' \
  "$inbox/v1/inbox-items" >/dev/null
curl "${actor[@]}" --fail --silent --show-error -H 'content-type: application/json' \
  -d "{\"title\":\"Dashboard smoke event\",\"allDay\":true,\"startDate\":\"${today}\",\"endDate\":\"${today}\"}" \
  "$calendar/v1/events" >/dev/null

wait_dashboard
page=$(curl --fail --silent --show-error "$dashboard")
for text in 'Finance' "Dashboard smoke task" "Dashboard smoke capture" "Dashboard smoke event"; do
  if ! grep --fixed-strings --quiet "$text" <<<"$page"; then
    printf 'smoke: dashboard page missing expected text: %s\n' "$text" >&2
    exit 1
  fi
done

curl --fail --silent --show-error --request OPTIONS \
  -H 'Origin: http://localhost:3000' \
  -H 'Access-Control-Request-Method: POST' \
  -H 'Access-Control-Request-Headers: content-type' \
  --dump-header - --output /dev/null "$inbox/v1/inbox-items" | \
  tr -d '\r' | grep --ignore-case --quiet '^access-control-allow-origin: \*$'
printf 'dashboard smoke checks passed\n'
