#!/usr/bin/env bash

set -euo pipefail

# The baseline source checks (SETUP.md, "Source checks"). With no flags, all
# of them run; flags pick parts, so CI runs them in parallel jobs
# (docs/operations/ci.md):
#
#   tools/check [--gateway] [--contracts] [--sqlc] [--go] [--dashboard]
#
#   --gateway    the gateway's host list (tools/check-gateway-hosts)
#   --contracts  OpenAPI lint and generated Go and TypeScript API drift
#   --sqlc       generated sqlc code drift
#   --go         gofmt, vet, test, and build of every Go module
#   --dashboard  npm --prefix apps/dashboard run check

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

declare -A run=()
for arg in "$@"; do
  case "$arg" in
    --gateway | --contracts | --sqlc | --go | --dashboard) run[${arg#--}]=1 ;;
    *)
      printf 'check: unknown argument %s; usage: tools/check [--gateway] [--contracts] [--sqlc] [--go] [--dashboard]\n' "$arg" >&2
      exit 2
      ;;
  esac
done
if [[ ${#run[@]} -eq 0 ]]; then
  run=([gateway]=1 [contracts]=1 [sqlc]=1 [go]=1 [dashboard]=1)
fi

[[ -z "$(git status --porcelain)" ]] || {
  echo 'check: refusing to run with a dirty working tree' >&2
  exit 2
}
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/lifeos-check.XXXXXX")
cleanup_build_dir() {
  local artifact
  for artifact in "$build_dir"/*; do
    [[ -e "$artifact" ]] && unlink "$artifact"
  done
  rmdir "$build_dir"
}
trap cleanup_build_dir EXIT

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'check: required command not found on PATH: %s\n' "$1" >&2
    exit 2
  }
}

[[ -z "${run[go]:-}" ]] || require_command go
[[ -z "${run[sqlc]:-}" ]] || require_command sqlc
[[ -z "${run[contracts]:-}${run[dashboard]:-}" ]] || require_command npm

if [[ -n "${run[gateway]:-}" ]]; then
  printf '==> Gateway host separation\n'
  "$repo_root/tools/check-gateway-hosts"
fi

if [[ -n "${run[contracts]:-}" ]]; then
  printf '\n==> Contract checks\n'
  "$repo_root/tools/check-contracts"
fi

mapfile -t modules < <(find pkg templates services -name go.mod -type f -print 2>/dev/null | sort)
mapfile -t sqlc_configs < <(find templates services -name sqlc.yaml -type f -print 2>/dev/null | sort)
[[ -n "${run[sqlc]:-}" ]] || sqlc_configs=()
[[ -n "${run[go]:-}" ]] || modules=()

for config_path in "${sqlc_configs[@]}"; do
  module_dir=$(dirname "$config_path")
  printf '\n==> sqlc generate: %s\n' "$module_dir"
  sqlc generate -f "$config_path"
  generated_dir="$module_dir/internal/repository/generated"
  if ! git diff --exit-code -- "$generated_dir"; then
    printf 'check: generated sqlc code is stale in %s; run sqlc generate -f %s and commit the result\n' "$module_dir" "$config_path" >&2
    exit 1
  fi
done

for module_path in "${modules[@]}"; do
  module_dir=$(dirname "$module_path")
  printf '\n==> Go checks: %s\n' "$module_dir"
  format_diff=$(gofmt -d $(find "$module_dir" -name '*.go' -type f -print))
  if [[ -n "$format_diff" ]]; then
    printf '%s\ncheck: Go formatting is stale in %s; run gofmt -w on the files above\n' "$format_diff" "$module_dir" >&2
    exit 1
  fi
  (
    cd "$module_dir"
    GOWORK=off go vet ./...
    GOWORK=off go test ./...
    if [[ -d cmd/server ]]; then
      GOWORK=off go build -o "$build_dir/$(tr '/' '_' <<<"$module_dir")-server" ./cmd/server
    else
      GOWORK=off go build ./...
    fi
  )
done

if [[ -n "${run[dashboard]:-}" ]]; then
  printf '\n==> Dashboard checks\n'
  npm --prefix apps/dashboard run check
fi

if [[ ${#run[@]} -eq 5 ]]; then
  printf '\nAll baseline checks passed.\n'
else
  printf '\nBaseline checks passed: %s\n' "$(printf '%s\n' "${!run[@]}" | sort | tr '\n' ' ' | sed 's/ $//')"
fi

[[ -z "$(git status --porcelain)" ]] || {
  echo 'check: verification left the working tree dirty' >&2
  exit 1
}
