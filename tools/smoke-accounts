#!/usr/bin/env bash
set -euo pipefail

# Accounts end to end, on the disposable verification stack only, with the
# real images: the gateway, the Dashboard's sign-in and auth check, and the
# services verifying its identity tokens (docs/install/accounts.md). It
#  - creates the first account with a setup code from the Dashboard's
#    container (./setup.sh setup-code's command), and signs in with it;
#  - writes a Task through the gateway with the session cookie and no
#    X-Life-OS-Actor: Tasks takes the actor from the identity token (user);
#  - checks that a forged identity, a made-up cookie, and a cookie write
#    from another site are refused, and that /internal/ is closed;
#  - turns legacy access off on the host (legacy-access off): a request
#    without a sign-in is 401, the session still works; and on again;
#  - checks the admin surfaces: legacy access gets Status and the backups
#    as before; the owner, signed in without two-factor, gets the members'
#    one line and no Back up now or admin pages, and the security log has it;
#  - with legacy access off (P21-06): pairs a phone with a pairing code and
#    makes every native call with its device key (Tasks, Inbox, Calendar,
#    push registration, the update manifest), makes the watch's key, and
#    revokes both; makes a development tool's token, which writes as
#    dev:<name> and only where its scopes say; and, when MCP runs, an MCP
#    client's whole OAuth (registration, PKCE, consent, the token, a tool
#    call, the refresh, and disconnecting it);
#  - signs everyone out (sign-out-all, first with --keep-devices): the
#    session, the token, and then the device key are dead.
# The stack starts with legacy access on (tools/verify-compose), as an
# upgraded install does.

compose=(./tools/verify-compose)
gateway=http://127.0.0.1:13001
cd "$(dirname "${BASH_SOURCE[0]}")/.."
work=$(mktemp -d)
cleanup() {
  "${compose[@]}" down --volumes --remove-orphans >/dev/null
  rm -rf "$work"
}
trap cleanup EXIT
fail() {
  echo "accounts smoke: $*" >&2
  exit 1
}
password='correct horse battery staple 42'

"${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
scale=()
if "${compose[@]}" config --services | grep -qx processor; then scale=(--scale processor=0); fi
"${compose[@]}" up --detach --no-build "${scale[@]}" >/dev/null

for _ in $(seq 1 120); do
  curl --fail --silent --max-time 3 "$gateway/api/tasks/ready" >/dev/null && break
  sleep 1
done
curl --fail --silent --max-time 3 "$gateway/api/tasks/ready" >/dev/null || fail 'Tasks does not answer through the gateway with legacy access on'
account() { "${compose[@]}" exec -T dashboard node scripts/lifeos-auth.mjs "$@"; }
# request <method> <path> [curl options…]: status in $code, body in
# $work/body, headers in $work/headers
request() {
  local method=$1 path=$2
  shift 2
  code=$(curl --silent --max-time 15 --request "$method" --output "$work/body" --dump-header "$work/headers" \
    --write-out '%{http_code}' "$@" "$gateway$path")
}
# The session cookie the last answer set, as a Cookie header (by hand: a
# browser keeps a Secure cookie on 127.0.0.1, curl's cookie jar may not).
session_cookie() {
  grep -i '^set-cookie: __Host-lifeos.session=' "$work/headers" | head -n 1 | sed 's/^[^:]*: //; s/;.*//' | tr -d '\r'
}
expect() { # <status> <method> <path> [curl options…]
  local want=$1
  shift
  request "$@"
  [[ "$code" == "$want" ]] || { cat "$work/body" >&2; fail "$1 $2: $code, want $want"; }
}

echo '==> The first account, with a setup code'
code_line=$(account setup-code | sed -n 's/^Setup code: //p')
[[ -n "$code_line" ]] || fail 'setup-code printed no code'
expect 200 POST /api/auth/sign-up/email -H 'content-type: application/json' \
  -H "origin: $gateway" -H "x-lifeos-setup-code: $code_line" \
  --data "{\"username\":\"owner\",\"password\":\"$password\"}"
grep -q '00000000-0000-4000-8000-000000000001' "$work/body" || fail 'the first account did not get the fixed id'
session=$(session_cookie)
[[ -n "$session" ]] || { cat "$work/headers" >&2; fail 'no session cookie'; }
grep -qi '^set-cookie: __Host-lifeos.session=.*; Secure' "$work/headers" || fail 'the session cookie is not Secure'
expect 403 POST /api/auth/sign-up/email -H 'content-type: application/json' -H "origin: $gateway" \
  -H "x-lifeos-setup-code: $code_line" --data "{\"username\":\"second\",\"password\":\"$password\"}"
[[ -z "$(account setup-code --if-no-account)" ]] || fail 'a setup code while an account exists'

echo '==> A write with the session: the actor is the user'
expect 201 POST /api/tasks/v1/tasks -H "cookie: $session" -H 'content-type: application/json' -H "origin: $gateway" \
  --data '{"title":"Accounts smoke task"}'
task_id=$(jq -r .id "$work/body")
[[ "$task_id" =~ ^[0-9a-f-]{36}$ ]] || fail "no task id: $(cat "$work/body")"
for _ in $(seq 1 20); do
  request GET "/api/activity/v1/activity-events?subjectType=task&subjectId=$task_id" -H "cookie: $session"
  [[ "$code" == 200 ]] && jq -e '[.items[]? | select(.type == "task.created")] | length > 0' "$work/body" >/dev/null && break
  sleep 0.5
done
jq -e '[.items[] | select(.type == "task.created")][0].actor.kind == "user"' "$work/body" >/dev/null \
  || fail "the task was not created as the user: $(cat "$work/body")"

echo '==> Admin surfaces: legacy access as before, an owner without two-factor refused'
# Legacy access (no credential) is the owner, as before accounts: Status
# with every check, and the backups' status.
expect 200 GET /api/status
jq -e '.checks | length > 0' "$work/body" >/dev/null || fail "legacy access lost Status's checks: $(cat "$work/body")"
request GET /api/backups/v1/status
[[ "$code" != 401 && "$code" != 403 ]] || fail "legacy access lost the backups' status: $code"
# The signed-in owner has no second factor yet: the members' one line, and
# no backups or admin pages until two-factor sign-in is on.
expect 200 GET /api/status -H "cookie: $session"
jq -e '.view == "member" and .reason == "second_factor_required" and (.checks | length) == 0' "$work/body" >/dev/null \
  || fail "a signed-in owner without two-factor saw Status's details: $(cat "$work/body")"
expect 403 POST /api/backups/v1/backups -H "cookie: $session" -H "origin: $gateway"
grep -q '"second_factor_required"' "$work/body" || fail "Back up now was not refused for the missing second factor: $(cat "$work/body")"
expect 403 GET /api/admin/security-log -H "cookie: $session"
expect 401 GET /api/admin/security-log
# The security log has the sign-up and the refused Back up now.
expect 200 GET /api/account/security-log -H "cookie: $session"
jq -e '[.items[].kind] | (index("account_created") != null) and (index("admin_refused") != null)' "$work/body" >/dev/null \
  || fail "the security log lacks the sign-up or the refused backup: $(cat "$work/body")"

echo '==> A share of photos over 10 MiB, signed in'
# The installed app's share sheet posts photos to /share as one request; the
# Dashboard's proxy must not see it (Next.js caps a proxied body's copy at
# 10 MiB). Two made-up 6 MiB JPEGs (JPEG's first bytes, then random ones).
for photo in one two; do
  { printf '\xff\xd8\xff\xe0'; head -c $((6 * 1024 * 1024)) /dev/urandom; } >"$work/$photo.jpg"
done
expect 303 POST /share -H "cookie: $session" -H "origin: $gateway" -H 'sec-fetch-site: same-origin' \
  -F 'text=Accounts smoke share' -F "images=@$work/one.jpg;type=image/jpeg" -F "images=@$work/two.jpg;type=image/jpeg"
location=$(grep -i '^location:' "$work/headers" | tr -d '\r' | cut -d ' ' -f 2-)
[[ "$location" == /share/saved* && "$location" != *error=* ]] || fail "the 12 MiB share was not saved: $location"
# Without a sign-in (legacy access off), a share goes to the login, then to
# the page that explains sharing.
account legacy-access off >/dev/null
sleep 6
expect 303 POST /share -H "origin: $gateway" -H 'sec-fetch-site: same-origin' -F 'text=No session'
grep -qi '^location: /login?next=%2Fshare%2Fabout' "$work/headers" || { cat "$work/headers" >&2; fail 'a share without a session did not go to the login'; }
account legacy-access on >/dev/null
sleep 6

echo '==> Refusals'
expect 401 GET /api/tasks/v1/tasks --cookie '__Host-lifeos.session=made-up.token'
expect 403 POST /api/tasks/v1/tasks -H "cookie: $session" -H 'content-type: application/json' \
  -H 'origin: https://elsewhere.example' --data '{"title":"cross-site"}'
expect 200 GET /api/tasks/v1/tasks -H "cookie: $session" -H 'X-Life-OS-Identity: forged.token.value'
expect 404 GET /internal/auth/check -H "cookie: $session"
expect 404 GET /internal/status

echo '==> Legacy access off on the host'
account legacy-access off >/dev/null
sleep 6
expect 401 GET /api/tasks/v1/tasks
grep -q '"unauthenticated"' "$work/body" || fail 'the 401 is not JSON unauthenticated'
expect 307 GET /tasks
expect 200 GET /api/tasks/v1/tasks -H "cookie: $session"
account legacy-access on >/dev/null
sleep 6
expect 200 GET /api/tasks/v1/tasks

echo '==> Devices, tokens, and MCP, with legacy access off'
account legacy-access off >/dev/null
sleep 6
# Pair a phone: the owner's session makes a pairing code (Settings →
# Devices), the app redeems it, with no Origin and no cookie.
expect 201 POST /api/account/devices/pairing-codes -H "cookie: $session" -H "origin: $gateway" \
  -H 'content-type: application/json' --data '{}'
pairing=$(jq -r .code "$work/body")
jq -e '.link | startswith("lifeos://pair?")' "$work/body" >/dev/null || fail "no pairing link: $(cat "$work/body")"
expect 200 POST /api/auth/devices/pair -H 'content-type: application/json' \
  --data "{\"code\":\"$pairing\",\"name\":\"Smoke phone\"}"
phone=$(jq -r .key "$work/body")
phone_id=$(jq -r .keyId "$work/body")
[[ "$phone" == lo_dev_* ]] || fail "no device key: $(cat "$work/body")"
expect 400 POST /api/auth/devices/pair -H 'content-type: application/json' \
  --data "{\"code\":\"$pairing\",\"name\":\"Twice\"}"
# Every native call the phone makes, with its key: Tasks, Inbox, Calendar,
# push registration (web push is not set up on this stack: 409, past the
# sign-in), the update manifest, and the watch's key.
key=(-H "authorization: Bearer $phone")
expect 200 GET '/api/tasks/v1/tasks?limit=1' "${key[@]}"
expect 201 POST /api/inbox/v1/inbox-items "${key[@]}" -H 'content-type: application/json' \
  --data '{"content":"Accounts smoke capture from the phone","source":"manual"}'
expect 200 GET '/api/calendar/v1/events?from=2026-11-14T00:00:00Z&to=2026-11-15T00:00:00Z' "${key[@]}"
expect 200 GET /api/notifications/v1/push/config "${key[@]}"
expect 409 POST /api/notifications/v1/push/subscriptions "${key[@]}" -H 'content-type: application/json' \
  --data '{"endpoint":"https://fcm.googleapis.com/fcm/send/smoke","keys":{"p256dh":"x","auth":"y"}}'
request GET /android/updates "${key[@]}"
[[ "$code" != 401 && "$code" != 403 ]] || fail "the update manifest refused the device key: $code"
expect 401 GET /android/updates
expect 200 POST /api/auth/devices/child "${key[@]}" -H 'content-type: application/json' --data '{"name":"Smoke watch"}'
watch=$(jq -r .key "$work/body")
expect 200 GET '/api/tasks/v1/tasks?limit=1' -H "authorization: Bearer $watch"
# What a key may not do: manage the account, or the server's admin routes.
expect 401 GET /api/account/devices "${key[@]}"
expect 200 GET /api/status "${key[@]}"
jq -e '.view == "member"' "$work/body" >/dev/null || fail "a device key saw Status's details: $(cat "$work/body")"
# A key that does not work is refused, never legacy access or the cookie.
expect 401 GET /api/tasks/v1/tasks -H "authorization: Bearer lo_dev_$(printf 'A%.0s' $(seq 1 64))" -H "cookie: $session"

# A personal token, marked as a development tool: only its scopes, as dev:<name>.
expect 201 POST /api/account/tokens -H "cookie: $session" -H "origin: $gateway" -H 'content-type: application/json' \
  --data '{"name":"smoke-tool","scopes":["tasks:write"],"devTool":true}'
token=$(jq -r .token "$work/body")
[[ "$token" == lo_tok_* ]] || fail "no token: $(cat "$work/body")"
expect 201 POST /api/tasks/v1/tasks -H "authorization: Bearer $token" -H 'content-type: application/json' \
  --data '{"title":"Accounts smoke task by a tool"}'
tool_task=$(jq -r .id "$work/body")
expect 403 GET '/api/finance/v1/accounts' -H "authorization: Bearer $token"
expect 401 GET /api/account/tokens -H "authorization: Bearer $token"
for _ in $(seq 1 20); do
  request GET "/api/activity/v1/activity-events?subjectType=task&subjectId=$tool_task" -H "cookie: $session"
  [[ "$code" == 200 ]] && jq -e '[.items[]? | select(.type == "task.created")] | length > 0' "$work/body" >/dev/null && break
  sleep 0.5
done
jq -e '[.items[] | select(.type == "task.created")][0].actor == {"kind":"dev","name":"smoke-tool"}' "$work/body" >/dev/null \
  || fail "the tool's task was not created as dev:smoke-tool: $(cat "$work/body")"

if "${compose[@]}" ps --services --status running | grep -qx mcp; then
  echo '==> MCP: OAuth from registration to revocation, and a tool call'
  expect 401 POST /api/mcp/mcp -H 'content-type: application/json' --data '{}'
  grep -qi '^www-authenticate: Bearer resource_metadata=".*/.well-known/oauth-protected-resource/api/mcp"' "$work/headers" \
    || { cat "$work/headers" >&2; fail "MCP's 401 has no challenge"; }
  expect 200 GET /.well-known/oauth-protected-resource/api/mcp
  resource=$(jq -r .resource "$work/body")
  expect 200 GET /.well-known/oauth-authorization-server
  jq -e '.code_challenge_methods_supported == ["S256"]' "$work/body" >/dev/null || fail "no PKCE in the metadata: $(cat "$work/body")"
  redirect=http://127.0.0.1:33418/callback
  request POST /api/auth/oauth2/register -H 'content-type: application/json' \
    --data "{\"client_name\":\"Accounts smoke MCP client\",\"redirect_uris\":[\"$redirect\"],\"token_endpoint_auth_method\":\"none\",\"grant_types\":[\"authorization_code\",\"refresh_token\"],\"response_types\":[\"code\"],\"scope\":\"mcp:read mcp:write offline_access\"}"
  [[ "$code" == 200 || "$code" == 201 ]] || { cat "$work/body" >&2; fail "registration: $code"; }
  client=$(jq -r .client_id "$work/body")
  verifier=$(openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n')
  challenge=$(printf '%s' "$verifier" | openssl dgst -sha256 -binary | base64 | tr '+/' '-_' | tr -d '=\n')
  query=$(jq -rn --arg c "$client" --arg r "$redirect" --arg ch "$challenge" --arg res "$resource" \
    '{response_type:"code",client_id:$c,redirect_uri:$r,scope:"mcp:read mcp:write offline_access",state:"smoke-state",code_challenge:$ch,code_challenge_method:"S256",resource:$res} | to_entries | map("\(.key)=\(.value|@uri)") | join("&")')
  expect 302 GET "/api/auth/oauth2/authorize?$query" -H "cookie: $session" -H 'accept: text/html' -H 'sec-fetch-mode: navigate'
  consent=$(grep -i '^location:' "$work/headers" | tr -d '\r' | cut -d ' ' -f 2-)
  [[ "$consent" == */oauth/consent\?* ]] || fail "authorize did not ask for consent: $consent"
  expect 200 POST /api/auth/oauth2/consent -H "cookie: $session" -H "origin: $gateway" -H 'content-type: application/json' \
    --data "$(jq -n --arg q "${consent#*\?}" '{accept:true,scope:"mcp:read mcp:write offline_access",oauth_query:$q}')"
  back=$(jq -r .url "$work/body")
  oauth_code=$(sed -n 's/.*[?&]code=\([^&]*\).*/\1/p' <<<"$back")
  [[ -n "$oauth_code" && "$back" == "$redirect"* ]] || fail "consent did not return a code to the client: $back"
  expect 200 POST /api/auth/oauth2/token --data-urlencode grant_type=authorization_code --data-urlencode "code=$oauth_code" \
    --data-urlencode "redirect_uri=$redirect" --data-urlencode "client_id=$client" --data-urlencode "code_verifier=$verifier" \
    --data-urlencode "resource=$resource"
  access=$(jq -r .access_token "$work/body")
  refresh=$(jq -r .refresh_token "$work/body")
  [[ "$access" == *.*.* && -n "$refresh" && "$refresh" != null ]] || fail "no tokens: $(cat "$work/body")"
  # MCP's JSON-RPC over the streamable transport: initialize, then a tool.
  mcp_headers=(-H "authorization: Bearer $access" -H 'content-type: application/json' -H 'accept: application/json, text/event-stream')
  rpc_result() { sed -n 's/^data: //p' "$work/body" | head -n 1 | jq -c . 2>/dev/null || jq -c . "$work/body"; }
  expect 200 POST /api/mcp/mcp "${mcp_headers[@]}" \
    --data '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"smoke","version":"1"}}}'
  mcp_session=$(grep -i '^mcp-session-id:' "$work/headers" | tr -d '\r' | cut -d ' ' -f 2-)
  [[ -n "$mcp_session" ]] || { cat "$work/headers" >&2; fail 'MCP opened no session'; }
  mcp_headers+=(-H "mcp-session-id: $mcp_session" -H 'mcp-protocol-version: 2025-06-18')
  request POST /api/mcp/mcp "${mcp_headers[@]}" --data '{"jsonrpc":"2.0","method":"notifications/initialized"}'
  expect 200 POST /api/mcp/mcp "${mcp_headers[@]}" --data '{"jsonrpc":"2.0","id":2,"method":"tools/list"}'
  rpc_result | jq -e '[.result.tools[].name] | index("task_create") != null' >/dev/null || fail "tools/list lacks task_create: $(rpc_result)"
  expect 200 POST /api/mcp/mcp "${mcp_headers[@]}" \
    --data '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"task_list","arguments":{"query":"limit=1"}}}'
  rpc_result | jq -e '.result.isError != true' >/dev/null || fail "the tool call failed: $(rpc_result)"
  # The refresh token rotates; the spent one is refused.
  expect 200 POST /api/auth/oauth2/token --data-urlencode grant_type=refresh_token --data-urlencode "refresh_token=$refresh" \
    --data-urlencode "client_id=$client" --data-urlencode "resource=$resource"
  access=$(jq -r .access_token "$work/body")
  expect 400 POST /api/auth/oauth2/token --data-urlencode grant_type=refresh_token --data-urlencode "refresh_token=$refresh" \
    --data-urlencode "client_id=$client" --data-urlencode "resource=$resource"
  # Disconnecting it in Settings counts at once.
  expect 204 DELETE "/api/account/connected-apps/$client" -H "cookie: $session" -H "origin: $gateway"
  expect 401 POST /api/mcp/mcp -H "authorization: Bearer $access" -H 'content-type: application/json' \
    -H 'accept: application/json, text/event-stream' \
    --data '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"smoke","version":"1"}}}'
fi

# Revoking the phone in Settings revokes its watch too.
expect 204 DELETE "/api/account/devices/$phone_id" -H "cookie: $session" -H "origin: $gateway"
expect 401 GET /api/tasks/v1/tasks "${key[@]}"
expect 401 GET /api/tasks/v1/tasks -H "authorization: Bearer $watch"
# A newly paired phone and a token, for signing everyone out below.
expect 201 POST /api/account/devices/pairing-codes -H "cookie: $session" -H "origin: $gateway" \
  -H 'content-type: application/json' --data '{}'
expect 200 POST /api/auth/devices/pair -H 'content-type: application/json' \
  --data "{\"code\":\"$(jq -r .code "$work/body")\",\"name\":\"Kept phone\"}"
phone=$(jq -r .key "$work/body")
account legacy-access on >/dev/null
sleep 6

echo '==> Sign everyone out'
# --keep-devices: the paired phone stays, the token and the sessions go.
account sign-out-all --keep-devices >/dev/null
expect 200 GET /api/tasks/v1/tasks -H "authorization: Bearer $phone"
expect 401 GET /api/tasks/v1/tasks -H "authorization: Bearer $token"
account sign-out-all >/dev/null
expect 401 GET /api/tasks/v1/tasks -H "authorization: Bearer $phone"
expect 200 GET /api/tasks/v1/tasks
account legacy-access off >/dev/null
sleep 6
expect 401 GET /api/tasks/v1/tasks -H "cookie: $session"
expect 200 POST /api/auth/sign-in/username -H 'content-type: application/json' \
  -H "origin: $gateway" --data "{\"username\":\"OWNER\",\"password\":\"$password\"}"
session=$(session_cookie)
[[ -n "$session" ]] || fail 'no session cookie after signing in again'
expect 200 GET /api/tasks/v1/tasks -H "cookie: $session"

echo 'accounts smoke: ok'
