#!/usr/bin/env bash
set -euo pipefail

# Checks that provisioning refuses weak database passwords
# (infra/postgres/password-check.sh; docs/install/manual.md#database-passwords)
# in throwaway containers, never a deployed PostgreSQL: the postgres-provision
# image built from infra/postgres, and two PostgreSQL servers of the image
# compose.yaml pins, on a network of their own. It checks:
#  - a new login is refused .env.example's placeholder or a password shorter
#    than 32 characters, and is not made;
#  - a login that exists already keeps working with such a password, with a
#    warning, so an install from before the check starts as it did;
#  - the backup service's login (lifeos_backup) the same way;
#  - the admin's placeholder password is refused on a new install (no
#    service's login yet) and a warning after that;
#  - no message ever shows a password.
#
#   tools/test-provision-passwords

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
command -v docker >/dev/null 2>&1 || { echo 'test-provision-passwords: docker is required' >&2; exit 2; }
# shellcheck disable=SC2016 # Compose's ${…}, not the shell's
postgres_image=$(sed -n 's/^ *image: \${LIFE_OS_POSTGRES_IMAGE:-\(.*\)}$/\1/p' compose.yaml | head -n 1)
[[ -n "$postgres_image" ]] || { echo 'test-provision-passwords: no PostgreSQL image in compose.yaml' >&2; exit 2; }
name=lifeos-verify-provpw-$$
image=$name-provision
work=$(mktemp -d)
cleanup() {
  docker rm -f "$name-strong" "$name-weak" >/dev/null 2>&1 || true
  docker network rm "$name" >/dev/null 2>&1 || true
  docker image rm "$image" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT
fail() {
  printf 'test-provision-passwords: %s\n' "$*" >&2
  exit 1
}

strong() { openssl rand -hex 24; }
admin_password=$(strong)
placeholder_admin=replace-with-a-local-password
docker build --quiet --tag "$image" infra/postgres >/dev/null
docker network create "$name" >/dev/null
docker run -d --rm --name "$name-strong" --network "$name" -e POSTGRES_USER=lifeos_admin \
  -e POSTGRES_PASSWORD="$admin_password" "$postgres_image" >/dev/null
docker run -d --rm --name "$name-weak" --network "$name" -e POSTGRES_USER=lifeos_admin \
  -e POSTGRES_PASSWORD="$placeholder_admin" "$postgres_image" >/dev/null

# Every login's password, strong; a case changes some.
mapfile -t password_vars < <(awk -F '|' '!/^[[:space:]]*(#|$)/ { print $4 }' infra/postgres/service-databases.conf)
declare -A passwords=()
for var in "${password_vars[@]}" LIFE_OS_BACKUP_DB_PASSWORD; do passwords[$var]=$(strong); done

provision() { # <server> <admin password> [VAR=value…]: exit status in $status, output in $out
  local server=$1 admin=$2 var
  shift 2
  local -a env=(-e PGHOST="$server" -e PGPASSWORD="$admin" -e POSTGRES_USER=lifeos_admin -e POSTGRES_DB=postgres)
  for var in "${!passwords[@]}"; do env+=(-e "$var=${passwords[$var]}"); done
  for var in "$@"; do env+=(-e "$var"); done
  set +e
  out=$(docker run --rm --network "$name" "${env[@]}" "$image" 2>&1)
  status=$?
  set -e
}
psql_on() { # <server> <admin password> <sql>
  docker run --rm --network "$name" -e PGPASSWORD="$2" --entrypoint psql "$image" \
    -h "$1" -U lifeos_admin -d postgres -Atq -v ON_ERROR_STOP=1 -c "$3"
}
expect() { # <status> <text>: the last run ended so and said that
  [[ "$status" == "$1" ]] || { printf '%s\n' "$out" >&2; fail "provisioning exited $status, want $1"; }
  grep -qF -- "$2" <<<"$out" || { printf '%s\n' "$out" >&2; fail "provisioning did not say: $2"; }
}
never_shows() { # <value>
  ! grep -qF -- "$1" <<<"$out" || { printf '%s\n' "$out" >&2; fail "provisioning printed a password"; }
}
has_role() { # <server> <admin password> <role>: 1 or 0
  psql_on "$1" "$2" "SELECT count(*) FROM pg_roles WHERE rolname = '$3'"
}

for server in "$name-strong" "$name-weak"; do
  for _ in $(seq 1 60); do
    docker exec "$server" pg_isready -q -h 127.0.0.1 -U lifeos_admin -d postgres 2>/dev/null && break
    sleep 0.5
  done
done

printf '==> A new login is refused the placeholder, and a short password\n'
provision "$name-strong" "$admin_password" LIFE_OS_TASKS_DB_PASSWORD=replace-with-a-local-tasks-password
expect 1 "LIFE_OS_TASKS_DB_PASSWORD is still .env.example's placeholder: set a new one in .env"
never_shows replace-with-a-local-tasks-password
[[ "$(has_role "$name-strong" "$admin_password" tasks_user)" == 0 ]] || fail "tasks_user was made with the placeholder"
provision "$name-strong" "$admin_password" LIFE_OS_TASKS_DB_PASSWORD=short-but-not-empty-0123456789a
expect 1 'LIFE_OS_TASKS_DB_PASSWORD is shorter than 32 characters'
never_shows short-but-not-empty-0123456789a
[[ "$(has_role "$name-strong" "$admin_password" tasks_user)" == 0 ]] || fail "tasks_user was made with a short password"

printf '==> A login made before the check keeps working with a warning\n'
psql_on "$name-strong" "$admin_password" "CREATE ROLE tasks_user LOGIN PASSWORD 'replace-with-a-local-tasks-password'" >/dev/null
provision "$name-strong" "$admin_password" LIFE_OS_TASKS_DB_PASSWORD=replace-with-a-local-tasks-password
expect 0 "warning: LIFE_OS_TASKS_DB_PASSWORD is still .env.example's placeholder. The login tasks_user keeps working with it for now"
never_shows replace-with-a-local-tasks-password
docker run --rm --network "$name" -e PGPASSWORD=replace-with-a-local-tasks-password --entrypoint psql "$image" \
  -h "$name-strong" -U tasks_user -d tasks_db -Atqc 'SELECT 1' >/dev/null || fail "tasks_user cannot log in with its existing password"

printf '==> The backup login too\n'
psql_on "$name-strong" "$admin_password" 'DROP OWNED BY lifeos_backup; DROP ROLE lifeos_backup' >/dev/null
provision "$name-strong" "$admin_password" LIFE_OS_BACKUP_DB_PASSWORD=replace-with-a-local-backup-password
expect 1 "LIFE_OS_BACKUP_DB_PASSWORD is still .env.example's placeholder: set a new one in .env (openssl rand -hex 24) before the login lifeos_backup is made with it"
[[ "$(has_role "$name-strong" "$admin_password" lifeos_backup)" == 0 ]] || fail "lifeos_backup was made with the placeholder"

printf '==> Strong passwords: no warning, every login made or set\n'
provision "$name-strong" "$admin_password"
expect 0 'Provisioning tasks'
! grep -q 'warning:' <<<"$out" || { printf '%s\n' "$out" >&2; fail "a warning with strong passwords"; }
[[ "$(has_role "$name-strong" "$admin_password" lifeos_backup)" == 1 ]] || fail "lifeos_backup was not made"
docker run --rm --network "$name" -e PGPASSWORD="${passwords[LIFE_OS_TASKS_DB_PASSWORD]}" --entrypoint psql "$image" \
  -h "$name-strong" -U tasks_user -d tasks_db -Atqc 'SELECT 1' >/dev/null || fail "tasks_user did not get its new password"

printf '==> The admin placeholder: refused on a new install, a warning after\n'
provision "$name-weak" "$placeholder_admin"
expect 1 "LIFE_OS_POSTGRES_PASSWORD is still .env.example's placeholder. PostgreSQL keeps the admin password it first started with"
never_shows "$placeholder_admin"
[[ "$(has_role "$name-weak" "$placeholder_admin" finance_user)" == 0 ]] || fail "a login was made under the placeholder admin password"
psql_on "$name-weak" "$placeholder_admin" "CREATE ROLE finance_user LOGIN PASSWORD '${passwords[LIFE_OS_FINANCE_DB_PASSWORD]}'" >/dev/null
provision "$name-weak" "$placeholder_admin"
expect 0 "warning: LIFE_OS_POSTGRES_PASSWORD is still .env.example's placeholder"

printf 'test-provision-passwords: ok\n'
